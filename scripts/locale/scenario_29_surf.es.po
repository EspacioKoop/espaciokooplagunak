#: scripts/scenario_29_surf.lua:99 scripts/scenario_29_surf.lua:159
msgctxt "situationReport-comms"
msgid "A recent reactor failure has put us on auxiliary power, so we cannot recharge ships."
msgstr "Una falla reciente del reactor nos ha puesto en energía auxiliar, por lo que no podemos recargar naves."

#: scripts/scenario_29_surf.lua:102 scripts/scenario_29_surf.lua:160
msgctxt "situationReport-comms"
msgid "A damaged power coupling makes it too dangerous to recharge ships."
msgstr "Un acoplamiento de energía dañado hace que sea demasiado peligroso para recargar barcos."

#: scripts/scenario_29_surf.lua:105 scripts/scenario_29_surf.lua:161
msgctxt "situationReport-comms"
msgid "An asteroid strike damaged our solar cells and we are short on power, so we can't recharge ships right now."
msgstr "Un ataque de asteroides dañó nuestras células solares y estamos cortos de energía, así que no podemos recargar los barcos ahora mismo."

#: scripts/scenario_29_surf.lua:110 scripts/scenario_29_surf.lua:148
