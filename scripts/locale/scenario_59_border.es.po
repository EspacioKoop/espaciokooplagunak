msgid "Borderline Fever"
msgstr "Fiebre fronteriza"

# Scenario description
msgid ""
"War temperature rises along the border between Human Navy space and Kraylor space. The treaty holds for now, but the diplomats and intelligence operatives fear the Kraylors are about to break the treaty. We must maintain the treaty despite provocation until war is formally declared.\n"
"\n"
"Version 5"
msgstr "La temperatura de guerra se eleva a lo largo de la frontera entre el espacio de la Armada Humana y el espacio Kraylor. El tratado sostiene por ahora, pero los diplomáticos y los agentes de inteligencia temen que los Kraylors estén a punto de romper el tratado. Debemos mantener el tratado a pesar de la provocación hasta que se declare oficialmente la guerra."

# Scenario setting
msgctxt "setting"
msgid "Enemies"
msgstr "Enemigos"

msgctxt "setting"
msgid "Configures strength and/or number of enemies in this scenario"
msgstr "Configura fuerza y/o número de enemigos en este escenario"

msgctxt "Enemies"
msgid "Easy"
msgstr "Fácil"

msgctxt "Enemies"
msgid "Fewer or weaker enemies"
msgstr "Menores o más débiles enemigos"

msgctxt "Enemies"
msgid "Normal"
msgstr "Normal"

msgctxt "Enemies"
msgid "Normal number or strength of enemies"
msgstr "Número normal o fuerza de enemigos"

msgctxt "Enemies"
msgid "Hard"
msgstr "Duro"

msgctxt "Enemies"
msgid "More or stronger enemies"
msgstr "Más enemigos o más fuertes"

msgctxt "Enemies"
msgid "Extreme"
msgstr "Extremo"

msgctxt "Enemies"
msgid "Much stronger, many more enemies"
msgstr "Mucho más fuerte, muchos más enemigos"

msgctxt "Enemies"
msgid "Quixotic"
msgstr "Quijote"

msgctxt "Enemies"
msgid "Insanely strong and/or inordinately large numbers of enemies"
msgstr "Enemigos disparatadamente fuertes y/o en cantidades desmedidas"

# Scenario setting
msgctxt "setting"
msgid "Murphy"
msgstr "Murphy"

msgctxt "setting"
msgid "Configures the perversity of the universe according to Murphy's law"
msgstr "Configura la perversidad del universo según la ley de Murphy"

msgctxt "Murphy"
msgid "Easy"
msgstr "Fácil"

msgctxt "Murphy"
msgid "Random factors are more in your favor"
msgstr "Los factores aleatorios son más a su favor"

msgctxt "Murphy"
msgid "Normal"
msgstr "Normal"

msgctxt "Murphy"
msgid "Random factors are normal"
msgstr "Los factores aleatorios son normales"

msgctxt "Murphy"
msgid "Hard"
msgstr "Duro"

msgctxt "Murphy"
msgid "Random factors are more against you"
msgstr "Los factores aleatorios son más contra ti"

msgctxt "Murphy"
msgid "Quixotic"
msgstr "Quijote"

msgctxt "Murphy"
msgid "No need for paranoia, the universe *is* out to get you"
msgstr "No hay necesidad de paranoia, el universo * está* para conseguirte"

# Scenario setting
msgctxt "setting"
msgid "Ending"
msgstr "Ending"

msgctxt "setting"
msgid "Sets the conditions for ending the war: absolute strength % when friendly and Kraylor give up, relative strength % difference when friendly and Kraylor give up"
msgstr "Establece las condiciones para poner fin a la guerra: fuerza absoluta % wHen amistoso y Kraylor se rinden, fuerza relativa % difference cuando amable y Kraylor se rinden"

msgctxt "Ending"
msgid "Easy"
msgstr "Fácil"

msgctxt "Ending"
msgid "Cutoffs 10% easier than normal"
msgstr "Cortaciones 10% emás fácil de lo normal"

msgctxt "Ending"
msgid "Normal"
msgstr "Normal"

msgctxt "Ending"
msgid "Kraylor surrender if < 70% of their original strength, friendly surrender if < 50% of their original strength, either will surrender if < 20% relative strength difference"
msgstr "Los Kraylor se rinden si caen por debajo del 70% de su fuerza original, los amistosos se rinden si caen por debajo del 50% de su fuerza original, cualquiera se rendirá si la diferencia de fuerza relativa es menor del 20%"

msgctxt "Ending"
msgid "Hard"
msgstr "Duro"

msgctxt "Ending"
msgid "Cutoffs 10% harder than normal"
msgstr "Cortaciones 10% harder de lo normal"

msgctxt "Ending"
msgid "Quixotic"
msgstr "Quijote"

msgctxt "Ending"
msgid "Cutoffs 20% harder than normal"
msgstr "Cortes 20% harder de lo normal"

