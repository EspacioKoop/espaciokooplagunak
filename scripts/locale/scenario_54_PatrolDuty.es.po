#: scripts/scenario_54_PatrolDuty.lua:7385
msgctxt "Nabbit2-shipLog"
msgid "Engineer Dan McNabbit aboard and ready to go to Armstrong"
msgstr "Ingeniero Dan McNabbit a bordo y listo para ir a Armstrong"

#: scripts/scenario_54_PatrolDuty.lua:7408
msgctxt "Nabbit3Audio-incCall"
msgid "Audio message received, auto-transcribed into log, stored for playback: ASTGDN038"
msgstr "Mensaje de audio recibido, autotranscribido en el registro, almacenado para la reproducción: ASTGDN038"

#: scripts/scenario_54_PatrolDuty.lua:7409
msgctxt "Nabbit3Audio-shipLog"
msgid "[ASTGDN038](Dan McNabbit) Thanks for the ride. I've tuned your impulse engines en route. I transmitted my engine tuning parameters to Utopia Planitia. Expect faster impulse speeds"
msgstr "[ASTGDN038](Dan McNabbit) Gracias por el viaje. He ajustado sus motores de impulso en la ruta. Transmití mis parámetros de ajuste del motor a la Planitia de Utopia."

