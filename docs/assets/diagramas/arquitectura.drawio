          <mxGeometry x="700" y="80" width="560" height="560" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API v1 (FastAPI)&lt;/b&gt;&lt;br&gt;[Componente]&lt;br&gt;/healthz · /v1/state · /v1/scenario · /v1/events · /v1/contacts · /v1/command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;" vertex="1" parent="1">
          <mxGeometry x="860" y="110" width="240" height="100" as="geometry" />
        </mxCell>
