{{! Ventana del asistente (#309). Una fase visible cada vez: la ayuda es un
    gesto corto, y enseñar las cuatro a la vez la haría parecer un formulario. }}
<section class="lagunak-asistencia__panel">

  {{#if esGM}}
    <div class="lagunak-asistencia__crisis">
      {{#if mando.crisisActiva}}
        <button type="button" data-asistencia-crisis-cerrar>{{localize "LAGUNAK.Asistencia.Mando.CerrarCrisis"}}</button>
      {{else}}
        <button type="button" data-asistencia-crisis-abrir>{{localize "LAGUNAK.Asistencia.Mando.AbrirCrisis"}}</button>
      {{/if}}
    </div>
  {{/if}}

  {{#if mandoVisible}}
    <section class="lagunak-asistencia__mando" aria-label="{{localize "LAGUNAK.Asistencia.Mando.Titulo"}}">
      <h3>{{localize "LAGUNAK.Asistencia.Mando.Titulo"}}</h3>
      <p class="lagunak-asistencia__saldo" role="status">{{localize "LAGUNAK.Asistencia.Mando.Saldo"}}: {{mando.disponibles}}</p>
      {{#if mando.ventajaActiva}}
        <p class="lagunak-asistencia__mando-activo" role="status">
          {{localize "LAGUNAK.Asistencia.Mando.VentajaActiva"}} {{localize mandoVentajaClavePuesto}}
        </p>
      {{else}}
        <p class="lagunak-asistencia__intro">{{localize "LAGUNAK.Asistencia.Mando.Intro"}}</p>
        <ul class="lagunak-asistencia__puestos-mando">
          {{#each puestosMando}}
            <li><button type="button" data-asistencia-mando="{{id}}" {{#unless ../puedeOrdenarMando}}disabled{{/unless}}>{{localize claveNombre}}</button></li>
          {{/each}}
        </ul>
      {{/if}}
      {{#if mandoPendiente}}<p class="lagunak-asistencia__espera" role="status">{{localize "LAGUNAK.Asistencia.Mando.Pendiente"}}</p>{{/if}}
      {{#if mandoErrorClave}}<p class="lagunak-asistencia__mando-error" role="alert">{{localize mandoErrorClave}}</p>{{/if}}
    </section>
  {{/if}}

  {{#if enMenu}}
    <p class="lagunak-asistencia__intro">{{localize "LAGUNAK.Asistencia.Intro"}}</p>
    <ul class="lagunak-asistencia__tareas">
      {{#each tareas}}
        <li>
          <button type="button" data-asistencia-tarea="{{id}}" class="lagunak-asistencia__tarea">
            <span class="lagunak-asistencia__tarea-nombre">{{localize claveNombre}}</span>
            <span class="lagunak-asistencia__tarea-puesto">{{localize clavePuesto}}</span>
            {{! Una tarea narrativa se ofrece igual y dice lo que es: esconderla
                haría creer que a ese puesto no se le puede ayudar. Lo que no
                puede es prometer un efecto en la simulación. }}
            {{#if narrativa}}
              <span class="lagunak-asistencia__narrativa">{{localize "LAGUNAK.Asistencia.Narrativa"}}</span>
            {{/if}}
          </button>
        </li>
      {{else}}
        <li class="lagunak-asistencia__vacio">{{localize "LAGUNAK.Asistencia.SinTareas"}}</li>
      {{/each}}
    </ul>
  {{/if}}

  {{#if esperando}}
    <p class="lagunak-asistencia__espera" role="status">{{localize "LAGUNAK.Asistencia.Esperando"}}</p>
  {{/if}}

  {{#if enOferta}}
    {{#if ofertaEsDestreza}}
      {{! Sin dnd5e —o sin ficha— no hay enfoques entre los que elegir: la vía
          «destreza» ofrece un único gesto, empezar, en vez de una lista de un
          solo botón. }}
      <p class="lagunak-asistencia__intro">{{localize "LAGUNAK.Asistencia.Reto.SinFicha"}}</p>
      <button type="button" data-asistencia-destreza class="lagunak-asistencia__destreza">
        {{localize "LAGUNAK.Asistencia.Reto.Empezar"}}
      </button>
    {{else}}
      <p class="lagunak-asistencia__intro">{{localize "LAGUNAK.Asistencia.EligeEnfoque"}}</p>
      <ul class="lagunak-asistencia__enfoques">
        {{#each oferta.enfoques}}
          <li>
            <button type="button" data-asistencia-enfoque="{{id}}" class="lagunak-asistencia__enfoque">
              <span class="lagunak-asistencia__enfoque-nombre">{{localize claveNombre}}</span>
              {{! El número va en TEXTO y no solo como barra: una barra sola no la
                  lee un lector de pantalla ni quien no distingue relleno de fondo. }}
              {{#if conTirada}}
                <span class="lagunak-asistencia__probabilidad">
                  {{localize "LAGUNAK.Asistencia.Favorable"}} {{favorable}}%
                </span>
              {{else}}
                <span class="lagunak-asistencia__probabilidad">{{localize "LAGUNAK.Asistencia.SinTirada"}}</span>
              {{/if}}
              {{! El coste, pegado a la opción y no en una confirmación posterior:
                  pagar un espacio de conjuro por sorpresa es cómo se consigue que
                  nadie vuelva a usar la ayuda. }}
              {{#if coste.espacio}}
                <span class="lagunak-asistencia__coste">
                  {{localize "LAGUNAK.Asistencia.CosteEspacio"}}
                </span>
              {{/if}}
            </button>
          </li>
        {{/each}}
      </ul>
    {{/if}}
  {{/if}}

  {{#if retoEsTemporizacion}}
    <p class="lagunak-asistencia__intro">{{localize "LAGUNAK.Asistencia.Reto.Intro"}}</p>
    <div class="lagunak-asistencia__pista">
      <span class="lagunak-asistencia__zona" data-asistencia-zona
        style="left: {{reto.zonaDesde}}%; width: {{reto.zonaAncho}}%;"></span>
      <span class="lagunak-asistencia__cursor" data-asistencia-cursor
        style="left: {{reto.cursor}}%;"></span>
    </div>
    {{! El canal NO visual del reto. Obligatorio, no un extra: un minijuego que
        solo se puede jugar viendo moverse una barra excluye a quien no la ve. }}
    <p class="lagunak-asistencia__lectura" data-asistencia-lectura role="status" aria-live="polite"></p>
    <button type="button" data-asistencia-pulsar class="lagunak-asistencia__pulsar">
      {{localize "LAGUNAK.Asistencia.Reto.Pulsar"}}
    </button>
  {{/if}}

  {{#if retoEsSecuencia}}
    <p class="lagunak-asistencia__intro">
      {{#if reto.enMuestra}}
        {{localize "LAGUNAK.Asistencia.Reto.Secuencia.Muestra"}}
      {{else}}
        {{localize "LAGUNAK.Asistencia.Reto.Secuencia.Entrada"}}
      {{/if}}
    </p>
    {{! Los botones solo aparecen en la fase de entrada: mientras se muestra la
        secuencia no hay nada que pulsar, solo mirar (y escuchar, vía lectura). }}
    {{#unless reto.enMuestra}}
      <p class="lagunak-asistencia__progreso">
        {{reto.progreso}} / {{reto.longitud}}
      </p>
      <ul class="lagunak-asistencia__simbolos">
        {{#each reto.simbolos}}
          <li>
            <button type="button" data-asistencia-simbolo="{{this}}" class="lagunak-asistencia__simbolo"
              aria-label="{{localize "LAGUNAK.Asistencia.Reto.Secuencia.Simbolo"}} {{this}}"></button>
          </li>
        {{/each}}
      </ul>
    {{/unless}}
    {{! El canal NO visual del reto: qué símbolo toca en la muestra, o cuánto
        queda en la entrada. La misma razón que en temporización: un minijuego
        que solo se juega viendo parpadear algo excluye a quien no lo ve.
        Va directo en la plantilla y no por `pintarBarra`: la secuencia se
        repinta con un `render()` completo en cada cambio, no a 60 Hz, así
        que no hace falta el parcheo manual del DOM que sí necesita el cursor. }}
    <p class="lagunak-asistencia__lectura" role="status" aria-live="polite">
      {{#if reto.enMuestra}}
        {{localize "LAGUNAK.Asistencia.Reto.Secuencia.LecturaMuestra"}}
        {{reto.lectura.posicion}}/{{reto.lectura.deSecuencia}}
      {{else}}
        {{localize "LAGUNAK.Asistencia.Reto.Secuencia.LecturaEntrada"}}
        {{reto.lectura.segundosRestantes}}s
      {{/if}}
    </p>
  {{/if}}

  {{#if retoEsPrecision}}
    <p class="lagunak-asistencia__intro">{{localize "LAGUNAK.Asistencia.Reto.Precision.Intro"}}</p>
    {{! Sin cursor: la zona está quieta y visible desde el principio, y el
        clic en cualquier punto de la pista ES la respuesta — no hace falta
        un botón aparte como el de temporización. }}
    <div class="lagunak-asistencia__pista lagunak-asistencia__pista--precision" data-asistencia-precision-pista>
      <span class="lagunak-asistencia__zona" data-asistencia-zona
        style="left: {{reto.zonaDesde}}%; width: {{reto.zonaAncho}}%;"></span>
    </div>
    {{! El canal NO visual del reto: aquí no hay nada que describir sobre una
        posición propia —no hay cursor hasta que se pulsa—, solo la cuenta
        atrás para decidir. Va directo en la plantilla, igual que en
        secuencia: no hay nada que se mueva a 60 Hz que justifique el
        parcheo manual del DOM. }}
    <p class="lagunak-asistencia__lectura" role="status" aria-live="polite">
      {{localize "LAGUNAK.Asistencia.Reto.Precision.Lectura"}}
      {{reto.lectura.segundosRestantes}}s
    </p>
  {{/if}}

  {{#if retoEsPuzzle}}
    <p class="lagunak-asistencia__intro">{{localize "LAGUNAK.Asistencia.Reto.Puzzle.Intro"}}</p>
    {{! El objetivo se ve SIEMPRE, no hay que memorizarlo ni adivinarlo a
        ciegas: la casilla marca "objetivo" con una clase aparte de
        "encendida" para que ambos estados se distingan sin depender solo
        del color. }}
    <ul class="lagunak-asistencia__celdas">
      {{#each reto.celdas}}
        <li>
          <button type="button" data-asistencia-celda="{{indice}}"
            class="lagunak-asistencia__celda
              {{#if objetivo}}lagunak-asistencia__celda--objetivo{{/if}}
              {{#if encendida}}lagunak-asistencia__celda--encendida{{/if}}"
            aria-pressed="{{encendida}}"
            aria-label="{{localize "LAGUNAK.Asistencia.Reto.Puzzle.Celda"}} {{indice}}"></button>
        </li>
      {{/each}}
    </ul>
    <button type="button" data-asistencia-enviar class="lagunak-asistencia__enviar">
      {{localize "LAGUNAK.Asistencia.Reto.Puzzle.Enviar"}}
    </button>
    {{! El canal NO visual: qué casillas hay que encender (en base 1, las
        mismas que se ven marcadas), la cuenta atrás, y el resultado del
        último envío si lo hay — un intento incompleto no cierra el reto,
        así que sin este texto no habría forma de saber por qué sigue
        abierto sin contar de nuevo las casillas a mano. }}
    <p class="lagunak-asistencia__lectura" role="status" aria-live="polite">
      {{localize "LAGUNAK.Asistencia.Reto.Puzzle.Lectura"}}
      {{reto.lectura.posiciones}} — {{reto.lectura.segundosRestantes}}s
      {{#if reto.ultimoIntento}}
        · {{localize "LAGUNAK.Asistencia.Reto.Puzzle.UltimoIntento"}}
        {{reto.ultimoIntento.aciertos}}/{{reto.ultimoIntento.sobrantes}}
      {{/if}}
    </p>
  {{/if}}

  {{#if cerrada}}
    <p class="lagunak-asistencia__cierre lagunak-asistencia__cierre--{{cierre.tipo}}" role="status">
      {{localize cierre.claveTitular}}
    </p>
    {{#if cierre.claveBanda}}
      <p class="lagunak-asistencia__banda">{{localize cierre.claveBanda}}</p>
    {{/if}}
    {{! Quién la gasta importa, y no es quien ayudó: el token lo consume el
        titular dentro de una orden suya. }}
    {{#if cierre.clavePuesto}}
      <p class="lagunak-asistencia__destino">
        {{localize "LAGUNAK.Asistencia.LaGastaElTitular"}} {{localize cierre.clavePuesto}}
      </p>
    {{/if}}
    {{#if cierre.claveDetalle}}
      <p class="lagunak-asistencia__detalle">{{localize cierre.claveDetalle}}</p>
    {{/if}}
    <button type="button" data-asistencia-volver class="lagunak-asistencia__volver">
      {{localize "LAGUNAK.Asistencia.Volver"}}
    </button>
  {{/if}}

</section>
