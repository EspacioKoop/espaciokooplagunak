#: scripts/scenario_47_scavenger.lua:2276
#, lua-format
msgctxt "contract-comms"
msgid ""
"Contract Details:\n"
"Travel to %s system to deliver cargo to supply station %s. Distance to system: %i units. Upon delivery, %s technicians will upgrade your battery efficiency and beam cycle time."
msgstr "Detalles del contrato: Viajes %s sistema de entrega de carga a la estación de suministro %sDistancia al sistema: %i Unidades. %s los técnicos mejorarán la eficiencia de la batería y el tiempo del ciclo del haz."

#: scripts/scenario_47_scavenger.lua:2280
#, lua-format
msgctxt "contract-comms"
msgid "The Human Navy requires all armed ships be equipped with the ability to drop mines. We have modified %s with a rear facing mining tube. Due to ship size constraints, we were only able to provide you with two mines."
msgstr "La Armada Humana requiere que todos los barcos armados estén equipados con la capacidad de soltar minas. %s con un tubo minero de frente trasero. Debido a las restricciones del tamaño de la nave, sólo pudimos proporcionarle dos minas."

#: scripts/scenario_47_scavenger.lua:2288
msgctxt "contract-comms"
msgid ""
"\n"
"\n"
"Your current cargo ("
msgstr ""
"\n"
"\n"
"Su cargamento actual ("

