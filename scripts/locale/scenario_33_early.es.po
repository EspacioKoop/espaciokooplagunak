#: scripts/scenario_33_early.lua:4776 scripts/scenario_33_early.lua:5339
msgctxt "trade-comms"
msgid "nothing"
msgstr "nada"

#: scripts/scenario_33_early.lua:4792
msgctxt "shipEnemy-comms"
msgid "We will see to your destruction!"
msgstr "¡Vamos a ver su destrucción!"

#: scripts/scenario_33_early.lua:4793
msgctxt "shipEnemy-comms"
msgid "Your bloodline will end here!"
msgstr "¡Tu linaje terminará aquí!"

#: scripts/scenario_33_early.lua:4794
msgctxt "shipEnemy-comms"
msgid "Your feeble threats are meaningless."
msgstr "Sus amenazas débiles no tienen sentido."

#: scripts/scenario_33_early.lua:4800
msgctxt "shipEnemy-comms"
msgid ""
"Ktzzzsss.\n"
"You will DIEEee weaklingsss!"
msgstr "Ktzzzss. ¡Usted va a DIEEee débil!"

#: scripts/scenario_33_early.lua:4803
msgctxt "shipEnemy-comms"
msgid "We will destroy you"
msgstr "Te destruiremos."

#: scripts/scenario_33_early.lua:4804
msgctxt "shipEnemy-comms"
msgid "We think not. It is you who will experience destruction!"
msgstr "Creemos que no. ¡Eres tú quien experimentará la destrucción!"

#: scripts/scenario_33_early.lua:4806
msgctxt "shipEnemy-comms"
msgid "You have no honor"
msgstr "No tienes honor."

#: scripts/scenario_33_early.lua:4807
msgctxt "shipEnemy-comms"
msgid "Your insult has brought our wrath upon you. Prepare to die."
msgstr "Tu insulto ha traído nuestra ira sobre ti. Prepárate para morir."

#: scripts/scenario_33_early.lua:4808
msgctxt "shipEnemy-comms"
msgid "Your comments about honor have no meaning to us"
msgstr "Sus comentarios sobre el honor no tienen significado para nosotros"

#: scripts/scenario_33_early.lua:4810
msgctxt "shipEnemy-comms"
msgid "We pity your pathetic race"
msgstr "Nos compadecemos de tu patética carrera"

#: scripts/scenario_33_early.lua:4811
msgctxt "shipEnemy-comms"
msgid "Pathetic? You will regret your disparagement!"
msgstr "¡Te arrepentirás de tu desprecio!"

#: scripts/scenario_33_early.lua:4812
msgctxt "shipEnemy-comms"
msgid "We don't care what you think of us"
msgstr "No nos importa lo que pienses de nosotros."

#: scripts/scenario_33_early.lua:4817
msgctxt "shipEnemy-comms"
msgid ""
"We wish you no harm, but will harm you if we must.\n"
"End of transmission."
msgstr "No le deseamos ningún daño, pero le dañaremos si es necesario."

#: scripts/scenario_33_early.lua:4821
msgctxt "shipEnemy-comms"
msgid "Stay out of our way, or your death will amuse us extremely!"
msgstr "¡No te acerques a nosotros, o tu muerte nos diluirá extremadamente!"

#: scripts/scenario_33_early.lua:4825
msgctxt "shipEnemy-comms"
msgid ""
"One zero one.\n"
"No binary communication detected.\n"
"Switching to universal speech.\n"
"Generating appropriate response for target from human language archives.\n"
":Do not cross us:\n"
"Communication halted."
msgstr "Uno cero. Ninguna comunicación binaria detectada. Intercambiando al discurso universal. Generando la respuesta adecuada para el objetivo de los archivos de lenguaje humano. :No nos cruzamos: La comunicación se detuvo."

#: scripts/scenario_33_early.lua:4826
msgctxt "shipEnemy-comms"
msgid "EXECUTE: SELFDESTRUCT"
msgstr "EXECUTE: SELFDESTRUCT"

#: scripts/scenario_33_early.lua:4827
msgctxt "shipEnemy-comms"
msgid "Rogue command received. Targeting source."
msgstr "Recibido el comando Rogue, fuente de orientación."

#: scripts/scenario_33_early.lua:4828
msgctxt "shipEnemy-comms"
msgid "External command ignored."
msgstr "El comando externo ignorado."

#: scripts/scenario_33_early.lua:4830
msgctxt "shipEnemy-comms"
msgid ""
"The hive suffers no threats. Opposition to any of us is opposition to us all.\n"
"Stand down or prepare to donate your corpses toward our nutrition."
msgstr "La colmena no sufre amenazas. La oposición a cualquiera de nosotros es oposición a todos nosotros. Bajar o prepararse para donar sus cadáveres hacia nuestra nutrición."

#: scripts/scenario_33_early.lua:4831
msgctxt "shipEnemy-comms"
msgid "<Transmit 'The Itsy-Bitsy Spider' on all wavelengths>"
msgstr "<Transmit 'The Itsy-Bitsy Spider' on all wavelengths>"

#: scripts/scenario_33_early.lua:4832
msgctxt "shipEnemy-comms"
msgid "We do not need permission to pluck apart such an insignificant threat."
msgstr "No necesitamos permiso para separar una amenaza tan insignificante."

#: scripts/scenario_33_early.lua:4833
msgctxt "shipEnemy-comms"
msgid "The hive has greater priorities than exterminating pests."
msgstr "La colmena tiene mayores prioridades que exterminar plagas."

#: scripts/scenario_33_early.lua:4837
msgctxt "shipEnemy-comms"
msgid "State your business"
msgstr "Diga su negocio"

#: scripts/scenario_33_early.lua:4841
msgctxt "shipEnemy-comms"
msgid "What do you want? (not that we care)"
msgstr "¿Qué quieres?"

#: scripts/scenario_33_early.lua:4845
msgctxt "shipEnemy-comms"
msgid "Don't waste our time"
msgstr "No pierdas nuestro tiempo."

#: scripts/scenario_33_early.lua:4847
msgctxt "shipEnemy-comms"
msgid "Mind your own business!"
msgstr "¡Cuidado con tu propio negocio!"

#: scripts/scenario_33_early.lua:4887
msgctxt "shipEnemy-comms"
msgid "Subspace and time continuum disruption authorized"
msgstr "Trastorno continuo y subespacial autorizado"

#: scripts/scenario_33_early.lua:4905
msgctxt "shipEnemy-comms"
msgid "Stop your actions"
msgstr "Detengan sus acciones"

#: scripts/scenario_33_early.lua:4929
msgctxt "shipEnemy-comms"
msgid "Just this once, we'll take your advice"
msgstr "Sólo esta vez, tomaremos su consejo"

#: scripts/scenario_33_early.lua:4931
msgctxt "shipEnemy-comms"
msgid "No"
msgstr "No"

#: scripts/scenario_33_early.lua:5255
#, lua-format
msgctxt "tabRelay"
msgid "Disruption %i"
msgstr "Disrupción %i"

#: scripts/scenario_33_early.lua:5289
msgctxt "trade-comms"
msgid "Yes?"
msgstr "¿Sí?"

#: scripts/scenario_33_early.lua:5292
msgctxt "ship-comms"
msgid "We are in need of some assistance."
msgstr "Necesitamos ayuda."

#: scripts/scenario_33_early.lua:5293
msgctxt "ship-comms"
msgid "What kind of assistance do you need?"
msgstr "¿Qué tipo de asistencia necesita?"

#: scripts/scenario_33_early.lua:5296
msgctxt "ship-comms"
msgid "We're not exactly sure. We just know our engines are not working"
msgstr "Sabemos que nuestros motores no funcionan."

#: scripts/scenario_33_early.lua:5297
msgctxt "ship-comms"
msgid "May we scan your ship?"
msgstr "¿Podemos escanear su nave?"

#: scripts/scenario_33_early.lua:5298
msgctxt "ship-comms"
msgid "If that helps you figure out what's wrong with the engines, go right ahead"
msgstr "Si eso te ayuda a averiguar qué pasa con los motores, adelante"

#: scripts/scenario_33_early.lua:5299
#, lua-format
msgctxt "ship-comms"
msgid "We'll provide %s with your ship data and get back to you"
msgstr "Vamos a proveer. %s con los datos de su nave y volver a usted"

#: scripts/scenario_33_early.lua:5300
msgctxt "ship-comms"
msgid "We'll be here. We're not going enywhere. We are worried about Kraylor in the area, so don't take too long"
msgstr "No vamos a ir a ninguna parte, estamos preocupados por Kraylor en la zona, así que no tardes demasiado."

#: scripts/scenario_33_early.lua:5310
msgctxt "ship-comms"
msgid "Deliver repair parts"
msgstr "Entregar piezas de reparación"

#: scripts/scenario_33_early.lua:5312
msgctxt "ship-comms"
msgid "These match exactly what we need. We will fully restore our engines shortly"
msgstr "Estos coinciden exactamente lo que necesitamos. Vamos a restaurar completamente nuestros motores en breve"

#: scripts/scenario_33_early.lua:5316
msgctxt "ship-comms"
msgid "These parts don't look like they solve our problem. You may want to double check the information you provided to the parts supplier"
msgstr "Estas partes no parecen resolver nuestro problema. Es posible que desee comprobar la información que proporcionó al proveedor de las partes."

#: scripts/scenario_33_early.lua:5345
msgctxt "shipAssist-comms"
msgid "Where are you going?"
msgstr "¿A dónde vas?"

#: scripts/scenario_33_early.lua:5347
#, lua-format
msgctxt "shipAssist-comms"
msgid "Hi %s,"
msgstr "Hola. %s,"

#: scripts/scenario_33_early.lua:5354
#, lua-format
msgctxt "shipAssist-comms"
msgid ""
"%s\n"
"Heading for %s station %s in sector %s"
msgstr ""
"%s\n"
"Heading for %s estación %s en el sector %s"

#: scripts/scenario_33_early.lua:5505
msgctxt "ship-comms"
msgid ""
"Sorry, we have no time to chat with you.\n"
"We are on an important mission."
msgstr "Lo siento, no tenemos tiempo para charlar contigo, estamos en una misión importante."

#: scripts/scenario_33_early.lua:5507
msgctxt "ship-comms"
msgid ""
"We have nothing for you.\n"
"Good day."
msgstr "No tenemos nada para ti."

#: scripts/scenario_33_early.lua:5526
#, lua-format
msgctxt "msgHelms"
msgid "The most direct route to dock with station %s is to put the ship in full reverse impulse. The engines start at minimal power, so you may have to ask engineering to put more power in the impulse engines. You get a better evaluation score the higher your speed. You won't be able to dock until the docking protocols are satisfied."
msgstr "La ruta más directa para acoplarse con la estación %s es poner el barco en el impulso inverso completo. Los motores comienzan con una potencia mínima, por lo que puede tener que pedir ingeniería para poner más potencia en los motores de impulso. Usted obtiene una mejor puntuación de evaluación el mayor de su velocidad. Usted no será capaz de atracar hasta que los protocolos de acoplamiento estén satisfechos."

#: scripts/scenario_33_early.lua:5530
#, lua-format
msgctxt "msgWeapons"
msgid "Get the docking protocol shield and beam frequency from %s. Calibrate the shields by adjusting the frequency in the lower right of your console then click the calibrate button. Set the beam weapons frequency by adjusting the frequency above the shield frequency in the lower right of your console."
msgstr "Obtener el escudo de protocolo de bloqueo y la frecuencia de haz de %s. Calibrar los escudos ajustando la frecuencia en la parte inferior derecha de la consola y luego haga clic en el botón calibrar. Configurar la frecuencia de las armas de haz ajustando la frecuencia de la frecuencia del escudo en la parte inferior derecha de la consola."

#: scripts/scenario_33_early.lua:5534
#, lua-format
msgctxt "msgTactical"
msgid "%s Get the docking protocol beam frequency from %s. Calibrate the beams using the frequency shown along the bottom edge of your console in the middle of your console."
msgstr "%s Obtenga la frecuencia del haz del protocolo de bloqueo %s. Calibrar las vigas usando la frecuencia mostrada a lo largo del borde inferior de su consola en el centro de su consola."

#: scripts/scenario_33_early.lua:5538
#, lua-format
msgctxt "msgEngineer"
msgid "All systems start at a low power level. You'll want to put power in the impulse engines based on the first task requirement. Be prepared to run the impulse engines up to 300%% with max coolant at Helm's request until you reach the station. You'll hear from %s that the docking protocol calls for zero power in the missile systems, so take the power all the way out of missile systems."
msgstr "Todos los sistemas comienzan a un nivel de potencia bajo. Usted querrá poner energía en los motores de impulso basados en el primer requisito de tarea. Prepárese para ejecutar los motores de impulso hasta 300%% con el refrigerante máximo a petición de Helm hasta llegar a la estación. %s que el protocolo de acoplamiento requiere energía cero en los sistemas de misiles, así que tome el poder todo el camino fuera de los sistemas de misiles."

#: scripts/scenario_33_early.lua:5542
#, lua-format
msgctxt "msgEngineer+"
msgid "%s The docking protocol also calls for shield calibration. Listen for the shield frequency. Adjust the shield frequency with the frequency selector along the left edge of your console in the middle. Click the Calibrate button after you have set the frequency."
msgstr "%s El protocolo de docking también requiere calibración de escudo. Escuchar la frecuencia de escudo. Ajustar la frecuencia de escudo con el selector de frecuencia a lo largo del borde izquierdo de la consola en el centro. Haga clic en el botón Calibrar después de haber fijado la frecuencia."

#: scripts/scenario_33_early.lua:5546
#, lua-format
msgctxt "msgRelay"
msgid "To contact station %s for the docking protocol, click %s then click the Open Comms button in the upper left of your console. Once communications are open, click the Check with docking port authority button to determine the docking protocol. Report the protocol to your crew."
msgstr "Para contactar con la estación %s para el protocolo de atraque, haga clic en %s y luego haga clic en el botón Abrir Comms en la parte superior izquierda de su consola. Una vez que las comunicaciones estén abiertas, haga clic en el botón Comprobar con autoridad portuaria de muelle para determinar el protocolo de atraque. Informe del protocolo a su tripulación."

#: scripts/scenario_33_early.lua:5550
#, lua-format
msgctxt "msgOperations"
msgid "To contact station %s for the docking protocol, click %s then click the Open Comms button along the bottom edge of your console to the right. Once communications are open, click the Check with docking port authority button to determine the docking protocol. Report the protocol to your crew."
msgstr "Para contactar con la estación %s para el protocolo de atraque, haga clic en %s y luego haga clic en el botón Abrir Comms a lo largo del borde inferior de su consola, a la derecha. Una vez que las comunicaciones estén abiertas, haga clic en el botón Comprobar con autoridad portuaria de muelle para determinar el protocolo de atraque. Informe del protocolo a su tripulación."

#: scripts/scenario_33_early.lua:5557
msgctxt "msgHelms"
msgid "You might be asked to jump into the nearby nebula so that a freighter can be scanned."
msgstr "Se le podría pedir que saltara a la nebulosa cercana para que un carguero pueda ser escaneado."

#: scripts/scenario_33_early.lua:5566
#, lua-format
msgctxt "msgScience"
msgid "Start scanning the target at bearing %.1f right away. Report the type of ship as soon as you finish the simple scan. Then start the deep scan. The default keyboard shortcut is S to start the scan. After completing the deep scan, get the scanned ship's strongest shield deflection frequency by hovering over the lowest, reddest point on the bar graph. Report that frequency."
msgstr "Comience a escanear el objetivo en el rodamiento %.1f Informe el tipo de barco tan pronto como termine el escaneo simple. A continuación, inicie el escaneo profundo. El atajo de teclado predeterminado es S para iniciar el escaneo. Después de completar el escaneo profundo, obtenga la frecuencia de desflexión del escudo más fuerte del barco escaneado por el punto más bajo y más rojo en el gráfico de la barra."

#: scripts/scenario_33_early.lua:5570
msgctxt "msgRelay"
msgid "Send a probe to the middle of the nearest nebula: click the launch probe button, then click the middle of the nebula. Once it's there, link it to science. Be ready to report the ship type and the frequency as soon as Science completes each scan."
msgstr "Envíe una sonda al centro de la nebulosa más cercana: haga clic en el botón de sonda de lanzamiento, luego haga clic en el centro de la nebulosa. Una vez que esté allí, enlace a la ciencia. Prepárese para informar el tipo de barco y la frecuencia tan pronto como la Ciencia complete cada escaneo."

#: scripts/scenario_33_early.lua:5574
#, lua-format
msgctxt "msgOperations"
msgid "Start scanning the target at bearing %.1f right away. There are likely more targets in the nebula, so you should request that helm or tactical take you closer to the nebula. Report the type of ship as soon as you finish the simple scan. Then start the deep scan. The default keyboard shortcut is S to start the scan. After completing the deep scan, get the scanned ship's strongest shield deflection frequency by hovering over the lowest, reddest point on the bar graph. Report that frequency. Once you scan the other targets that are likely in the nebula, you will need to exit the nebula to report their characteristics to %s."
msgstr "Comience a escanear el objetivo en el rodamiento %.1f Probablemente hay más objetivos en la nebulosa, por lo que debe solicitar que el timón o táctica le lleven más cerca de la nebulosa. Informe el tipo de barco tan pronto como termine el simple escaneo. A continuación, inicie el escaneo profundo. El atajo de teclado predeterminado es S para iniciar el escaneo. Después de completar la exploración profunda, obtener la frecuencia de deflexión de escudo más fuerte de la nave escaneada atravesando el punto más bajo y más rojo en el gráfico de la barra. Informe esa frecuencia. Una vez que escanea los otros objetivos que son probables en la nebulosa, tendrá que salir de la nebulosa para informar sus características a %s."

#: scripts/scenario_33_early.lua:5579
msgctxt "msgHelms"
msgid "Jump to the enemy freighter if it's farther than 5 units away. Get the bearing and distance from Science or Operations, subtract 2 units to place you in optimal firing range. Once you're near, rotate to point the left or right tube to the enemy. He'll try to run away, so be ready to angle the tube to lead the HVLIs in front of the enemy freighter."
msgstr "Saltar al carguero enemigo si está más lejos de 5 unidades. Obtener el rodamiento y la distancia de Ciencia o Operaciones, restar 2 unidades para colocarle en el rango de disparo óptimo. Una vez que esté cerca, girar para apuntar el tubo izquierdo o derecho al enemigo. Él tratará de huir, así que esté listo para apuntar el tubo para dirigir los HVLIs delante del carguero enemigo."

#: scripts/scenario_33_early.lua:5583
msgctxt "msgWeapons"
msgid "Load up HVLIs on both sides. You may have to ask Engineering for power to missile systems."
msgstr "Cargar HVLIs en ambos lados. Es posible que tenga que pedir a Engineering energía para sistemas de misiles."

#: scripts/scenario_33_early.lua:5591
msgctxt "msgEngineer"
msgid "Raise power to missile systems to 100%. Put even more in along with coolant to make them load faster. Be ready to add power to impulse and/or maneuvering as requested."
msgstr "Aumente el poder a los sistemas de misiles al 100%. Ponga aún más en conjunto con refrigerante para hacer que se carguen más rápido. Prepárese para añadir energía al impulso y/o maniobrar según lo solicitado."

#: scripts/scenario_33_early.lua:5599
msgctxt "msgScience"
msgid "Select the enemy freighter. Use radar or probe view as applicable. Provide bearing and distance to freighter to crew. You can find it along the right of your console screen."
msgstr "Seleccione el carguero enemigo. Utilice la vista de radar o sonda según sea aplicable. Proporcione rodamientos y distancia al carguero a la tripulación. Puede encontrarlo a lo largo de la derecha de su pantalla de consola."

#: scripts/scenario_33_early.lua:5603
msgctxt "msgOperations"
msgid "Provide bearing and range to enemy freighter. If nebula obscures your view, estimate based on recent scans, otherwise click the enemy freighter and read the bearing and distance from your console."
msgstr "Proporcione el rodamiento y el rango al carguero enemigo. Si nebula oscurece su vista, estimar basado en escaneos recientes, haga clic en el carguero enemigo y lea el rodamiento y la distancia de su consola."

#: scripts/scenario_33_early.lua:5607
msgctxt "msgRelay"
msgid "Hack enemy ships once they are in range either via probe or your ship. Impulse engines for the fighter types is a good choice since it makes it easier to shoot them down."
msgstr "Los barcos enemigos de Hack una vez que están en rango ya sea a través de la sonda o su barco. Motores impulsos para los tipos de luchadores es una buena opción ya que hace más fácil derribarlos."

#: scripts/scenario_33_early.lua:5612
msgctxt "msgHelms"
msgid "You will have to go to the distressed freighter to help defend it against Kraylor and to help repair it. You may have to pick up parts from your home station. Deciding which to do first will be up to your commanding officer or CO. Be thinking about both options."
msgstr "Usted tendrá que ir al carguero angustiado para ayudar a defenderlo contra Kraylor y para ayudar a repararlo. Usted puede tener que recoger partes de su estación de casa. Decidir qué hacer primero será hasta su oficial de mando o CO. Tenga en cuenta ambas opciones."

#: scripts/scenario_33_early.lua:5616
msgctxt "msgWeapons"
msgid "Your beams are fully functional. Your missiles have been returned to you. Load up your tubes in preparation for combat. Homing missiles are recommended. Even homing missiles can be dodged by the enemy. Try for as straight a shot as possible."
msgstr "Sus rayos son totalmente funcionales. Sus misiles han sido devueltos a usted. Carguen sus tubos en preparación para el combate. Se recomiendan los misiles Homing. Incluso los misiles homing pueden ser dodigados por el enemigo. Probar tan recto como sea posible."

#: scripts/scenario_33_early.lua:5624
msgctxt "msgEngineer"
msgid "Pay careful attention to what systems are used and give them additional power when needed (along with coolant). Remember the docking/undocking protocol (no missile energy)"
msgstr "Preste atención cuidadosa a qué sistemas se utilizan y déles energía adicional cuando sea necesario (junto con refrigerante). Recuerde el protocolo de docking/undocking (sin energía de misiles)"

#: scripts/scenario_33_early.lua:5632
msgctxt "msgScience"
msgid "Scan the distressed Arlenian freighter as soon as you can (twice). After the second scan, get the impulse engine damage percentage by clicking the Tactical widget and selecting Systems. Report it to Relay who will report it to the home station."
msgstr "Escríbete el carguero arleniano angustiado tan pronto como puedas (twice). Después de la segunda escaneo, obtenga el porcentaje de daño del motor impulso haciendo clic en el widget táctico y seleccionando Sistemas."

#: scripts/scenario_33_early.lua:5636
msgctxt "msgRelay"
msgid "Launch probes to cover the sector where the distressed Arlenian freighter is located. Link the probe that finds the freighter to science. Contact the freighter. Report Science's scan results to your home station."
msgstr "Inicie sondas para cubrir el sector donde se encuentra el carguero arleniano angustiado. Enlace la sonda que encuentra el carguero a la ciencia. Contacte con el carguero."

#: scripts/scenario_33_early.lua:5640
msgctxt "msgOperations"
msgid "Contact the distressed Arlenian freighter, then scan the freighter as soon as you can (twice). After the second scan, get the impulse engine damage percentage by clicking the Tactical widget and selecting Systems. Report it to the home station."
msgstr "Contacte con el carguero Arleniano angustiado, luego escanee el carguero tan pronto como pueda (twice). Después de la segunda escanografía, obtenga el porcentaje de daño del motor impulso haciendo clic en el widget táctico y seleccionando Sistemas."

#: scripts/scenario_33_early.lua:5645
msgctxt "msgHelms"
msgid "Use warp to approach but not intersect the planets and moons in motion. Intersetion will damage and quickly destroy your ship. Use guidance from Relay/Science/Operations for good approach vectors. Warn Engineering when you use warp, especially anything above warp one."
msgstr "Use warp para aproximarse sin intersectar los planetas y lunas en movimiento. La intersección dañará y destruirá rápidamente su nave. Utilice la guía de Relay/Science/Operations para los vectores de buena aproximación. Avise a Ingeniería cuando use warp, especialmente por encima de warp uno."

#: scripts/scenario_33_early.lua:5649
msgctxt "msgWeapons"
msgid "Watch for enemy targets of opportunity. The planets and moons are far more dangerous, but if you leave the enemies alone, eventually, they will start attacking your home station."
msgstr "Los planetas y las lunas son mucho más peligrosos, pero si dejas a los enemigos solos, eventualmente, empezarán a atacar tu estación de casa."

#: scripts/scenario_33_early.lua:5657
msgctxt "msgEngineer"
msgid "Suggested default settings: 50% coolant in warp, 50% coolant in maneuvering, 150% power in maneuvering, remaining systems: 100%, remainig coolant: 0. Watch energy carefully and let the commanding officer know when you get below 200 so you can dock and get more. The reactor will help, but charging at a station is more efficient."
msgstr "Ajustes predeterminados sugeridos: 50% coolant en warp, 50% coolant en maniobra, 150% power en maniobras, sistemas restantes: 100%, refrigerante de mantenimiento: 0. Mira la energía con cuidado y deja que el oficial de mando sepa cuándo tienes menos de 200 para que puedas atracar y obtener más. El reactor ayudará, pero la carga en una estación es más eficiente."

#: scripts/scenario_33_early.lua:6236
#, lua-format
msgctxt "human-incCall"
msgid "You completed the research task. Destroy any Kraylor headed for %s"
msgstr "Has completado la tarea de investigación. %s"

#: scripts/scenario_33_early.lua:6238
msgctxt "goal-shipLog"
msgid "You completed the research task. Destroy any Kraylor that were headed for your home base"
msgstr "Has completado la tarea de investigación. Destruir cualquier Kraylor que se dirigía a tu base de origen"

#: scripts/scenario_33_early.lua:6360
#, lua-format
msgctxt "msgRelay&Operations"
msgid "%s   Scan started at %.1f"
msgstr "%s   Scan comenzó en %.1f"

#: scripts/scenario_33_early.lua:6368
#, lua-format
msgctxt "msgRelay&Operations"
msgid ""
"Orbital body researched status:\n"
"Completed: %s     Remaining: %s\n"
"%s"
msgstr ""
"Estado investigado por el cuerpo orbital: Completado: %s     Permaneciendo: %s\n"
"%s"

#: scripts/scenario_33_early.lua:6371
msgctxt "msgRelay&Operations"
msgid "Enemy ships hunting"
msgstr "Enemigos cazando barcos"

#: scripts/scenario_33_early.lua:6373
