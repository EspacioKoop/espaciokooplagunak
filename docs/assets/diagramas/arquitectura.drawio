        <mxCell id="tempo" value="&lt;b&gt;tempo-control.mjs&lt;/b&gt;&lt;br&gt;[Componente]&lt;br&gt;Pausa/reanudación (orden cerrada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;" vertex="1" parent="1">
