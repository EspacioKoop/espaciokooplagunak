msgstr "Pérdida automática después de 60 minutos"

# Scenario setting
msgctxt "setting"
msgid "PlayerShip"
msgstr "PlayerShip"

msgctxt "setting"
msgid "Sets the default player ship"
msgstr "Establece el barco de jugador predeterminado"

msgctxt "PlayerShip"
msgid "Atlantis"
msgstr "Atlantis"

msgctxt "PlayerShip"
msgid "Powerful ship with sidewards missile tubes. Requires more advanced play."
msgstr "Nave potente con tubos de misiles laterales. Requiere un juego más avanzado."

msgctxt "PlayerShip"
msgid "Phobos M3P"
msgstr "Phobos M3P"

msgctxt "PlayerShip"
msgid "Simpler, less powerful ship. But easier to handle. Recommended for new crews."
msgstr "Un barco más sencillo y menos potente, pero más fácil de manejar. Recomendado para nuevos equipos."

