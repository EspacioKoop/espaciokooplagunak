<mxfile host="app.diagrams.net">
  <diagram id="c4-contexto" name="C4-1 Contexto">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="Nivel 1 — Contexto del sistema&#10;Espaciokoop Lagunak como simulador operativo de nave para campañas de Foundry VTT" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gm" value="&lt;b&gt;Director de juego (GM)&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Dirige la campaña, controla el tempo y anota consecuencias narrativas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tripulacion" value="&lt;b&gt;Tripulación&lt;/b&gt;&lt;br&gt;[Persona]&lt;br&gt;&lt;br&gt;Ocupa los puestos de la nave (timón, armas, ingeniería…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;" vertex="1" parent="1">
          <mxGeometry x="820" y="120" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="foundry" value="&lt;b&gt;Foundry VTT&lt;/b&gt;&lt;br&gt;[Sistema de software externo]&lt;br&gt;&lt;br&gt;Mesa virtual: campaña, fichas, mapas narrativos y diarios. Autoritativa para la narrativa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lagunak" value="&lt;b&gt;Espaciokoop Lagunak&lt;/b&gt;&lt;br&gt;[Sistema de software]&lt;br&gt;&lt;br&gt;Simulación autoritativa de la nave: posición, sistemas, daños, encuentros. Fork de EmptyEpsilon + puente de integración" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;" vertex="1" parent="1">
          <mxGeometry x="450" y="330" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#707070;fontColor=#404040;" edge="1" parent="1" source="gm" target="foundry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1l" value="Dirige la campaña y consulta el estado vivo [navegador]" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="-0.2" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#707070;fontColor=#404040;" edge="1" parent="1" source="tripulacion" target="lagunak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2l" value="Opera los puestos de la nave [cliente nativo, LAN]" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e2">
          <mxGeometry x="-0.2" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#707070;fontColor=#404040;" edge="1" parent="1" source="foundry" target="lagunak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3l" value="Lee estado/eventos y envía órdenes de lista blanca [HTTP + Bearer, polling]" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e3">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="c4-contenedores" name="C4-2 Contenedores">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo2" value="Nivel 2 — Contenedores&#10;Despliegue de referencia: docker/compose.yaml (red interna «espaciokoop»)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="50" as="geometry" />
        </mxCell>
        <mxCell id="frontera" value="Docker Compose — red interna «espaciokoop»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=bottom;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="680" height="420" as="geometry" />
        </mxCell>
        <mxCell id="game" value="&lt;b&gt;Servidor headless del juego&lt;/b&gt;&lt;br&gt;[Contenedor: C++ / SDL2 / Lua]&lt;br&gt;&lt;br&gt;Simulación autoritativa. Escenarios Lua. HTTP interno :8080 con /exec.lua — NUNCA publicado al host. Puerto de juego :35666 (TCP/UDP) hacia la LAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="760" y="180" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="bridge" value="&lt;b&gt;Puente de integración&lt;/b&gt;&lt;br&gt;[Contenedor: Python / FastAPI]&lt;br&gt;&lt;br&gt;Única pieza autorizada a hablar con /exec.lua. API v1 en :8090 (bind 127.0.0.1 por defecto): auth Bearer, CORS estricto, rate limit y órdenes de lista blanca" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="460" y="180" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="foundrysrv" value="&lt;b&gt;Servidor Foundry VTT&lt;/b&gt;&lt;br&gt;[Sistema externo: Node.js]&lt;br&gt;&lt;br&gt;Aloja el mundo y sirve la aplicación web a GM y jugadores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cliente" value="&lt;b&gt;Clientes nativos&lt;/b&gt;&lt;br&gt;[Aplicación de escritorio]&lt;br&gt;&lt;br&gt;Puestos de la tripulación (EmptyEpsilon)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="navegador" value="&lt;b&gt;Navegador del GM + módulo Lagunak&lt;/b&gt;&lt;br&gt;[Aplicación web cliente]&lt;br&gt;&lt;br&gt;Hace fetch directo al puente. URL y Bearer v0 viven en settings client provisionales" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="80" y="570" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="jugadores-web" value="&lt;b&gt;Navegadores de jugadores&lt;/b&gt;&lt;br&gt;[Aplicación web cliente]&lt;br&gt;Sesión Foundry; sin token ni acceso al puente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2E6295;" vertex="1" parent="1">
          <mxGeometry x="80" y="730" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;fontColor=#404040;" edge="1" parent="1" source="navegador" target="bridge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c1l" value="fetch directo: GET /healthz /v1/* · POST /v1/command [HTTP + Bearer, polling, CORS]" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="c1">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;fontColor=#404040;" edge="1" parent="1" source="bridge" target="game">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2l" value="POST /exec.lua — solo plantillas Lua definidas en el puente [HTTP, red interna]" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="c2">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;fontColor=#404040;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="cliente" target="game">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3l" value=":35666 TCP/UDP [protocolo del juego, LAN]" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="c3">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;fontColor=#404040;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="navegador" target="foundrysrv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4l" value="Sesión de Foundry [WebSocket/HTTP]" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="c4e">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c5e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#707070;fontColor=#404040;" edge="1" parent="1" source="jugadores-web" target="foundrysrv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c5l" value="Sesión de Foundry [WebSocket/HTTP] — sin acceso al puente" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="c5e">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>
      </root>
