{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Índice de decisiones arquitectónicas",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "path", "status"],
    "properties": {
      "id": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
      "title": { "type": "string", "minLength": 1 },
      "path": { "type": "string", "pattern": "^[0-9]{4}-[a-z0-9-]+\\.md$" },
      "status": {
        "type": "string",
        "enum": ["Propuesta", "Aceptada", "Deprecada"]
      }
    },
    "additionalProperties": false
  }
}
