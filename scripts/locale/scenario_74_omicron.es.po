msgstr "Necesitas establecer un punto de referencia antes de que puedas solicitar refuerzos."

#: scripts/scenario_74_omicron.lua:4737
msgctxt "stationAssist-comms"
msgid "To which waypoint should we dispatch the reinforcements?"
msgstr "¿A qué punto deberíamos enviar los refuerzos?"

#: scripts/scenario_74_omicron.lua:4744
#, lua-format
msgctxt "stationAssist-comms"
msgid "We have dispatched %s to assist at WP %d"
msgstr "Hemos enviado %s para ayudar en WP %d"

#: scripts/scenario_74_omicron.lua:4756
msgctxt "stationAssist-comms"
msgid "Please send a service jonque for repairs"
msgstr "Por favor envíen un jonque de servicio para reparaciones"

#: scripts/scenario_74_omicron.lua:4757
#, lua-format
msgctxt "stationAssist-comms"
msgid "Would you like the service jonque to come to you directly or would you prefer to set up a rendezvous via a waypoint? Either way, you will need %.1f reputation."
msgstr "¿Le gustaría que la jonque de servicio viniera a usted directamente o preferiría establecer una cita a través de un punto de vista? De cualquier manera, necesitará %.1f reputación."

#: scripts/scenario_74_omicron.lua:4796
#, lua-format
msgctxt "stationAssist-comms"
msgid "We have dispatched %s to come to you to help with repairs"
msgstr "Hemos enviado %s para venir a usted para ayudar con reparaciones"

