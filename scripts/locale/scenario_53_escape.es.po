#: scripts/scenario_53_escape.lua:1309
msgctxt "station-comms"
msgid "We are under attack! No time for chatting!"
msgstr "¡No hay tiempo para charlar!"

#: scripts/scenario_53_escape.lua:1322
msgctxt "station-comms"
msgid ""
"Good day, officer!\n"
"What can we do for you today?\n"
msgstr "Buenos días, oficial. ¿Qué podemos hacer por usted hoy?\n"

#: scripts/scenario_53_escape.lua:1324
msgctxt "station-comms"
msgid "Welcome to our lovely station.\n"
msgstr "Bienvenido a nuestra hermosa estación.\n"

#: scripts/scenario_53_escape.lua:1327
msgctxt "station-comms"
msgid "Forgive us if we seem a little distracted. We are carefully monitoring the enemies nearby."
msgstr "Perdónenos si parecemos un poco distraídos. Estamos monitoreando cuidadosamente a los enemigos cercanos."

#: scripts/scenario_53_escape.lua:1342
msgctxt "ammo-comms"
msgid "I need ordnance restocked"
msgstr "Necesito la artillería restablecida"

#: scripts/scenario_53_escape.lua:1346
msgctxt "ammo-comms"
msgid "Can you supply us with some nukes?"
msgstr "¿Nos puedes dar unos nukes?"

#: scripts/scenario_53_escape.lua:1347
msgctxt "ammo-comms"
msgid "We really need some nukes."
msgstr "Realmente necesitamos algunos nukes."

#: scripts/scenario_53_escape.lua:1348
msgctxt "ammo-comms"
msgid "Can you restock our nuclear missiles?"
msgstr "¿Puede restaurar nuestros misiles nucleares?"

#: scripts/scenario_53_escape.lua:1351
msgctxt "ammo-comms"
msgid "Please restock our EMP missiles."
msgstr "Por favor, recupere nuestros misiles EMP."

#: scripts/scenario_53_escape.lua:1352
msgctxt "ammo-comms"
msgid "Got any EMPs?"
msgstr "¿Tienes alguna EMP?"

#: scripts/scenario_53_escape.lua:1353
msgctxt "ammo-comms"
msgid "We need Electro-Magnetic Pulse missiles."
msgstr "Necesitamos misiles de pulso electromagnético."

#: scripts/scenario_53_escape.lua:1356
msgctxt "ammo-comms"
msgid "Do you have spare homing missiles for us?"
msgstr "¿Tiene misiles de homenaje por nosotros?"

#: scripts/scenario_53_escape.lua:1357
msgctxt "ammo-comms"
msgid "Do you have extra homing missiles?"
msgstr "¿Tienes misiles de homenaje extra?"

#: scripts/scenario_53_escape.lua:1358
msgctxt "ammo-comms"
msgid "Please replenish our homing missiles."
msgstr "Por favor reponer nuestros misiles homing."

#: scripts/scenario_53_escape.lua:1361
msgctxt "ammo-comms"
msgid "We could use some mines."
msgstr "Podríamos usar algunas minas."

#: scripts/scenario_53_escape.lua:1362
msgctxt "ammo-comms"
msgid "How about mines?"
msgstr "¿Qué hay de las minas?"

#: scripts/scenario_53_escape.lua:1363
msgctxt "ammo-comms"
msgid "Got mines for us?"
msgstr "¿Tienes minas para nosotros?"

#: scripts/scenario_53_escape.lua:1366
msgctxt "ammo-comms"
msgid "What about HVLI?"
msgstr "¿Qué hay de HVLI?"

#: scripts/scenario_53_escape.lua:1367
msgctxt "ammo-comms"
msgid "Could you provide HVLI?"
msgstr "¿Podrías proporcionar HVLI?"

#: scripts/scenario_53_escape.lua:1368
msgctxt "ammo-comms"
msgid "We need High Velocity Lead Impactors."
msgstr "Necesitamos impactos de plomo de alta velocidad."

#: scripts/scenario_53_escape.lua:1373
#, lua-format
msgctxt "ammo-comms"
msgid "%s (%d rep each)"
msgstr "%s (G)%d rep cada uno)"

#: scripts/scenario_53_escape.lua:1379 scripts/scenario_53_escape.lua:1399 scripts/scenario_53_escape.lua:1401 scripts/scenario_53_escape.lua:1403 scripts/scenario_53_escape.lua:1405 scripts/scenario_53_escape.lua:1420 scripts/scenario_53_escape.lua:1422 scripts/scenario_53_escape.lua:1424 scripts/scenario_53_escape.lua:1466 scripts/scenario_53_escape.lua:1478 scripts/scenario_53_escape.lua:1481 scripts/scenario_53_escape.lua:1483 scripts/scenario_53_escape.lua:1525 scripts/scenario_53_escape.lua:1537 scripts/scenario_53_escape.lua:1540 scripts/scenario_53_escape.lua:1542 scripts/scenario_53_escape.lua:1557 scripts/scenario_53_escape.lua:1559 scripts/scenario_53_escape.lua:1561 scripts/scenario_53_escape.lua:1637 scripts/scenario_53_escape.lua:1639 scripts/scenario_53_escape.lua:1643 scripts/scenario_53_escape.lua:1645 scripts/scenario_53_escape.lua:1647 scripts/scenario_53_escape.lua:1683 scripts/scenario_53_escape.lua:1685 scripts/scenario_53_escape.lua:1713 scripts/scenario_53_escape.lua:1715 scripts/scenario_53_escape.lua:1717 scripts/scenario_53_escape.lua:1719 scripts/scenario_53_escape.lua:1742 scripts/scenario_53_escape.lua:1747 scripts/scenario_53_escape.lua:1750 scripts/scenario_53_escape.lua:1759 scripts/scenario_53_escape.lua:1764 scripts/scenario_53_escape.lua:1772 scripts/scenario_53_escape.lua:1836 scripts/scenario_53_escape.lua:1849 scripts/scenario_53_escape.lua:1873 scripts/scenario_53_escape.lua:1896 scripts/scenario_53_escape.lua:1919 scripts/scenario_53_escape.lua:1923 scripts/scenario_53_escape.lua:1940 scripts/scenario_53_escape.lua:1944 scripts/scenario_53_escape.lua:1949 scripts/scenario_53_escape.lua:2033 scripts/scenario_53_escape.lua:2064 scripts/scenario_53_escape.lua:2099 scripts/scenario_53_escape.lua:2179 scripts/scenario_53_escape.lua:2197 scripts/scenario_53_escape.lua:2242 scripts/scenario_53_escape.lua:2251 scripts/scenario_53_escape.lua:2258 scripts/scenario_53_escape.lua:2263 scripts/scenario_53_escape.lua:2288 scripts/scenario_53_escape.lua:2292 scripts/scenario_53_escape.lua:2309 scripts/scenario_53_escape.lua:2313 scripts/scenario_53_escape.lua:2462 scripts/scenario_53_escape.lua:2466 scripts/scenario_53_escape.lua:2482 scripts/scenario_53_escape.lua:2510 scripts/scenario_53_escape.lua:2519 scripts/scenario_53_escape.lua:2526 scripts/scenario_53_escape.lua:2535 scripts/scenario_53_escape.lua:2560 scripts/scenario_53_escape.lua:2567 scripts/scenario_53_escape.lua:2639 scripts/scenario_53_escape.lua:2658 scripts/scenario_53_escape.lua:2662 scripts/scenario_53_escape.lua:2678 scripts/scenario_53_escape.lua:2706 scripts/scenario_53_escape.lua:2721 scripts/scenario_53_escape.lua:2740 scripts/scenario_53_escape.lua:2744 scripts/scenario_53_escape.lua:2773 scripts/scenario_53_escape.lua:2805
msgid "Back"
msgstr "Volver"

#: scripts/scenario_53_escape.lua:1385
msgctxt "crewFriends-comms"
msgid "Talk to Kent's brother"
msgstr "Habla con el hermano de Kent"

#: scripts/scenario_53_escape.lua:1386
msgctxt "crewFriends-comms"
msgid "Kent? You made it out of the Kraylor base? We thought you were going to spend the rest of your life there. Thank you, captain, for helping Kent get out of there."
msgstr "Kent, ¿lo sacaste de la base Kraylor? Pensamos que ibas a pasar el resto de tu vida allí. Gracias, capitán, por ayudar a Kent a salir de allí."

#: scripts/scenario_53_escape.lua:1387
msgctxt "crewFriends-comms"
msgid "Can you help us with beam weapon repair?"
msgstr "¿Puedes ayudarnos con la reparación de armas de haz?"

#: scripts/scenario_53_escape.lua:1388
msgctxt "crewFriends-comms"
msgid "For the Repulse class? Absolutely. I used to work on those all the time."
msgstr "Para la clase Repulse? Absolutamente. Yo solía trabajar en eso todo el tiempo."

#: scripts/scenario_53_escape.lua:1393 scripts/scenario_53_escape.lua:1417 scripts/scenario_53_escape.lua:1634 scripts/scenario_53_escape.lua:1661 scripts/scenario_53_escape.lua:1691
msgctxt "crewFriends-comms"
msgid "Thanks"
msgstr "Gracias."

#: scripts/scenario_53_escape.lua:1394
msgctxt "crewFriends-comms"
msgid "You're quite welcome. While I was in there, I fixed up your beams so they could function at maximum potential."
msgstr "Eres bienvenido, mientras estaba allí, arreglé tus rayos para que pudieran funcionar al máximo potencial."

#: scripts/scenario_53_escape.lua:1396
msgctxt "crewFriends-comms"
msgid "Then double thanks!"
msgstr "¡Entonces doble gracias!"

#: scripts/scenario_53_escape.lua:1398
msgctxt "crewFriends-comms"
msgid "Thank *you* for getting my brother out of that Kraylor prison."
msgstr "Gracias por sacar a mi hermano de la prisión de Kraylor."

#: scripts/scenario_53_escape.lua:1411
msgctxt "crewFriends-comms"
msgid "Talk to Edwina's father"
msgstr "Habla con el padre de Edwina"

#: scripts/scenario_53_escape.lua:1412
msgctxt "crewFriends-comms"
msgid "I am glad to hear that Edwina escaped that prison. We were worried about her."
msgstr "Me alegra oír que Edwina escapó de esa prisión."

#: scripts/scenario_53_escape.lua:1413
msgctxt "crewFriends-comms"
msgid "Edwina says you do missile systems repair work"
msgstr "Edwina dice que hace sistemas de misiles reparar trabajo"

#: scripts/scenario_53_escape.lua:1414
msgctxt "crewFriends-comms"
msgid "Should be easy enough. I'm grateful to you for helping Edwina escape."
msgstr "Debería ser lo suficientemente fácil. Te agradezco por ayudar a Edwina a escapar."

#: scripts/scenario_53_escape.lua:1418
msgctxt "crewFriends-comms"
msgid "You're quite welcome."
msgstr "De nada."

#: scripts/scenario_53_escape.lua:1430
msgctxt "crewFriends-comms"
msgid "Talk to Johnny"
msgstr "Habla con Johnny"

#: scripts/scenario_53_escape.lua:1431
msgctxt "crewFriends-comms"
msgid "Mom? Wow, I thought you were toast. Good to hear your voice."
msgstr "Mamá, pensé que eras tostada, bueno para escuchar tu voz."

#: scripts/scenario_53_escape.lua:1432
msgctxt "crewFriends-comms"
msgid "Can you get our impulse drive working better?"
msgstr "¿Puedes conseguir que nuestro impulso funcione mejor?"

#: scripts/scenario_53_escape.lua:1458
#, lua-format
msgctxt "crewFriends-comms"
msgid "Piece of cake. Thanks for the %s."
msgstr "Un poco de pastel. %s."

#: scripts/scenario_53_escape.lua:1463 scripts/scenario_53_escape.lua:1475
msgctxt "crewFriends-comms"
msgid "Thank you"
msgstr "Gracias."

#: scripts/scenario_53_escape.lua:1464 scripts/scenario_53_escape.lua:1476
msgctxt "crewFriends-comms"
msgid "Sure, Mom. I'll see you at Christmas."
msgstr "Claro, mamá, te veré en Navidad."

#: scripts/scenario_53_escape.lua:1469
#, lua-format
msgctxt "crewFriends-comms"
msgid "Piece of cake, but I'll need %s."
msgstr "Pastel de pastel, pero necesito %s."

#: scripts/scenario_53_escape.lua:1472
msgctxt "crewFriends-comms"
msgid "Piece of cake."
msgstr "Un trozo de pastel."

#: scripts/scenario_53_escape.lua:1489
msgctxt "crewFriends-comms"
msgid "Talk to Nancy's brother"
msgstr "Habla con el hermano de Nancy"

#: scripts/scenario_53_escape.lua:1490
msgctxt "crewFriends-comms"
msgid "Nancy! Last I heard, your ship had been captured by Kraylors and you were imprisoned. Good to know you won't be stuck there forever. What brings you here?"
msgstr "Nancy, la última vez que escuché, tu nave había sido capturada por Kraylors y estabas encarcelada."

#: scripts/scenario_53_escape.lua:1491
msgctxt "crewFriends-comms"
msgid "Our jump drive needs some tuning"
msgstr "Nuestra unidad de salto necesita un poco de sintonización"

#: scripts/scenario_53_escape.lua:1517
#, lua-format
msgctxt "crewFriends-comms"
msgid "That should not be hard to do. I could probably do that in my sleep. Thanks for bringing %s."
msgstr "Eso no debería ser difícil de hacer. Probablemente podría hacerlo en mi sueño. %s."

#: scripts/scenario_53_escape.lua:1522 scripts/scenario_53_escape.lua:1534
msgctxt "crewFriends-comms"
msgid "Thanks, bro"
msgstr "Gracias, hermano"

#: scripts/scenario_53_escape.lua:1523 scripts/scenario_53_escape.lua:1535
msgctxt "crewFriends-comms"
msgid "No problem. Treat your jump drive right and it'll always bring you home."
msgstr "No hay problema. Trate su salto de la derecha y siempre te traerá a casa."

#: scripts/scenario_53_escape.lua:1528
#, lua-format
msgctxt "crewFriends-comms"
msgid "That should not be hard to do. I could probably do that in my sleep. But I'll need some %s."
msgstr "Eso no debería ser difícil de hacer, probablemente podría hacerlo mientras duermo, pero necesitaré algo. %s."

#: scripts/scenario_53_escape.lua:1531
msgctxt "crewFriends-comms"
msgid "That should not be hard to do. I could probably do that in my sleep."
msgstr "Eso no debería ser difícil de hacer, probablemente podría hacerlo mientras dormía."

#: scripts/scenario_53_escape.lua:1548
msgctxt "crewFriends-comms"
msgid "Talk to Manuel's cousin"
msgstr "Habla con el primo de Manuel"

#: scripts/scenario_53_escape.lua:1549
msgctxt "crewFriends-comms"
msgid "Yo Manuel, why you want to scare us by getting captured, man? At least you escaped. Why you here?"
msgstr "Yo Manuel, ¿por qué quieres asustarnos al ser capturados?"

#: scripts/scenario_53_escape.lua:1550
msgctxt "crewFriends-comms"
msgid "The reactor is weak... real weak"
msgstr "El reactor es débil... muy débil."

#: scripts/scenario_53_escape.lua:1551
msgctxt "crewFriends-comms"
msgid "Lemme see if I can get it to charge up right."
msgstr "Déjame ver si puedo conseguir que se cobre bien."

#: scripts/scenario_53_escape.lua:1554
msgctxt "crewFriends-comms"
msgid "The captain would appreciate it"
msgstr "El capitán lo apreciaría."

#: scripts/scenario_53_escape.lua:1555
msgctxt "crewFriends-comms"
msgid "You're all set. Don't overheat the reactor or you'll get a nasty surprise."
msgstr "No recaliente el reactor o tendrá una desagradable sorpresa."

#: scripts/scenario_53_escape.lua:1567
msgctxt "crewFriends-comms"
msgid "Talk to Fred's wife"
msgstr "Habla con la esposa de Fred"

#: scripts/scenario_53_escape.lua:1568
msgctxt "crewFriends-comms"
msgid "Fred! You escaped! We were worried sick."
msgstr "Fred, escapaste, nos preocupamos."

#: scripts/scenario_53_escape.lua:1569
msgctxt "crewFriends-comms"
msgid "We need to connect to the Human Navy network"
msgstr "Tenemos que conectarnos a la red de la Armada Humana"

#: scripts/scenario_53_escape.lua:1570
msgctxt "crewFriends-comms"
msgid "I can do that for you. However, that means you'll go from being Independent to being in the Human Navy."
msgstr "Puedo hacerlo por ti, pero eso significa que irás de ser independiente a estar en la Armada Humana."

#: scripts/scenario_53_escape.lua:1571
msgctxt "crewFriends-comms"
msgid "I understand the consequences. Please proceed"
msgstr "Entiendo las consecuencias."

#: scripts/scenario_53_escape.lua:1633
msgctxt "crewFriends-comms"
msgid "You're all fixed up."
msgstr "Estás arreglado."

#: scripts/scenario_53_escape.lua:1635
msgctxt "crewFriends-comms"
msgid "You're welcome. Fred, honey, I'll see you after you get off work."
msgstr "Fred, cariño, te veré después de salir del trabajo."

#: scripts/scenario_53_escape.lua:1641
msgctxt "crewFriends-comms"
msgid "I'll check with the captain and get back to you"
msgstr "Voy a comprobar con el capitán y volver con usted"

#: scripts/scenario_53_escape.lua:1642
msgctxt "crewFriends-comms"
msgid "Ok."
msgstr "Vale."

#: scripts/scenario_53_escape.lua:1653 scripts/scenario_53_escape.lua:1722
msgctxt "crewFriends-comms"
msgid "Talk to Amir's sister"
msgstr "Habla con la hermana de Amir"

#: scripts/scenario_53_escape.lua:1654
#, lua-format
msgctxt "crewFriends-comms"
msgid "Welcome to %s! Any friend of Amir's is a friend of mine."
msgstr "Bienvenido a %sCualquier amigo de Amir es amigo mío."

#: scripts/scenario_53_escape.lua:1655
msgctxt "crewFriends-comms"
msgid "Can you help us with our shields?"
msgstr "¿Puedes ayudarnos con nuestros escudos?"

#: scripts/scenario_53_escape.lua:1656
msgctxt "crewFriends-comms"
msgid "Yes, I can. However, I can only help with one: front or rear. I need more parts to do both."
msgstr "Sí, puedo. Sin embargo, sólo puedo ayudar con uno: delante o trasero. Necesito más partes para hacer ambos."

#: scripts/scenario_53_escape.lua:1657
msgctxt "crewFriends-comms"
msgid "Repair front shield"
msgstr "Reparar el escudo delantero"

#: scripts/scenario_53_escape.lua:1658
msgctxt "crewFriends-comms"
msgid "Your front shields are now fully operational. Your repair crew can finish the rest."
msgstr "Tus escudos delanteros están ahora completamente operativos, tu equipo de reparación puede terminar el resto."

#: scripts/scenario_53_escape.lua:1681
#, lua-format
msgctxt "crewFriends-comms"
msgid "Certainly. Bring back %s to get the rear shield fixed. You might find some at %s."
msgstr "Por supuesto. %s para arreglar el escudo trasero. %s."

#: scripts/scenario_53_escape.lua:1687
msgctxt "crewFriends-comms"
msgid "Repair rear shield"
msgstr "Reparar el escudo trasero"

#: scripts/scenario_53_escape.lua:1688
msgctxt "crewFriends-comms"
msgid "Your rear shields are now fully operational. Your repair crew can finish the rest."
msgstr "Sus escudos traseros están ahora completamente operativos, su equipo de reparación puede terminar el resto."

#: scripts/scenario_53_escape.lua:1711
#, lua-format
msgctxt "crewFriends-comms"
msgid "Certainly. Bring back %s to get the front shield fixed. You might find some at %s."
msgstr "Por supuesto. %s para arreglar el escudo delantero. %s."

#: scripts/scenario_53_escape.lua:1723
#, lua-format
msgctxt "crewFriends-comms"
msgid "Welcome back. Did you bring some %s for me to finish fixing up your shields?"
msgstr "Bienvenida de vuelta. ¿Trajiste algo? %s ¿Para que termine de arreglar tus escudos?"

#: scripts/scenario_53_escape.lua:1729
#, lua-format
msgctxt "crewFriends-comms"
msgid "Yes, please take the %s and fix the shields"
msgstr "Sí, por favor, toma el %s y fijar los escudos"

#: scripts/scenario_53_escape.lua:1735
msgctxt "crewFriends-comms"
msgid "Front shield fully functional."
msgstr "Escudo frontal totalmente funcional."

#: scripts/scenario_53_escape.lua:1739
msgctxt "crewFriends-comms"
msgid "Rear shield fully functional."
msgstr "Escudo trasero totalmente funcional."

#: scripts/scenario_53_escape.lua:1745
#, lua-format
msgctxt "crewFriends-comms"
msgid "Oops, no %s aboard"
msgstr "Oops, no %s a bordo"

#: scripts/scenario_53_escape.lua:1746
msgctxt "crewFriends-comms"
msgid "Ok, good luck."
msgstr "Buena suerte."

#: scripts/scenario_53_escape.lua:1755 scripts/scenario_53_escape.lua:2254
msgctxt "station-comms"
msgid "Tell me more about your station"
msgstr "Cuéntame más sobre tu estación."

#: scripts/scenario_53_escape.lua:1756 scripts/scenario_53_escape.lua:2255
msgctxt "station-comms"
msgid "What would you like to know?"
msgstr "¿Qué quieres saber?"

#: scripts/scenario_53_escape.lua:1757 scripts/scenario_53_escape.lua:2256
msgctxt "stationGeneralInfo-comms"
msgid "General information"
msgstr "Información general"

#: scripts/scenario_53_escape.lua:1762 scripts/scenario_53_escape.lua:2261
msgctxt "stationStory-comms"
msgid "Station history"
msgstr "Historia de la estación"

#: scripts/scenario_53_escape.lua:1770
msgctxt "gossip-comms"
msgid "Gossip"
msgstr "Gossip"

