#: scripts/scenario_59_border.lua:5311
msgctxt "msgGM"
msgid ""
"Destroyer III(Simian):   Hull:100   Shield:110,70   Size:200   Repair Crew:3   Cargo:7   R.Strength:25\n"
"Default advanced engine:Jump (2U - 20U)   Speeds: Impulse:60   Spin:8   Accelerate:15   C.Maneuver: Boost:450 Strafe:150\n"
"Beam:1 Turreted Speed:0.2\n"
"   Arc:270   Direction:0   Range:0.8   Cycle:5   Damage:6\n"
"Tubes:5   Load Speed:8   Front:2   Side:2   Back:1\n"
"   Direction:  0   Type:Exclude Mine\n"
"   Direction:  0   Type:Exclude Mine\n"
"   Direction:-90   Type:Homing Only\n"
"   Direction: 90   Type:Homing Only\n"
