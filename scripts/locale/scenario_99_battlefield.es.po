msgid "Battlefield"
msgstr "Campo de batalla"

# Scenario description
msgid ""
"More than 60 Human Navy and Exuari ships face off in all-out war near a neutral station.\n"
"\n"
"(This scenario is designed for performance testing.)"
msgstr "Más de 60 buques de la Armada Humana y Exuari se enfrentan en guerra total cerca de una estación neutral. (Este escenario está diseñado para pruebas de rendimiento.)"

# Scenario setting
msgctxt "setting"
msgid "Enemies"
msgstr "Enemigos"

msgctxt "setting"
msgid "Configures the amount of enemies spawned in the scenario."
msgstr "Configura la cantidad de enemigos que se despertó en el escenario."

msgctxt "Enemies"
msgid "Large"
msgstr "Grande"

msgctxt "Enemies"
msgid "Larger battle. This increases the fleet sizes to 100 ships per side."
msgstr "Batalla más grande. Esto aumenta el tamaño de la flota a 100 barcos por lado."

msgctxt "Enemies"
msgid "Medium"
msgstr "Mediana"

msgctxt "Enemies"
msgid "Medium battle. 60 ships per side."
msgstr "Una batalla mediana. 60 naves por lado."

msgctxt "Enemies"
msgid "Huge"
msgstr "Enorme"

msgctxt "Enemies"
msgid "Huge battle. This increases the fleet sizes to 500 ships per side."
msgstr "Gran batalla. Esto aumenta el tamaño de la flota a 500 barcos por lado."
