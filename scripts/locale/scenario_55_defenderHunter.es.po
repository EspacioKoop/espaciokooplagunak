msgctxt "PaulOrders-comms"
msgid "Get Paul Straight at station %s"
msgstr "Pon a Paul Straight en la estación %s"

#: scripts/scenario_55_defenderHunter.lua:4712
#, lua-format
msgctxt "PaulOrders-shiplog"
msgid "[Paul Straight] I've been studying enemy station %s in %s: traffic patterns, communication traffic, energy signature, etc. I've built a specialized short range transporter that should be able to beam me onto the station through their shields. I need to get refined readings from 20 units or closer for final calibration. Please take me to within 20 units of %s"
msgstr "He estado estudiando la estación enemiga %s en el interior %s: patrones de tráfico, tráfico de comunicación, firma de energía, etc. He construido un transportador especializado de corta distancia que debe ser capaz de transportarme a la estación a través de sus escudos. Necesito conseguir lecturas refinadas de 20 unidades o más cerca para la calibración final. Por favor, llévame a dentro de 20 unidades de %s"

#: scripts/scenario_55_defenderHunter.lua:4713
#, lua-format
msgctxt "PaulOrders-comms"
msgid "Take Paul Straight to within 20U of %s in %s"
msgstr "Lleve a Paul Straight a 20U de %s en el interior %s"

#: scripts/scenario_55_defenderHunter.lua:4727
msgctxt "Paul-shiplog"
msgid "[Paul Straight] I've got my readings. Let me calibrate the transporter"
msgstr "Tengo mis lecturas, déjame calibrar el transportador"

#: scripts/scenario_55_defenderHunter.lua:4730
msgctxt "Paul-msgHelms"
msgid "[Paul Straight] The ship is in range. I completed my scans. Thank you"
msgstr "La nave está en rango. He completado mis escaneos. Gracias"

#: scripts/scenario_55_defenderHunter.lua:4734
msgctxt "Paul-msgTactical"
msgid "[Paul Straight] The ship is in range. I completed my scans. Thank you"
msgstr "La nave está en rango. He completado mis escaneos. Gracias"

#: scripts/scenario_55_defenderHunter.lua:4744 scripts/scenario_55_defenderHunter.lua:4769 scripts/scenario_55_defenderHunter.lua:4802
msgctxt "Paul-shiplog"
msgid "[Paul Straight] It's too bad the station was destroyed"
msgstr "[Paul Straight] Es muy malo que la estación fuera destruida"

#: scripts/scenario_55_defenderHunter.lua:4759
#, lua-format
msgctxt "PaulOrders-shiplog"
msgid "[Paul Straight] My transporter is ready. I've disguised myself as a Kraylor technician. I need you to take the ship within 2.5U of %s. You don't need to defeat any patrols, but there might be some enemy interest in your ship flying so close to the station. After I am aboard %s, I will gether intelligence and transmit it back. I'm ready to proceed"
msgstr "Mi transportador está listo. Me he disfrazado como técnico de Kraylor. %sNo necesitas derrotar a ninguna patrulla, pero podría haber algún interés enemigo en tu nave volando tan cerca de la estación. %sVoy a conseguir su inteligencia y la transmitiré de nuevo."

#: scripts/scenario_55_defenderHunter.lua:4760
#, lua-format
msgctxt "PaulOrders-comms"
msgid "Get ship within 2.5U of %s in %s to secretly transport Paul Straight"
msgstr "Obtener el barco dentro de 2.5U de %s en el interior %s para transportar secretamente a Paul Straight"

#: scripts/scenario_55_defenderHunter.lua:4786
#, lua-format
msgctxt "Paul-msgScience"
