# Scenario setting
msgctxt "setting"
msgid "Reputation"
msgstr "Reputación"

msgctxt "setting"
msgid "Starting reputation per player ship. The more initial reputation, the easier the scenario. Default: Hero = 400 reputation"
msgstr "La reputación inicial por barco de jugador. Cuanto más reputación inicial, más fácil es el escenario. Default: Hero = 400 reputación"

msgctxt "Reputation"
msgid "Unknown"
msgstr "Desconocida"

msgctxt "Reputation"
msgid "Nobody knows you. Zero reputation"
msgstr "Nadie te conoce."

msgctxt "Reputation"
msgid "Nice"
msgstr "Bonito"

msgctxt "Reputation"
msgid "200 reputation - you've helped a few people"
msgstr "200 reputación - usted ha ayudado a algunas personas"

msgctxt "Reputation"
msgid "Hero"
msgstr "Hero"

msgctxt "Reputation"
msgid "400 reputation - you've helped important people or lots of people"
msgstr "400 reputación - usted ha ayudado a personas importantes o mucha gente"

msgctxt "Reputation"
msgid "Major Hero\""
msgstr "Mayor Hero"

msgctxt "Reputation"
msgid "700 reputation - you're well known by nearly everyone as a force for good"
msgstr "700 reputación - usted es bien conocido por casi todos como una fuerza para el bien"

msgctxt "Reputation"
msgid "Super Hero\""
msgstr "Super Hero"

msgctxt "Reputation"
msgid "1000 reputation - everyone knows you and relies on you for help"
msgstr "1000 reputación - todo el mundo te conoce y depende de ti para ayudar"

# Scenario setting
msgctxt "setting"
msgid "Unique Ship"
msgstr "Unique Ship"

msgctxt "setting"
msgid "Choose player ship outside of standard player ship list"
msgstr "Elija el barco de jugador fuera de la lista de buques de jugador estándar"

msgctxt "Unique Ship"
msgid "None"
msgstr "Ninguno"

msgctxt "Unique Ship"
msgid "None: just use standard player ship list on spawn screen"
msgstr "Ninguno: sólo use la lista estándar del jugador en la pantalla desgastada"

msgctxt "Unique Ship"
msgid "Spinstar"
msgstr "Spinstar"

msgctxt "Unique Ship"
msgid "Based on Atlantis, has spinal beam: narrow, long range, rapid firing, 5 second duration, 30 second recharge, fewer tubes, weaker shields and hull, warp, faster maneuver"
msgstr "Basado en Atlantis, tiene viga espinal: estrecha, larga gama, disparo rápido, 5 segunda duración, 30 segundos recarga, menos tubos, escudos más débiles y casco, warp, maniobra más rápida"

msgctxt "Unique Ship"
msgid "Narsil"
msgstr "Narsil"

msgctxt "Unique Ship"
msgid "Based on Atlantis, slower impulse, faster maneuver, warp, weaker hull and shields, add forward HVLI tube and side beam turrets"
msgstr "Basado en Atlantis, impulso más lento, maniobra más rápida, warp, casco más débil y escudos, añadir hacia adelante tubo HVLI y torretas de haz lateral"

msgctxt "Unique Ship"
msgid "Blazon"
msgstr "Blazon"

msgctxt "Unique Ship"
msgid "Based on Striker, faster impulse and maneuver, stronger shields, narrower beams, add beam, add missiles"
msgstr "Basado en Striker, impulso más rápido y maniobra, escudos más fuertes, rayos más estrechos, añadir haz, añadir misiles"

msgctxt "Unique Ship"
msgid "Headhunter"
msgstr "Headhunter"

msgctxt "Unique Ship"
msgid "Based on Piranha, shorter jump, stronger hull and shields, add beam, one fewer mining tube, fewer mines and nukes, more EMPs"
msgstr "Basado en Piranha, salto más corto, casco más fuerte y escudos, añadir haz, un tubo menos minero, menos minas y nukes, más EMPs"

msgctxt "Unique Ship"
msgid "Simian"
msgstr "Simian"

msgctxt "Unique Ship"
msgid "Based on missile cruiser, 20k jump, add beam, weaker hull, fewer tubes and missiles"
msgstr "Basado en el crucero de misiles, salto de 20k, añadir haz, casco más débil, menos tubos y misiles"

msgctxt "Unique Ship"
msgid "Spyder"
msgstr "Spyder"

msgctxt "Unique Ship"
msgid "Based on Atlantis, slower impulse, extra tube, angled tubes"
msgstr "Basado en Atlantis, impulso más lento, tubo extra, tubos angulos"

msgctxt "Unique Ship"
msgid "Sting"
msgstr "Sting"

msgctxt "Unique Ship"
msgid "Based on Hathcock, faster impulse, warp, add mining tube, no nukes or EMPs"
msgstr "Basado en Hathcock, impulso más rápido, urdimbre, añadir tubo minero, no nukes o EMPs"

