#: scripts/scenario_59_border.lua:6821
msgctxt "upgrade-comms"
msgid "Increase spin speed"
msgstr "Aumentar la velocidad de la columna"

#: scripts/scenario_59_border.lua:6840
#, lua-format
msgctxt "upgrade-comms"
msgid "Ship spin speed increased by %i%% after you gave %s to %s"
msgstr "Velocidad de giro de la nave aumentada %i%% después de que te dieras %s a %s"

#: scripts/scenario_59_border.lua:6842
#, lua-format
msgctxt "upgrade-comms"
msgid "%s requires %s for the spin upgrade"
msgstr "%s Requisitos %s para la actualización de la columna"

#: scripts/scenario_59_border.lua:6847
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: I increased the speed your ship spins by 50%%. Normally, I'd require %s, but seeing as you're going out to take on the Kraylors, we worked it out"
msgstr "%s: Aumenté la velocidad que su barco gira en 50%%Normalmente, necesitaría %s, pero viendo como vas a tomar en los Kraylors, lo arreglamos"

#: scripts/scenario_59_border.lua:6855
msgctxt "upgrade-comms"
msgid "Add missle tube"
msgstr "Añadir tubo de Missle"

#: scripts/scenario_59_border.lua:6885
#, lua-format
msgctxt "upgrade-comms"
msgid "%s thanks you for the %s and the luxury and installs a homing missile tube for you"
msgstr "%s gracias por el %s y el lujo e instala un tubo de misiles homing para usted"

#: scripts/scenario_59_border.lua:6887
#, lua-format
msgctxt "upgrade-comms"
msgid "%s requires %s and luxury for the missile tube"
msgstr "%s Requisitos %s y lujo para el tubo de misiles"

#: scripts/scenario_59_border.lua:6897
#, lua-format
msgctxt "upgrade-comms"
msgid "%s installs a homing missile tube for you. The %s required was requisitioned from wartime contingency supplies"
msgstr "%s instala un tubo de misiles homing para usted. %s se requisó de los suministros para imprevistos en tiempo de guerra"

#: scripts/scenario_59_border.lua:6905
msgctxt "upgrade-comms"
msgid "Reduce beam heat"
msgstr "Reducir el haz de calor"

#: scripts/scenario_59_border.lua:6929
#, lua-format
msgctxt "upgrade-comms"
msgid "Beam heat generation reduced by %i%%"
msgstr "Generación de calor de haz reducido %i%%"

#: scripts/scenario_59_border.lua:6931
#, lua-format
msgctxt "upgrade-comms"
msgid "%s says she needs %s before she can cool your beams"
msgstr "%s dice que necesita %s antes de que pueda enfriar tus vigas"

#: scripts/scenario_59_border.lua:6940
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: Beam heat generation reduced by 50%%, no %s necessary. Go shoot some Kraylors for me"
msgstr "%s: Generación de calor de haz reducido en 50%%No. %s ¡Vamos a dispararle a Kraylors por mí!"

#: scripts/scenario_59_border.lua:6951
msgctxt "upgrade-comms"
msgid "Extend beam range"
msgstr "Amplia gama de vigas"

#: scripts/scenario_59_border.lua:6989
#, lua-format
msgctxt "upgrade-comms"
msgid "%s extended your beam range by %i%% and says thanks for the %s"
msgstr "%s extendió su rango de vigas por %i%% y dice gracias por el %s"

#: scripts/scenario_59_border.lua:7007
#, lua-format
msgctxt "upgrade-comms"
msgid "%s increased your beam range by 25%% without the usual %s from your ship"
msgstr "%s aumentar su rango de vigas en 25%% sin lo habitual %s de su nave"

#: scripts/scenario_59_border.lua:7018
msgctxt "upgrade-comms"
msgid "Increase beam damage"
msgstr "Aumentar el daño de la viga"

#: scripts/scenario_59_border.lua:7047
#, lua-format
msgctxt "upgrade-comms"
msgid "%s increased your beam damage by %i%% and stores away the %s"
msgstr "%s aumentó el daño de la viga %i%% y almacena lejos el %s"

#: scripts/scenario_59_border.lua:7063
#, lua-format
msgctxt "upgrade-comms"
msgid "%s increased your beam damage by 20%%, waiving the usual %s requirement"
msgstr "%s aumentó el daño de la viga en 20%%, renunciando a lo habitual %s requisito"

#: scripts/scenario_59_border.lua:7074
msgctxt "upgrade-comms"
msgid "Increase missile storage capacity"
msgstr "Aumento de la capacidad de almacenamiento de misiles"

#: scripts/scenario_59_border.lua:7097
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: You can now store at least %i%% more missiles. I appreciate the %s"
msgstr "%s: Ahora puedes almacenar por lo menos %i%% más misiles. Aprecio los misiles %s"

#: scripts/scenario_59_border.lua:7099
#, lua-format
msgctxt "upgrade-comms"
msgid "%s needs %s for the upgrade"
msgstr "%s necesidades %s para la actualización"

#: scripts/scenario_59_border.lua:7107
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: You can now store at least 25%% more missiles. I found some spare %s on the station. Go launch those missiles at those perfidious treaty-breaking Kraylors"
msgstr "%s: Ahora puedes almacenar al menos 25%% Encontré más misiles. %s en la estación, lanza esos misiles en esos Kraylors que rompen tratados"

#: scripts/scenario_59_border.lua:7110
msgctxt "upgrade-comms"
msgid "Your ship type does not support a missile storage capacity upgrade."
msgstr "Su tipo de nave no admite una mejora de la capacidad de almacenamiento de misiles."

#: scripts/scenario_59_border.lua:7118
msgctxt "upgrade-comms"
msgid "Speed up impulse engines"
msgstr "Acelerar los motores de impulso"

#: scripts/scenario_59_border.lua:7137
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: Your impulse engines now push you up to %i%% faster. Thanks for the %s"
msgstr "%s: Tus motores de impulso ahora te empujan hasta %i%% Gracias por el %s"

#: scripts/scenario_59_border.lua:7139
#, lua-format
msgctxt "upgrade-comms"
msgid "You need to bring %s to %s for the upgrade"
msgstr "Tienes que traer %s a %s para la actualización"

#: scripts/scenario_59_border.lua:7144
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: Your impulse engines now push you up to 25%% faster. I didn't need %s after all. Go run circles around those blinking Kraylors"
msgstr "%s: Tus motores de impulso ahora te empujan hasta 25%% No necesitaba más. %s y luego de todo, vamos a correr círculos alrededor de esos Kraylors parpadeantes"

#: scripts/scenario_59_border.lua:7152
msgctxt "upgrade-comms"
msgid "Strengthen hull"
msgstr "Fortalecer el casco"

#: scripts/scenario_59_border.lua:7172
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: Thank you for the %s. Your hull is %i%% stronger"
msgstr "%s: Gracias por el %sTu casco es %i%% más fuerte"

#: scripts/scenario_59_border.lua:7174
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: I need %s before I can increase your hull strength"
msgstr "%s- Necesito %s antes de que pueda aumentar su fuerza de casco"

#: scripts/scenario_59_border.lua:7180
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: I made your hull 50%% stronger. I scrounged some %s from around here since you are on the Kraylor offense team"
msgstr "%sHe hecho tu casco 50%% más fuerte. %s desde aquí desde que estás en el equipo de la ofensiva Kraylor"

#: scripts/scenario_59_border.lua:7188
msgctxt "upgrade-comms"
msgid "Increase battery efficiency"
msgstr "Aumentar la eficiencia de la batería"

