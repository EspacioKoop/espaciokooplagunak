#: scripts/scenario_53_escape.lua:3307
msgctxt "crewRepair-shipLog"
msgid "Repair crew suggested locations for ship fixes:"
msgstr "La tripulación de reparación sugirió ubicaciones para los arreglos de buques:"

#: scripts/scenario_53_escape.lua:3331
#, lua-format
msgctxt "crewFriends-shipLog"
msgid "[Kent (repair crew member)] My brother on %s in %s can fix our port side beam weapon"
msgstr "Mi hermano en adelante %s en el interior %s puede arreglar nuestro arma de haz lateral del puerto"

#: scripts/scenario_53_escape.lua:3364
#, lua-format
msgctxt "Boris-shipLog"
msgid "[Sensor tech] Looks like %s figured out where we went and has sicced %s on us."
msgstr "Parece que... %s descubrí a dónde fuimos y tenemos un sicced %s sobre nosotros."

#: scripts/scenario_53_escape.lua:3365
#, lua-format
msgctxt "Boris-shipLog"
msgid "[Engineering tech] With our hull at %i, we better hope our shields hold"
msgstr "Con nuestro casco %iEs mejor que esperemos que nuestros escudos se mantengan"

#: scripts/scenario_53_escape.lua:3378
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] You won't get away so easily."
msgstr "[%sNo te escaparás tan fácilmente."

#: scripts/scenario_53_escape.lua:3379
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] You can run, but you can't hide."
msgstr "[%sPuedes correr, pero no puedes esconderte."

#: scripts/scenario_53_escape.lua:3380
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I will get you yet."
msgstr "[%sTe atraparé todavía."

#: scripts/scenario_53_escape.lua:3381
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I will hunt you down and destroy you like vermin."
msgstr "[%sTe cazaré y te destruiré como el vermin."

#: scripts/scenario_53_escape.lua:3382
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] Slow down, I promise not to destroy you immediately."
msgstr "[%sDespacio, prometo no destruirte inmediatamente."

#: scripts/scenario_53_escape.lua:3397
msgctxt "Boris-incCall"
msgid "You don't steal from Boris Junk Yard without consequences. I'm coming for you."
msgstr "No robas a Boris Junk Yard sin consecuencias."

#: scripts/scenario_53_escape.lua:3398
msgctxt "Boris-incCall"
msgid "I saw you steal that ship. You'll rue the day."
msgstr "Te vi robar esa nave."

#: scripts/scenario_53_escape.lua:3399
msgctxt "Boris-incCall"
msgid "Stealing a ship, eh? We'll just see about that."
msgstr "Robando un barco, ¿eh?"

#: scripts/scenario_53_escape.lua:3400
msgctxt "Boris-incCall"
msgid "You must pay for the ship you stole from Boris Junk Yard... with your life."
msgstr "Debes pagar el barco que robaste de Boris Junk Yard... con tu vida."

#: scripts/scenario_53_escape.lua:3416
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] You can't get rid of me that easily."
msgstr "[%sNo puedes deshacerte de mí tan fácilmente."

#: scripts/scenario_53_escape.lua:3417
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I'll be back."
msgstr "[%sVolveré."

#: scripts/scenario_53_escape.lua:3418
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] I've got plenty of ships."
msgstr "[%sTengo muchas naves."

#: scripts/scenario_53_escape.lua:3419
#, lua-format
msgctxt "Boris-shipLog"
msgid "[%s] This is merely a temporary setback."
msgstr "[%sEsto es simplemente un revés temporal."

#: scripts/scenario_53_escape.lua:3438
msgctxt "crewRepair-shipLog"
msgid "Repair crew thinks they can use the space debris recently acquired to make repair parts for the jump drive. They are starting the fabrication process now."
msgstr "La tripulación de reparación cree que pueden utilizar los escombros espaciales adquiridos recientemente para hacer piezas de reparación para la unidad de salto. Están empezando el proceso de fabricación ahora."

#: scripts/scenario_53_escape.lua:3447
msgctxt "crewRepair-shipLog"
msgid "Repair crew finished jump drive part fabrication. They believe the jump drive should be functional soon."
msgstr "El equipo de reparación terminó la fabricación de la parte del salto del salto. Creen que la unidad de salto debe ser funcional pronto."

#: scripts/scenario_53_escape.lua:3459
msgctxt "victory-msgMainscreen"
msgid "Congratulations! You escaped the Kraylor clutches and returned all your gathered data on the Kraylor to the Human Navy."
msgstr "¡Felicitaciones! Te escapaste de las garras de Kraylor y devolviste todos tus datos reunidos en el Kraylor a la Armada Humana."

#: scripts/scenario_53_escape.lua:3796
msgctxt "ZoneLabelDescription-junk"
msgid "Boris Junk Yard"
msgstr "Boris Junk Yard"

# Scenario description
msgid "Escape imprisonment and return home.\nMission consists of one ship with a full crew. Engineer and Science will be busy.\n\nVersion 5\n\nUSN Discord: https://discord.gg/PntGG3a where you can join a game online. There's one every weekend. All experience levels are welcome."
msgstr "Escapa de tu cautiverio y vuelve a casa.\nLa misión consta de una sola nave con la tripulación completa. Ingeniería y Ciencia tendrán mucho trabajo.\n\nVersión 5\n\nDiscord de USN: https://discord.gg/PntGG3a, donde puedes unirte a una partida en línea. Hay una cada fin de semana. Todos los niveles de experiencia son bienvenidos."
