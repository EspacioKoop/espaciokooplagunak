#: scripts/scenario_74_omicron.lua:4631
msgctxt "trade-comms"
msgid " Beyond that, I have no knowledge of specific stations"
msgstr " Más allá de eso, no tengo conocimiento de estaciones específicas"

#: scripts/scenario_74_omicron.lua:4668
