#: scripts/scenario_33_early.lua:2797
#, lua-format
msgctxt "station-comms"
msgid "Destroy the Kraylor freighter you identified during your scanning task. Use HVLI. Your beams will take too long to cycle. Your evaluation has begun. Clock: %s"
msgstr "Destruya el carguero Kraylor que identificó durante su tarea de escaneado. Use HVLI. Sus vigas tardarán demasiado tiempo en ciclo. Su evaluación ha comenzado. %s"

#: scripts/scenario_33_early.lua:2800
#, lua-format
msgctxt "station-comms"
msgid "Congratulations on completing your task to destroy that Kraylor freighter, %s. Are you ready for your next task?"
