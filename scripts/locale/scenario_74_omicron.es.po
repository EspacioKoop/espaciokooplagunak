# Scenario setting
msgctxt "setting"
msgid "Unique Ship"
msgstr "Nave especial"

msgctxt "setting"
msgid "Choose player ship outside of standard player ship list"
msgstr "Elija el barco de jugador fuera de la lista de buques de jugador estándar"

msgctxt "Unique Ship"
msgid "None"
msgstr "Ninguno"

msgctxt "Unique Ship"
msgid "None: just use standard player ship list on spawn screen"
msgstr "Ninguno: sólo use la lista estándar del jugador en la pantalla desgastada"

msgctxt "Unique Ship"
msgid "Amalgam"
msgstr "Amalgam"

msgctxt "Unique Ship"
msgid "Based on Atlantis, 4 beams (vs 2), single broadside tube on each side for large homing missiles only, 2 mining tubes, weaker defenses and engines"
msgstr "Basado en Atlantis, 4 vigas (vs 2), tubo de lado ancho único en cada lado para misiles de gran homing, 2 tubos mineros, defensas y motores más débiles"

msgctxt "Unique Ship"
msgid "Midian"
msgstr "Midian"

msgctxt "Unique Ship"
msgid "Based on missile cruiser, reduced tubes, missiles and base warp speed to get beam weapons and HVLI"
msgstr "Basado en un crucero por misiles, tubos reducidos, misiles y velocidad de warp base para conseguir armas de haz y HVLI"

msgctxt "Unique Ship"
msgid "Raven"
msgstr "Raven"

msgctxt "Unique Ship"
msgid "Based on Cruiser, stronger shields, weaker hull, broadside beams, tweaked tubes and missiles, low powered warp drive, tweaked sensor ranges"
msgstr "Basado en Cruiser, escudos más fuertes, casco más débil, rayos de ancho, tubos y misiles recubiertos, unidad de baja potencia, rangos de sensores recubiertos"

msgctxt "Unique Ship"
msgid "Squid"
msgstr "Squid"

msgctxt "Unique Ship"
msgid "Based on Piranha, stronger defenses, added a beam weapon, reduced missile load, large homing missiles, reconfigured tubes, shorter jump and sensor ranges"
msgstr "Basado en Piranha, defensas más fuertes, agregó un arma de haz, carga de misiles reducidas, misiles de gran tamaño, tubos reconfigurados, rangos de salto más cortos y sensores"

