49_allies.lua:4877 scripts/scenario_49_allies.lua:4903 scripts/scenario_49_allies.lua:4933 scripts/scenario_49_allies.lua:4958 scripts/scenario_49_allies.lua:4988 scripts/scenario_49_allies.lua:5054 scripts/scenario_49_allies.lua:5065 scripts/scenario_49_allies.lua:5092 scripts/scenario_49_allies.lua:5099 scripts/scenario_49_allies.lua:5121 scripts/scenario_49_allies.lua:5137 scripts/scenario_49_allies.lua:5162 scripts/scenario_49_allies.lua:5187 scripts/scenario_49_allies.lua:5218
msgid "Back"
msgstr "Volver"

#: scripts/scenario_49_allies.lua:3676 scripts/scenario_49_allies.lua:4575
msgctxt "stationStory-comms"
msgid "Station history"
msgstr "Historia de la estación"

#: scripts/scenario_49_allies.lua:3684 scripts/scenario_49_allies.lua:4583
msgctxt "gossip-comms"
msgid "Gossip"
msgstr "Gossip"

#: scripts/scenario_49_allies.lua:3695 scripts/scenario_49_allies.lua:4429
msgctxt "doomsday-comms"
msgid "Tell me about Gregory Unruh"
msgstr "Cuéntame sobre Gregory Unruh"

#: scripts/scenario_49_allies.lua:3696
msgctxt "doomsday-comms"
msgid "He's a retired scientist here. He's on C deck if you'd like to visit"
msgstr "Es un científico jubilado aquí, está en cubierta C si quieres visitar"

#: scripts/scenario_49_allies.lua:3697
msgctxt "doomsday-comms"
msgid "Visit Gregory Unruh on C deck"
msgstr "Visite Gregory Unruh en la cubierta C"

#: scripts/scenario_49_allies.lua:3698
msgctxt "doomsday-comms"
msgid "[Gregory Unruh] What can I do for you?"
msgstr "¿Qué puedo hacer por ti?"

#: scripts/scenario_49_allies.lua:3699
msgctxt "doomsday-comms"
msgid "We need your plans for a doomsday device defense mechanism"
msgstr "Necesitamos sus planes para un mecanismo de defensa del dispositivo del fin de semana"

#: scripts/scenario_49_allies.lua:3700
msgctxt "doomsday-comms"
msgid "Ah, I see someone is taking my research seriously. Here is my incomplete prototype along with the plans. You'll notice that certain components are still required."
msgstr "Veo que alguien está tomando mi investigación en serio. Aquí está mi prototipo incompleto junto con los planes."

#: scripts/scenario_49_allies.lua:3710 scripts/scenario_49_allies.lua:4439
msgctxt "doctor-comms"
msgid "Tell me about Morrigan Thultris"
msgstr "Cuéntame sobre Morrigan Thultris"

#: scripts/scenario_49_allies.lua:3711
msgctxt "doctor-comms"
msgid "She does medical research here"
msgstr "Ella hace investigación médica aquí."

#: scripts/scenario_49_allies.lua:3712
msgctxt "doctor-comms"
msgid "May I speak with her?"
msgstr "¿Puedo hablar con ella?"

#: scripts/scenario_49_allies.lua:3713
msgctxt "doctor-comms"
msgid "She won't come to the communications nexus, but you may visit her in her quarters"
msgstr "No vendrá al nexo de comunicaciones, pero puede visitarla en sus habitaciones."

#: scripts/scenario_49_allies.lua:3714
msgctxt "doctor-comms"
msgid "Visit Dr. Thultris"
msgstr "Visita al Dr. Thultris"

#: scripts/scenario_49_allies.lua:3715
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris behind closed quarters door]\n"
"Who is it?"
msgstr "¿Quién es?"

#: scripts/scenario_49_allies.lua:3716
#, lua-format
msgctxt "doctor-comms"
msgid "I am an officer from the Human Navy ship, %s"
msgstr "Soy un oficial de la Armada Humana, %s"

#: scripts/scenario_49_allies.lua:3717
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris behind closed quarters door]\n"
"What do you want?"
msgstr "¿Qué quieres?"

#: scripts/scenario_49_allies.lua:3718
msgctxt "doctor-comms"
msgid "We need your help"
msgstr "Necesitamos tu ayuda."

#: scripts/scenario_49_allies.lua:3720
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris opens her door]\n"
"With what?"
msgstr "¿Con qué?"

#: scripts/scenario_49_allies.lua:3721 scripts/scenario_49_allies.lua:3797 scripts/scenario_49_allies.lua:3839 scripts/scenario_49_allies.lua:3877 scripts/scenario_49_allies.lua:3915
msgctxt "doctor-comms"
msgid "Grab Dr. Thultris"
msgstr "Coge al Dr. Thultris"

#: scripts/scenario_49_allies.lua:3723 scripts/scenario_49_allies.lua:3761 scripts/scenario_49_allies.lua:3799 scripts/scenario_49_allies.lua:3841 scripts/scenario_49_allies.lua:3879 scripts/scenario_49_allies.lua:3917
msgctxt "doctor-comms"
msgid "As you pull her down the corridor back to the ship, explaining why you've come for her, she protests initially then eventually runs back with you, convinced of the urgency of the situation"
msgstr "Cuando la llevas por el pasillo de vuelta a la nave, explicando por qué has venido por ella, ella protesta inicialmente y eventualmente vuelve contigo, convencida de la urgencia de la situación"

#: scripts/scenario_49_allies.lua:3727 scripts/scenario_49_allies.lua:3765 scripts/scenario_49_allies.lua:3803 scripts/scenario_49_allies.lua:3845 scripts/scenario_49_allies.lua:3883 scripts/scenario_49_allies.lua:3921
msgctxt "doctor-comms"
msgid "She slams the door in your face as you reach for her"
msgstr "Ella golpea la puerta en tu cara mientras la alcanzas."

#: scripts/scenario_49_allies.lua:3731
msgctxt "doctor-comms"
msgid "A dying patient needs your expertise"
msgstr "Un paciente moribundo necesita tu experiencia."

#: scripts/scenario_49_allies.lua:3733
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] Then let's get going to help the patient\n"
"\n"
"As you both return, you explain the situation to her"
msgstr "[Dr. Thultris] Entonces vamos a ayudar a la paciente A medida que los dos regresen, usted le explica la situación"

#: scripts/scenario_49_allies.lua:3737
msgctxt "doctor-comms"
msgid ""
"People die all the time\n"
"[Dr. Thultris closes her door]"
msgstr "La gente muere todo el tiempo [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3741
msgctxt "doctor-comms"
msgid "An Arlenian Admiral shows symptoms like those you published"
msgstr "Un Almirante Arleniano muestra síntomas como los que publicó"

#: scripts/scenario_49_allies.lua:3743
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] Take me to the admiral\n"
"\n"
"As you both return to the ship, you explain the situation to her"
msgstr "[Dr. Thultris] Llévame al almirante Mientras los dos regresen a la nave, le explican la situación"

#: scripts/scenario_49_allies.lua:3747
msgctxt "doctor-comms"
msgid ""
"An Arlenian Admiral? Who cares!\n"
"[Dr. Thultris closes her door]"
msgstr "¿Un Almirante Arleniano? ¡A quién le importa! [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3752
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris behind closed quarters door]\n"
"Go away, I'm busy"
msgstr "Vete, estoy ocupado."

#: scripts/scenario_49_allies.lua:3756
msgctxt "doctor-comms"
msgid "Medical team suggested your research for a patient"
msgstr "Equipo médico sugirió su investigación para un paciente"

#: scripts/scenario_49_allies.lua:3758
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris opens her door]\n"
"How does my research apply to a patient?"
msgstr "¿Cómo se aplica mi investigación a un paciente?"

#: scripts/scenario_49_allies.lua:3759
msgctxt "Doctor-comms"
msgid "Grab Dr. Thultris"
msgstr "Coge al Dr. Thultris"

#: scripts/scenario_49_allies.lua:3769
msgctxt "doctor-comms"
msgid "The symptoms closely correlate to your research"
msgstr "Los síntomas se correlacionan estrechamente con su investigación"

#: scripts/scenario_49_allies.lua:3771
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] I think I can help\n"
"\n"
"As you both return, you explain the situation to her"
msgstr "Creo que puedo ayudar a medida que los dos regresen, le explican la situación."

#: scripts/scenario_49_allies.lua:3775
msgctxt "doctor-comms"
msgid ""
"Let me know what happens with the patient\n"
"[Dr. Thultris closes her door]"
msgstr "Avísame qué pasa con la paciente [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3779
msgctxt "doctor-comms"
msgid "Your research may save an Arlenian Admiral's life"
msgstr "Su investigación puede salvar la vida de un Almirante Arleniano"

#: scripts/scenario_49_allies.lua:3781
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] I would love to apply my research\n"
"\n"
"As you both return, you explain the situation to her"
msgstr "[Dr. Thultris] Me encantaría aplicar mi investigación Mientras los dos regresan, le explican la situación"

#: scripts/scenario_49_allies.lua:3785
msgctxt "doctor-comms"
msgid ""
"Diplomacy and military matters bore me\n"
"[Dr. Thultris closes her door]"
msgstr "Diplomacia y asuntos militares me aburren [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3790
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris behind closed quarters door]\n"
"That's nice. Leave me alone"
msgstr "Eso es bueno, déjame en paz"

#: scripts/scenario_49_allies.lua:3794
msgctxt "doctor-comms"
msgid "Arlenian with an unusual disease is near death"
msgstr "Arlenian con una enfermedad inusual está cerca de la muerte"

#: scripts/scenario_49_allies.lua:3796
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris opens her door]\n"
"Why come to me?"
msgstr "¿Por qué vienes a mí?"

#: scripts/scenario_49_allies.lua:3807
msgctxt "doctor-comms"
msgid "The Arlenian medical team referred us to you"
msgstr "El equipo médico de Arlenian nos remitió a usted"

#: scripts/scenario_49_allies.lua:3809
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] Nice to be recognized outside of human space\n"
"\n"
"As you both return, you explain the situation to her"
msgstr "[Dr. Thultris] Es bueno ser reconocido fuera del espacio humano Mientras los dos regresan, usted le explica la situación"

#: scripts/scenario_49_allies.lua:3813
msgctxt "doctor-comms"
msgid ""
"What do the Arlenians know?\n"
"[Dr. Thultris closes her door]"
msgstr "¿Qué saben los arlenianos? [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3817
msgctxt "doctor-comms"
msgid "Your research accurately describes the symptoms"
msgstr "Su investigación describe con precisión los síntomas"

#: scripts/scenario_49_allies.lua:3819
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] I would like to see the patient\n"
"\n"
"As you both return, you explain the situation to her"
msgstr "[Dr. Thultris] Me gustaría ver a la paciente A medida que los dos regresen, usted le explica la situación"

#: scripts/scenario_49_allies.lua:3823
msgctxt "doctor-comms"
msgid ""
"Coincidental, I'm sure\n"
"[Dr. Thultris closes her door]"
msgstr "Coincidente, estoy seguro [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3828
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris behind closed quarters door]\n"
"My condolences. Goodbye"
msgstr "Mis condolencias."

#: scripts/scenario_49_allies.lua:3834
msgctxt "doctor-comms"
msgid "I am an admirer of your research and have questions"
msgstr "Soy un admirador de su investigación y tengo preguntas"

#: scripts/scenario_49_allies.lua:3835
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris behind closed quarters door]\n"
"Really? What is it about my research you admire?"
msgstr "¿En serio? ¿Qué pasa con mi investigación que admiras?"

#: scripts/scenario_49_allies.lua:3836
msgctxt "doctor-comms"
msgid "The depth of your most recent publication"
msgstr "La profundidad de su publicación más reciente"

#: scripts/scenario_49_allies.lua:3838
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris opens her door]\n"
"Why does this research interest you?"
msgstr "¿Por qué te interesa esta investigación?"

#: scripts/scenario_49_allies.lua:3849
msgctxt "doctor-comms"
msgid "I know of a patient that might benefit"
msgstr "Sé de un paciente que podría beneficiarme."

#: scripts/scenario_49_allies.lua:3851
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] Those are rare. May I see the patient?\n"
"\n"
"As you both return, you explain the situation to her"
msgstr "[Dr. Thultris] Eso es raro. ¿Puedo ver al paciente? Mientras ustedes dos regresan, le explican la situación a ella"

#: scripts/scenario_49_allies.lua:3855
msgctxt "doctor-comms"
msgid ""
"My research is unlikely to apply\n"
"[Dr. Thultris closes her door]"
msgstr "Mi investigación es poco probable que se aplique [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3859
msgctxt "doctor-comms"
msgid "Your research could help a sick Arlenian Admiral"
msgstr "Su investigación podría ayudar a un Almirante Arleniano enfermo"

#: scripts/scenario_49_allies.lua:3861
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] I would like to see my research in the Arlenian context\n"
"\n"
"As you both return, you explain the situation to her"
msgstr "[Dr. Thultris] Me gustaría ver mi investigación en el contexto de Arlenian A medida que ustedes dos regresan, le explican la situación"

#: scripts/scenario_49_allies.lua:3865
msgctxt "doctor-comms"
msgid ""
"I don't think it applies to Arlenians\n"
"[Dr. Thultris closes her door]"
msgstr "No creo que se aplique a los arlenianos [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3870
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris behind closed quarters door]\n"
"Publish a review and we'll talk"
msgstr "[Dr. Thultris detrás de la puerta de los cuartos cerrados] Publicar una reseña y hablaremos"

#: scripts/scenario_49_allies.lua:3874
msgctxt "doctor-comms"
msgid "The breadth of knowledge you demonstrate"
msgstr "La amplitud del conocimiento que demuestras"

#: scripts/scenario_49_allies.lua:3876
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris opens her door]\n"
"I doubt that. Why are you *really* here?"
msgstr "Lo dudo. ¿Por qué estás aquí?"

#: scripts/scenario_49_allies.lua:3887
msgctxt "doctor-comms"
msgid "We need your help with a dying Arlenian Admiral"
msgstr "Necesitamos su ayuda con un Almirante Arleniano moribundo"

#: scripts/scenario_49_allies.lua:3889 scripts/scenario_49_allies.lua:3927
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] Why didn't you say so? Of course I'll help\n"
"\n"
"As you both return, you explain the situation to her"
msgstr "¿Por qué no lo dijiste? Por supuesto que ayudaré Mientras los dos regresen, le explicas la situación."

#: scripts/scenario_49_allies.lua:3893
msgctxt "doctor-comms"
msgid ""
"Your first story was better\n"
"[Dr. Thultris closes her door]"
msgstr "Tu primera historia fue mejor [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3897
msgctxt "doctor-comms"
msgid "An Arlenian medical team thinks you can help a dying patient"
msgstr "Un equipo médico de Arlenian cree que puede ayudar a un paciente moribundo"

#: scripts/scenario_49_allies.lua:3899
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] That's reasonable. Let's go\n"
"\n"
"As you both return, you explain the situation to her"
msgstr "[Dr. Thultris] Eso es razonable."

#: scripts/scenario_49_allies.lua:3903
msgctxt "doctor-comms"
msgid ""
"I'm not concerned with Arlenian patients\n"
"[Dr. Thultris closes her door]"
msgstr "No me preocupan los pacientes arlenianos [el Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3908
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris behind closed quarters door]\n"
"Faint praise insults me. Go away"
msgstr "[Dr. Thultris detrás de la puerta de los cuartos cerrados] Elogio falso me insulta."

#: scripts/scenario_49_allies.lua:3912
msgctxt "doctor-comms"
msgid "Your superb publication presentation"
msgstr "Su magnífica presentación de publicación"

#: scripts/scenario_49_allies.lua:3914
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris opens her door]\n"
"Ha! Is that why you're here?"
msgstr "¿Por eso estás aquí?"

#: scripts/scenario_49_allies.lua:3925
msgctxt "doctor-comms"
msgid "Not really. We need your help"
msgstr "Necesitamos tu ayuda."

#: scripts/scenario_49_allies.lua:3931
msgctxt "doctor-comms"
msgid ""
"I'm sorry, but I'm too busy right now\n"
"[Dr. Thultris closes her door]"
msgstr "Lo siento, pero estoy muy ocupado ahora mismo [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3935
msgctxt "doctor-comms"
msgid "Of course! I've got a case study for you to examine"
msgstr "Tengo un estudio de caso para que examines."

#: scripts/scenario_49_allies.lua:3937
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris] An application for my research?! Goody Goody!\n"
"\n"
"As you both return, you explain the situation to her"
msgstr "[Dr. Thultris] ¿Una solicitud para mi investigación?! Goody Goody! Mientras ambos regresan, le explican la situación a ella"

#: scripts/scenario_49_allies.lua:3941
msgctxt "doctor-comms"
msgid ""
"Sounds interesting, but not right now, thanks\n"
"[Dr. Thultris closes her door]"
msgstr "Suena interesante, pero no ahora mismo, gracias [El Dr. Thultris cierra su puerta]"

#: scripts/scenario_49_allies.lua:3946
msgctxt "doctor-comms"
msgid ""
"[Dr. Thultris behind closed quarters door]\n"
"Get a writing advisor and get out of here"
msgstr "[Dr. Thultris detrás de la puerta de los cuartos cerrados] Obtenga un asesor de escritura y salga de aquí"

#: scripts/scenario_49_allies.lua:3961 scripts/scenario_49_allies.lua:4453
#, lua-format
msgctxt "characterInfo-comms"
msgid "Tell me about %s"
msgstr "Háblame de %s"

#: scripts/scenario_49_allies.lua:3968 scripts/scenario_49_allies.lua:4460
#, lua-format
msgctxt "characterInfo-comms"
msgid "Never heard of %s"
msgstr "Nunca he oído hablar de %s"

#: scripts/scenario_49_allies.lua:3970 scripts/scenario_49_allies.lua:4462
#, lua-format
msgctxt "characterInfo-comms"
msgid "%s died last week. The funeral was yesterday"
msgstr "%s El funeral fue ayer."

#: scripts/scenario_49_allies.lua:3972 scripts/scenario_49_allies.lua:4464
#, lua-format
msgctxt "characterInfo-comms"
msgid "%s? Who's %s? There's nobody here named %s"
msgstr "%s¿Quién es? %sNo hay nadie aquí llamado %s"

#: scripts/scenario_49_allies.lua:3974 scripts/scenario_49_allies.lua:4466
#, lua-format
msgctxt "characterInfo-comms"
msgid "We don't talk about %s. They are gone and good riddance"
msgstr "No hablamos de eso. %s. Se han ido y se han librado"

#: scripts/scenario_49_allies.lua:3976 scripts/scenario_49_allies.lua:4468
#, lua-format
msgctxt "characterInfo-comms"
msgid "I think %s moved away"
msgstr "Creo %s Se fue."

#: scripts/scenario_49_allies.lua:3985 scripts/scenario_49_allies.lua:4477
msgctxt "orders-comms"
msgid "What are my current orders?"
msgstr "¿Cuáles son mis órdenes actuales?"

#: scripts/scenario_49_allies.lua:3990 scripts/scenario_49_allies.lua:4482
#, lua-format
msgctxt "orders-comms"
msgid ""
"\n"
"   %i Minutes remain in game"
msgstr ""
"\n"
"   %i Minutos permanecen en juego"

#: scripts/scenario_49_allies.lua:4001 scripts/scenario_49_allies.lua:4017
#, lua-format
msgctxt "trade-comms"
msgid "Recruit repair crew member for %i reputation"
msgstr "Contratación de tripulante de reparación %i reputación"

