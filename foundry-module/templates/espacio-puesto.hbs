<section class="lagunak-workspace__shell lagunak-workspace--{{accent}} lagunak-puesto-{{station}}">
  {{#if hasStation}}
    <header class="lagunak-workspace__header">
      <div class="lagunak-workspace__identity">
        <span class="lagunak-workspace__code">{{stationCode}}</span>
        <span class="lagunak-workspace__emblem" aria-hidden="true"></span>
        <span class="lagunak-workspace__icon" aria-hidden="true"><i class="{{stationIcon}}"></i></span>
        <div>
          <small>{{localize "LAGUNAK.Espacios.PuestoActivo"}}</small>
          <h2>{{stationLabel}}</h2>
        </div>
      </div>
      <div class="lagunak-workspace__crew-counter" aria-label="{{localize "LAGUNAK.Espacios.TripulacionActiva"}}">
        <strong>{{activeCrew}}</strong><span>/{{crewCount}}</span>
        <small>{{localize "LAGUNAK.Espacios.EnLinea"}}</small>
      </div>
    </header>

    {{#if isGM}}
      <nav class="lagunak-workspace__tabs" aria-label="{{localize "LAGUNAK.Espacios.Previsualizar"}}">
        {{#each tabs}}
          <button type="button" class="{{#if selected}}is-selected{{/if}}" aria-pressed="{{selected}}" data-workspace-action="preview" data-station="{{station}}">
            {{label}}
          </button>
        {{/each}}
      </nav>
    {{/if}}

    <div class="lagunak-workspace__connection lagunak-workspace__connection--{{connection}}" role="status" aria-live="polite">
      <span class="lagunak-workspace__pulse" aria-hidden="true"></span>
      {{#if connectionOk}}{{localize "LAGUNAK.Espacios.TelemetriaOk"}}{{/if}}
      {{#if connectionLoading}}{{localize "LAGUNAK.Espacios.TelemetriaCargando"}}{{/if}}
      {{#if connectionError}}{{localize "LAGUNAK.Espacios.TelemetriaError"}} — {{error}}{{/if}}
      {{#if connectionRestricted}}{{localize "LAGUNAK.Espacios.TelemetriaRestringida"}}{{/if}}
    </div>

    <div class="lagunak-workspace__grid">
      <main class="lagunak-workspace__console">
        <div class="lagunak-workspace__console-title">
          <span>{{localize "LAGUNAK.Espacios.PanelOperativo"}}</span>
          <span class="lagunak-workspace__sweep" aria-hidden="true"></span>
        </div>

        {{! Casco propio en 3D (#362). Va FUERA del bloque de telemetría a
            propósito: la telemetría solo la recibe el GM, y si el visor viviera
            dentro, la tripulación —que es para quien se hizo— no tendría
            lienzo ninguno que pintar. Sin lectura se pinta quieto y gris, que
            es información honesta: no sabemos hacia dónde apunta.

            Es un refuerzo de lo que ya está escrito —el rumbo va en la matriz
            de métricas— así que va decorativo: quien use lector de pantalla no
            pierde nada, y quien mire de reojo ve hacia dónde apunta la nave sin
            leer un número. El lienzo es pequeño de verdad y se amplía por CSS:
            la resolución interna baja ES el efecto, no un adorno. }}
        <div class="lagunak-workspace__casco" aria-hidden="true">
          <canvas data-lagunak-casco width="96" height="72"></canvas>
        </div>

        {{!-- Lámina del objetivo de atraque (#391). Solo existe mientras hay
              atraque: sin lectura no hay lienzo, y por tanto no hay nada que
              interpretar. Va en GameCube y no en PSX por lo mismo que la lámina
              del contacto: esto se mira FIJO para reconocer contra qué se está
              atracando, no de reojo. Decorativo como el casco — el estado y el
              nombre del sitio están en la matriz de métricas, en texto. --}}
        {{#if atraque}}
        <div class="lagunak-workspace__atraque" aria-hidden="true">
          <canvas data-lagunak-atraque width="112" height="84"></canvas>
        </div>
        {{/if}}

        {{#if hasTelemetry}}
          <div class="lagunak-workspace__metrics">
            {{#each metrics}}
              <article class="lagunak-workspace__metric lagunak-workspace__metric--{{tone}}">
                <small>{{label}}</small>
                <strong>{{value}}</strong>
                {{#if hasProgress}}
                  <div class="lagunak-workspace__meter" role="meter" aria-label="{{label}}: {{value}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progress}}">
                    <span style="width: {{progress}}%"></span>
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </div>

          {{#if ship}}
            {{#if isNavigation}}
              <div class="lagunak-workspace__nav-display">
                <div class="lagunak-workspace__radar" role="img" aria-label="{{navigationAriaLabel}}" style="--lagunak-heading: {{navigationHeading}}deg">
                  <span class="lagunak-workspace__radar-ring" aria-hidden="true"></span>
                  <span class="lagunak-workspace__heading-line" aria-hidden="true"></span>
                  <i class="fa-solid fa-shuttle-space" aria-hidden="true"></i>
                </div>
                <div class="lagunak-workspace__route-copy">
                  <small>{{localize "LAGUNAK.Espacios.RutaActual"}}</small>
                  <strong>{{#if ship.destination}}{{ship.destination.name}}{{else}}{{localize "LAGUNAK.Espacios.SinDestino"}}{{/if}}</strong>
                  <span>{{localize "LAGUNAK.Espacios.RutaSoloLectura"}}</span>
                </div>
              </div>
            {{/if}}
          {{/if}}

          {{#if systems.length}}
            <div class="lagunak-workspace__systems">
              <div class="lagunak-workspace__list-heading">
                <span>{{localize "LAGUNAK.Espacios.MatrizSistemas"}}</span>
                <span>{{localize "LAGUNAK.Espacios.SaludCalorPotencia"}}</span>
              </div>
              {{#each systems}}
                <div class="lagunak-workspace__system-row">
                  <strong>{{name}}</strong>
                  <span class="is-health" aria-label="{{localize "LAGUNAK.EstadoNave.Salud"}}: {{health}}%">{{health}}%</span>
                  <span class="is-heat" aria-label="{{localize "LAGUNAK.EstadoNave.Calor"}}: {{heat}}%">{{heat}}%</span>
                  <span class="is-power" aria-label="{{localize "LAGUNAK.EstadoNave.Potencia"}}: {{power}}%">{{power}}%</span>
                  <span class="is-coolant" aria-label="{{localize "LAGUNAK.Espacios.Refrigerante"}}: {{coolant}}%">{{coolant}}%</span>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{#if contacts.length}}
            <div class="lagunak-workspace__contacts">
              <div class="lagunak-workspace__list-heading">
                <span>{{localize "LAGUNAK.Espacios.ContactosProximos"}}</span>
                <span>{{localize "LAGUNAK.Espacios.SoloGM"}}</span>
              </div>
              {{#each contacts}}
                <div class="lagunak-workspace__contact-row">
                  <i class="fa-solid fa-diamond" aria-hidden="true"></i>
                  <strong>{{callsign}}</strong>
                  <span>{{faction}}</span>
                  <code>{{x}}, {{y}}</code>
                </div>
              {{/each}}
            </div>
          {{/if}}
        {{else}}
          <div class="lagunak-workspace__empty">
            <i class="fa-solid fa-wave-square" aria-hidden="true"></i>
            <strong>{{localize "LAGUNAK.Espacios.SinTelemetria"}}</strong>
            <p>{{localize "LAGUNAK.Espacios.SinTelemetriaDetalle"}}</p>
          </div>
        {{/if}}

        {{! Órdenes operativas por puesto (#236+): fuera del bloque de telemetría
            porque la tripulación no la recibe y aun así debe poder ordenar. }}
        {{#if canOrderHeading}}
          <form class="lagunak-workspace__orden" data-workspace-order="heading">
            <label for="lagunak-orden-rumbo">{{localize "LAGUNAK.Espacios.Orden.RumboLabel"}}</label>
            <input id="lagunak-orden-rumbo" name="heading" type="number" min="0" max="359" step="1" inputmode="numeric" />
            <button type="button" data-workspace-action="orden-rumbo">{{localize "LAGUNAK.Espacios.Orden.FijarRumbo"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.RumboAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderImpulse}}
          <form class="lagunak-workspace__orden" data-workspace-order="impulse">
            <label for="lagunak-orden-impulso">{{localize "LAGUNAK.Espacios.Orden.ImpulsoLabel"}}</label>
            <input id="lagunak-orden-impulso" name="impulse" type="number" min="-1" max="1" step="0.1" inputmode="decimal" />
            <button type="button" data-workspace-action="orden-impulso">{{localize "LAGUNAK.Espacios.Orden.FijarImpulso"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.ImpulsoAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderWarp}}
          <form class="lagunak-workspace__orden" data-workspace-order="warp">
            <label for="lagunak-orden-warp">{{localize "LAGUNAK.Espacios.Orden.WarpLabel"}}</label>
            <input id="lagunak-orden-warp" name="warp" type="number" min="0" max="4" step="1" inputmode="numeric" />
            <button type="button" data-workspace-action="orden-warp">{{localize "LAGUNAK.Espacios.Orden.FijarWarp"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.WarpAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderPower}}
          <form class="lagunak-workspace__orden" data-workspace-order="power">
            <label for="lagunak-orden-sistema">{{localize "LAGUNAK.Espacios.Orden.SistemaLabel"}}</label>
            <select id="lagunak-orden-sistema" name="system">
              {{#each powerSystems}}<option value="{{value}}">{{label}}</option>{{/each}}
            </select>
            <label for="lagunak-orden-nivel">{{localize "LAGUNAK.Espacios.Orden.NivelLabel"}}</label>
            <select id="lagunak-orden-nivel" name="level">
              {{#each powerLevels}}<option value="{{value}}">{{label}}</option>{{/each}}
            </select>
            <button type="button" data-workspace-action="orden-potencia">{{localize "LAGUNAK.Espacios.Orden.FijarPotencia"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.PotenciaAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderCoolant}}
          <form class="lagunak-workspace__orden" data-workspace-order="coolant">
            <label for="lagunak-orden-sistema-refrig">{{localize "LAGUNAK.Espacios.Orden.SistemaLabel"}}</label>
            <select id="lagunak-orden-sistema-refrig" name="system">
              {{#each coolantSystems}}<option value="{{value}}">{{label}}</option>{{/each}}
            </select>
            <label for="lagunak-orden-nivel-refrig">{{localize "LAGUNAK.Espacios.Orden.RefrigeranteNivelLabel"}}</label>
            <select id="lagunak-orden-nivel-refrig" name="level">
              {{#each coolantLevels}}<option value="{{value}}">{{label}}</option>{{/each}}
            </select>
            <button type="button" data-workspace-action="orden-refrigerante">{{localize "LAGUNAK.Espacios.Orden.FijarRefrigerante"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.RefrigeranteAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderShields}}
          <form class="lagunak-workspace__orden" data-workspace-order="shields">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.EscudosLabel"}}</span>
            <button type="button" data-workspace-action="orden-escudos-subir">{{localize "LAGUNAK.Espacios.Orden.SubirEscudos"}}</button>
            <button type="button" data-workspace-action="orden-escudos-bajar">{{localize "LAGUNAK.Espacios.Orden.BajarEscudos"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.EscudosAyuda"}}</small>
          </form>
        {{/if}}
      </main>

      <aside class="lagunak-workspace__side">
        <section class="lagunak-workspace__briefing">
          <h3>{{localize "LAGUNAK.Espacios.ListaGuardia"}}</h3>
          <ol>
            {{#each tasks}}
              <li><span>{{number}}</span>{{label}}</li>
            {{/each}}
          </ol>
        </section>

        <section class="lagunak-workspace__crew">
          <h3>{{localize "LAGUNAK.Espacios.Tripulacion"}}</h3>
          {{#each crew}}
            <div class="lagunak-workspace__crew-row {{#unless active}}is-offline{{/unless}}">
              <span class="lagunak-workspace__crew-light" aria-hidden="true"></span>
              {{! El retrato es decorativo: alt vacío y aria-hidden, porque
                  puesto y estado ya van en texto justo al lado. El marco de
                  puesto es CSS, no imagen: no es un galón. }}
              <span class="lagunak-workspace__crew-portrait {{#if station}}lagunak-workspace__crew-portrait--{{station}}{{/if}}" aria-hidden="true">
                <img class="lagunak-workspace__crew-portrait-img" src="{{portrait}}" alt="" aria-hidden="true" width="32" height="32"/>
              </span>
              <strong>{{name}}</strong>
              <small>{{stationLabel}}{{#unless active}} · {{statusLabel}}{{/unless}}</small>
            </div>
          {{else}}
            <p>{{localize "LAGUNAK.Puestos.SinJugadores"}}</p>
          {{/each}}
        </section>
      </aside>
    </div>

    <footer class="lagunak-workspace__actions">
      <button type="button" data-workspace-action="assignments">
        <i class="fa-solid fa-users-gear" aria-hidden="true"></i> {{localize "LAGUNAK.Espacios.GestionarPuestos"}}
      </button>
      {{#if isGM}}
        <button type="button" class="is-primary" data-workspace-action="refresh">
          <i class="fa-solid fa-rotate" aria-hidden="true"></i> {{localize "LAGUNAK.Espacios.Actualizar"}}
        </button>
      {{/if}}
    </footer>
  {{else}}
    <div class="lagunak-workspace__unassigned">
      <span class="lagunak-workspace__unassigned-icon" aria-hidden="true"><i class="fa-solid fa-user-astronaut"></i></span>
      <small>{{localize "LAGUNAK.Espacios.SinPuestoCodigo"}}</small>
      <h2>{{localize "LAGUNAK.Espacios.SinPuesto"}}</h2>
      <p>{{localize "LAGUNAK.Espacios.SinPuestoDetalle"}}</p>
      <button type="button" data-workspace-action="assignments">
        <i class="fa-solid fa-users-gear" aria-hidden="true"></i> {{localize "LAGUNAK.Espacios.ElegirPuesto"}}
      </button>
    </div>
  {{/if}}
</section>
