#: scripts/scenario_62_whatTheDickens.lua:334
msgctxt "riverWarning-shipLog"
msgid "Reminder to all newcomers to the London area: the river area damages ship systems. Jump the river or use the provided bridges"
msgstr "Recordar a todos los recién llegados a la zona de Londres: la zona del río daña los sistemas de buques. Saltear el río o utilizar los puentes proporcionados"

#: scripts/scenario_62_whatTheDickens.lua:401
msgctxt "station-comms"
