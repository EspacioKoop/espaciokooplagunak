#, lua-format
msgctxt "upgrade-comms"
msgid "%s: You need to bring me some %s before I can increase your battery efficiency"
msgstr "%sTienes que traerme algo %s antes de que pueda aumentar la eficiencia de la batería"

#: scripts/scenario_59_border.lua:7216
#, lua-format
msgctxt "upgrade-comms"
msgid "%s increased your battery efficiency by 25%% without the need for %s due to the pressing military demands on your ship"
msgstr "%s aumentar la eficiencia de la batería en 25%% sin la necesidad de %s debido a las apremiantes demandas militares en su barco"

#: scripts/scenario_59_border.lua:7224
msgctxt "upgrade-comms"
msgid "Strengthen shields"
msgstr "Fortalecer los escudos"

#: scripts/scenario_59_border.lua:7247
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: I've raised your shield maximum by %i%%, %s. Thanks for bringing the %s"
msgstr "%s: He levantado su escudo máximo por %i%%, %sGracias por traer %s"

#: scripts/scenario_59_border.lua:7249
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: You need to provide %s before I can raise your shield strength"
msgstr "%s: Usted necesita proporcionar %s antes de que pueda aumentar su fuerza de escudo"

#: scripts/scenario_59_border.lua:7258
#, lua-format
msgctxt "upgrade-comms"
msgid "%s: Congratulations, %s, your shields are 20%% stronger. Don't worry about the %s. Go kick those Kraylors outta here"
msgstr "%sFelicitaciones, %s, tus escudos son 20%% No te preocupes por lo más fuerte. %sVamos a echar a esos Kraylors de aquí"

