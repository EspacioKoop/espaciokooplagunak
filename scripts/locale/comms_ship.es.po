#: scripts/comms_ship.lua:38
msgctxt "shipAssist-comms"
msgid "What do you want?"
msgstr "¿Qué quieres?"

#: scripts/comms_ship.lua:40
msgctxt "shipAssist-comms"
msgid "Sir, how can we assist?"
msgstr "Señor, ¿cómo podemos ayudar?"

#: scripts/comms_ship.lua:43
msgctxt "shipAssist-comms"
msgid "Defend a waypoint"
msgstr "Defender un waypoint"

#: scripts/comms_ship.lua:46
msgctxt "shipAssist-comms"
msgid "No waypoints set. Please set a waypoint first."
msgstr "No hay puntos de vista. Por favor, ponga un punto de vista primero."

#: scripts/comms_ship.lua:47 scripts/comms_ship.lua:57 scripts/comms_ship.lua:70 scripts/comms_ship.lua:78 scripts/comms_ship.lua:88
msgid "Back"
msgstr "Volver"

#: scripts/comms_ship.lua:49
msgctxt "shipAssist-comms"
msgid "Which waypoint should we defend?"
msgstr "¿Cuál es el punto de partida que debemos defender?"

#: scripts/comms_ship.lua:52
#, lua-format
msgctxt "shipAssist-comms"
msgid "Defend %s"
msgstr "Defended %s"

#: scripts/comms_ship.lua:56
#, lua-format
msgctxt "shipAssist-comms"
msgid "We are heading to assist at %s."
msgstr "Nos dirigimos a ayudar en %s."

#: scripts/comms_ship.lua:66
msgctxt "shipAssist-comms"
msgid "Assist me"
msgstr "Ayúdame."

#: scripts/comms_ship.lua:68
msgctxt "shipAssist-comms"
msgid "Heading toward you to assist."
msgstr "Dirigiéndose hacia ti para asistir."

#: scripts/comms_ship.lua:75
msgctxt "shipAssist-comms"
msgid "Report status"
msgstr "Situación de los informes"

#: scripts/comms_ship.lua:84
#, lua-format
msgctxt "shipAssist-comms"
msgid "Dock at %s"
msgstr "Dock at %s"

#: scripts/comms_ship.lua:86
#, lua-format
msgctxt "shipAssist-comms"
msgid "Docking at %s."
msgstr "Docking at %s."

#: scripts/comms_ship.lua:105
msgctxt "shipEnemy-comms"
msgid "We will see to your destruction!"
msgstr "¡Vamos a ver su destrucción!"

#: scripts/comms_ship.lua:106
msgctxt "shipEnemy-comms"
msgid "Your bloodline will end here!"
msgstr "¡Tu linaje terminará aquí!"

#: scripts/comms_ship.lua:107
msgctxt "shipEnemy-comms"
msgid "Your feeble threats are meaningless."
msgstr "Sus amenazas débiles no tienen sentido."

#: scripts/comms_ship.lua:109
msgctxt "shipEnemy-comms"
msgid ""
"Ktzzzsss.\n"
"\n"
"You will DIEEee weaklingsss!"
msgstr "Ktzzzss. ¡Usted va a DIEEee débil!"

#: scripts/comms_ship.lua:113
msgctxt "shipEnemy-comms"
msgid ""
"We wish you no harm, but will harm you if we must.\n"
"\n"
"End of transmission."
msgstr "No le deseamos ningún daño, pero le dañaremos si es necesario."

#: scripts/comms_ship.lua:117
msgctxt "shipEnemy-comms"
msgid "Stay out of our way, or your death will amuse us extremely!"
msgstr "¡No te acerques a nosotros, o tu muerte nos diluirá extremadamente!"

#: scripts/comms_ship.lua:119
msgctxt "shipEnemy-comms"
msgid ""
"One zero one.\n"
"\n"
"No binary communication detected. Switching to universal speech.\n"
"\n"
"Generating appropriate response for target from human language archives.\n"
"\n"
":Do not cross us.:\n"
"\n"
"Communication halted."
msgstr "Uno cero. Ninguna comunicación binaria detectada. Interruptor al discurso universal. Generando respuesta apropiada para el objetivo de los archivos de lenguaje humano. :No nos cruzamos.: La comunicación se detuvo."

#: scripts/comms_ship.lua:128
msgctxt "shipEnemy-comms"
msgid "EXECUTE: SELFDESTRUCT"
msgstr "EXECUTE: SELFDESTRUCT"

#: scripts/comms_ship.lua:129
msgctxt "shipEnemy-comms"
msgid "Rogue command received. Targeting source."
msgstr "Recibido el comando Rogue, fuente de orientación."

#: scripts/comms_ship.lua:130
msgctxt "shipEnemy-comms"
msgid "External command ignored."
msgstr "El comando externo ignorado."

#: scripts/comms_ship.lua:132
msgctxt "shipEnemy-comms"
msgid ""
"The hive suffers no threats. Opposition to any of us is opposition to us all.\n"
"\n"
"Stand down or prepare to donate your corpses toward our nutrition."
msgstr "La colmena no sufre amenazas. La oposición a cualquiera de nosotros es oposición a todos nosotros. Bajar o prepararse para donar sus cadáveres hacia nuestra nutrición."

#: scripts/comms_ship.lua:135
msgctxt "shipEnemy-comms"
msgid "<Transmits 'The Itsy-Bitsy Spider' on all wavelengths>"
msgstr "<Transmits 'The Itsy-Bitsy Spider' on all wavelengths>"

#: scripts/comms_ship.lua:136
msgctxt "shipEnemy-comms"
msgid "We do not need permission to pluck apart such an insignificant threat."
msgstr "No necesitamos permiso para separar una amenaza tan insignificante."

#: scripts/comms_ship.lua:137
msgctxt "shipEnemy-comms"
msgid "The hive has greater priorities than exterminating pests."
msgstr "La colmena tiene mayores prioridades que exterminar plagas."

#: scripts/comms_ship.lua:139
msgctxt "shipEnemy-comms"
msgid "Mind your own business!"
msgstr "¡Cuidado con tu propio negocio!"

#: scripts/comms_ship.lua:167
msgctxt "ship-comms"
msgid ""
"Sorry, we have no time to chat with you.\n"
"\n"
"We are on an important mission."
msgstr "Lo siento, no tenemos tiempo para charlar contigo, estamos en una misión importante."

#: scripts/comms_ship.lua:171
msgctxt "ship-comms"
msgid ""
"We have nothing for you.\n"
"\n"
"Good day."
msgstr "No tenemos nada para ti."

#: scripts/comms_ship.lua:186
#, lua-format
msgctxt "shipAssist-comms"
msgid "Hull: %d%%\n"
msgstr "Hull: %d%%\n"

#: scripts/comms_ship.lua:190
#, lua-format
msgctxt "shipAssist-comms"
msgid "Shield: %d%%\n"
msgstr "Escudo: %d%%\n"

#: scripts/comms_ship.lua:192
#, lua-format
msgctxt "shipAssist-comms"
msgid "Front Shield: %d%%\n"
msgstr "Escudo frontal: %d%%\n"

#: scripts/comms_ship.lua:193
#, lua-format
msgctxt "shipAssist-comms"
msgid "Rear Shield: %d%%\n"
msgstr "Rear Shield: %d%%\n"

#: scripts/comms_ship.lua:196
#, lua-format
msgctxt "shipAssist-comms"
msgid "Shield %d: %d%%\n"
msgstr "Escudo %d: %d%%\n"

#: scripts/comms_ship.lua:202
#, lua-format
msgctxt "shipAssist-comms"
msgid "%s Missiles: %d/%d\n"
msgstr "%s Misiles: %d/%d\n"

#: scripts/comms_ship.lua:214
#, lua-format
msgctxt "shipAssist-comms"
msgid "WP %d"
msgstr "WP %d"
