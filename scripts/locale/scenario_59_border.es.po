#, lua-format
msgctxt "upgrade-comms"
msgid "%s: I appreciate the %s. You have a %i%% greater energy capacity due to increased battery efficiency"
msgstr "%s: Aprecio el %s. Tienes un %i%% mayor capacidad energética debido al aumento de la eficiencia de la batería"

