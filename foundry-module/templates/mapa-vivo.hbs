<div class="lagunak-mapa-cuerpo">
  <p class="lagunak-conexion lagunak-conexion-{{conexion}}" role="status" aria-live="polite">
    <span class="lagunak-punto" aria-hidden="true"></span>
    {{#if conexionOk}}{{localize "LAGUNAK.Conexion.Ok"}}{{/if}}
    {{#if conexionError}}{{localize "LAGUNAK.Conexion.Error"}} — {{detalleError}}{{/if}}
    {{#if conexionConectando}}{{localize "LAGUNAK.Conexion.Conectando"}}{{/if}}
  </p>

  {{!-- El puente contesta pero /v1/contacts no (#276, paso 0). La nave propia
        se sigue leyendo; lo que falta se dice con todas las letras en vez de
        dejar un mapa vacío que parece «no hay nadie ahí fuera». --}}
  {{#if contactosCaidos}}
  <p class="lagunak-aviso-superficie" role="status" aria-live="polite">
    {{localize "LAGUNAK.MapaVivo.ContactosCaidos"}}
  </p>
  {{/if}}

  <details class="lagunak-ayuda">
    <summary>{{localize "LAGUNAK.Ayuda.Titulo"}}</summary>
    <p>{{localize "LAGUNAK.Ayuda.MapaQueEs"}}</p>
    <p>{{localize "LAGUNAK.Ayuda.SoloLectura"}}</p>
    <p>{{localize "LAGUNAK.Ayuda.Navegacion"}}</p>
  </details>

  {{!-- Vista por puesto (#331, paso 2): la misma verdad, resaltada distinto.
        No es un filtro de permisos —lo que el GM no difunde no llega al frame—
        sino la lectura que hace cada rol del mismo mapa. --}}
  <label class="lagunak-mapa-vista">
    <span>{{localize "LAGUNAK.MapaVivo.Vista"}}</span>
    <select data-lagunak-puesto-vista>
      {{#each puestosVista}}
      <option value="{{this.id}}" {{#if this.activo}}selected{{/if}}>{{this.etiqueta}}</option>
      {{/each}}
    </select>
  </label>
  <p class="lagunak-mapa-vista-ayuda">{{localize "LAGUNAK.MapaVivo.VistaAyuda"}}</p>

  <div class="lagunak-mapa-visor">
    <canvas class="lagunak-mapa-canvas" width="480" height="480" role="img" aria-label="{{localize "LAGUNAK.MapaVivo.Descripcion"}}">
      {{localize "LAGUNAK.MapaVivo.Descripcion"}}
    </canvas>
  </div>
  <p class="lagunak-mapa-alcance">{{alcanceLabel}}</p>

  <h4>{{localize "LAGUNAK.MapaVivo.Leyenda"}}</h4>
  <ul class="lagunak-mapa-claves">
    {{#each leyenda}}
    <li>
      <span class="lagunak-mapa-color" style="background: {{this.color}}" aria-hidden="true"></span>
      <span>{{this.etiqueta}}</span>
    </li>
    {{/each}}
    <li class="lagunak-mapa-clave-texto">{{localize "LAGUNAK.MapaVivo.LeyendaParpadeo"}}</li>
  </ul>

  {{#if sinDatos}}
  <p class="lagunak-sin-datos">{{localize "LAGUNAK.MapaVivo.SinDatos"}}</p>
  {{else}}
  <h4>{{localize "LAGUNAK.MapaVivo.Contactos"}}</h4>
  <ul class="lagunak-mapa-leyenda">
    {{#each contactos}}
    <li>
      <button type="button" class="lagunak-mapa-contacto {{#if this.seleccionado}}lagunak-seleccionado{{/if}}" aria-pressed="{{this.seleccionado}}" data-contacto="{{this.callsign}}" data-contacto-indice="{{@index}}">
        <span class="lagunak-mapa-color" style="background: {{this.color}}" aria-hidden="true"></span>
        <span class="lagunak-mapa-callsign">{{this.callsign}}</span>
        <span class="lagunak-mapa-distancia">{{this.distanciaLabel}}</span>
        <span class="lagunak-mapa-fuera" data-lagunak-fuera {{#unless this.fuera}}hidden{{/unless}}>{{localize "LAGUNAK.MapaVivo.FueraVisor"}}</span>
      </button>
    </li>
    {{/each}}
  </ul>

  {{#if detalle}}
  <div class="lagunak-mapa-detalle" role="status">
    <h4><span class="lagunak-mapa-color" style="background: {{detalle.color}}" aria-hidden="true"></span> {{detalle.callsign}}</h4>
    {{! Lámina de reconocimiento (#362). Decorativa: la clase va escrita en la
        tabla de aquí abajo, así que la silueta refuerza y no informa sola. }}
    <div class="lagunak-mapa-lamina" aria-hidden="true">
      <canvas data-lagunak-lamina width="120" height="90"></canvas>
    </div>
    <table class="lagunak-tabla">
      <tr><th>{{localize "LAGUNAK.MapaVivo.Detalle.Tipo"}}</th><td>{{detalle.tipo}}</td></tr>
      <tr><th>{{localize "LAGUNAK.MapaVivo.Detalle.Clase"}}</th><td>{{detalle.claseLabel}}</td></tr>
      <tr><th>{{localize "LAGUNAK.MapaVivo.Detalle.Faccion"}}</th><td>{{detalle.faccion}}</td></tr>
      <tr><th>{{localize "LAGUNAK.EstadoNave.Distancia"}}</th><td data-lagunak-detalle-distancia>{{detalle.distanciaLabel}}</td></tr>
      <tr><th>{{localize "LAGUNAK.EstadoNave.Rumbo"}}</th><td data-lagunak-detalle-rumbo>{{detalle.rumboLabel}}</td></tr>
    </table>
  </div>
  {{else}}
  <p class="lagunak-mapa-sin-seleccion">{{localize "LAGUNAK.MapaVivo.SinSeleccion"}}</p>
  {{/if}}
  {{/if}}
</div>
