<div class="lagunak-estado-cuerpo">
  <p class="lagunak-conexion lagunak-conexion-{{conexion}}" role="status" aria-live="polite">
    <span class="lagunak-punto" aria-hidden="true"></span>
    {{#if conexionOk}}{{localize "LAGUNAK.Conexion.Ok"}}{{/if}}
    {{#if conexionError}}{{localize "LAGUNAK.Conexion.Error"}} — {{detalleError}}{{/if}}
    {{#if conexionConectando}}{{localize "LAGUNAK.Conexion.Conectando"}}{{/if}}
  </p>

  {{#if esGM}}
  <div class="lagunak-tempo">
    <span class="lagunak-pausa-estado lagunak-pausa-{{pausa.estado}}" role="status">
      <span class="lagunak-punto" aria-hidden="true"></span> {{pausa.etiqueta}}
    </span>
    <button type="button" data-action="pausar" {{#unless pausa.puedePausar}}disabled{{/unless}}>
      <i class="fa-solid fa-pause" aria-hidden="true"></i> {{localize "LAGUNAK.Tempo.Pausar"}}
    </button>
    <button type="button" data-action="reanudar" {{#unless pausa.puedeReanudar}}disabled{{/unless}}>
      <i class="fa-solid fa-play" aria-hidden="true"></i> {{localize "LAGUNAK.Tempo.Reanudar"}}
    </button>
    {{#if pausa.foundryPausado}}
    <p class="lagunak-pausa-foundry">{{localize "LAGUNAK.Pausa.FoundryPausado"}}</p>
    {{/if}}
  </div>
  {{/if}}

  <details class="lagunak-ayuda" {{#if ayudaAbierta}}open{{/if}}>
    <summary>{{localize "LAGUNAK.Ayuda.Titulo"}}</summary>
    <p>{{localize "LAGUNAK.Ayuda.EstadoQueEs"}}</p>
    <p>{{localize "LAGUNAK.Ayuda.SoloLectura"}}</p>
    <p>{{localize "LAGUNAK.Ayuda.Navegacion"}}</p>
  </details>

  {{#if nave}}
  <h3>{{nave.callsign}}</h3>
  <table class="lagunak-tabla" aria-label="{{localize "LAGUNAK.EstadoNave.Resumen"}}">
    <tr><th>{{localize "LAGUNAK.EstadoNave.Posicion"}}</th><td>{{nave.position.x}}, {{nave.position.y}}</td></tr>
    <tr><th>{{localize "LAGUNAK.EstadoNave.Rumbo"}}</th><td>{{nave.heading}}°</td></tr>
    {{#if ruta}}
    <tr class="lagunak-ruta-{{ruta.estado}}"><th>{{localize "LAGUNAK.EstadoNave.Destino"}}</th><td>{{ruta.name}}</td></tr>
    <tr class="lagunak-ruta-{{ruta.estado}}"><th>{{localize "LAGUNAK.EstadoNave.Distancia"}}</th><td>{{ruta.distanceLabel}}</td></tr>
    <tr class="lagunak-ruta-{{ruta.estado}}"><th>{{localize "LAGUNAK.EstadoNave.Eta"}}</th><td>{{ruta.etaLabel}}</td></tr>
    {{/if}}
    <tr><th>{{localize "LAGUNAK.EstadoNave.Casco"}}</th><td>{{nave.hull}} / {{nave.hull_max}}</td></tr>
    <tr><th>{{localize "LAGUNAK.EstadoNave.Energia"}}</th><td>{{nave.energy}} / {{nave.energy_max}}</td></tr>
    <tr><th>{{localize "LAGUNAK.EstadoNave.Escudos"}}</th><td>{{#if nave.shields_active}}{{localize "LAGUNAK.EstadoNave.EscudosActivos"}}{{else}}{{localize "LAGUNAK.EstadoNave.EscudosInactivos"}}{{/if}}</td></tr>
  </table>

  <h4>{{localize "LAGUNAK.EstadoNave.Sistemas"}}</h4>
  <table class="lagunak-tabla lagunak-sistemas" aria-label="{{localize "LAGUNAK.EstadoNave.EstadoSistemas"}}">
    <tr>
      <th>{{localize "LAGUNAK.EstadoNave.Sistema"}}</th>
      <th>{{localize "LAGUNAK.EstadoNave.Salud"}}</th>
      <th>{{localize "LAGUNAK.EstadoNave.Calor"}}</th>
      <th>{{localize "LAGUNAK.EstadoNave.Potencia"}}</th>
    </tr>
    {{#each sistemas}}
    <tr>
      <td>{{this.nombre}}</td>
      <td>{{this.salud}}%</td>
      <td>{{this.calor}}%</td>
      <td>{{this.potencia}}%</td>
    </tr>
    {{/each}}
  </table>

  {{#if esGM}}{{#if ingenieria.disponible}}
  <div class="lagunak-ingenieria">
    <h4>{{localize "LAGUNAK.Ingenieria.Titulo"}}</h4>
    {{#if ingenieria.tieneReparadores}}
    <p class="lagunak-ingenieria-reparadores">
      <i class="fa-solid fa-user-gear" aria-hidden="true"></i>
      {{localize "LAGUNAK.Ingenieria.Reparadores"}}: {{ingenieria.reparadores}}
    </p>
    {{/if}}
    <div class="lagunak-ingenieria-mando">
      <label>
        <span>{{localize "LAGUNAK.Ingenieria.Sistema"}}</span>
        <select data-field="ingenieria-sistema" {{#unless ingenieria.puedeAjustar}}disabled{{/unless}}>
          {{#each ingenieria.opcionesSistema}}
          <option value="{{this.id}}" {{#if this.seleccionado}}selected{{/if}}>{{this.etiqueta}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize "LAGUNAK.Ingenieria.Nivel"}}</span>
        <select data-field="ingenieria-nivel" {{#unless ingenieria.puedeAjustar}}disabled{{/unless}}>
          {{#each ingenieria.niveles}}
          <option value="{{this.valor}}" {{#if this.seleccionado}}selected{{/if}}>{{this.etiqueta}}×{{#if this.nominal}} ({{localize "LAGUNAK.Ingenieria.Nominal"}}){{/if}}</option>
          {{/each}}
        </select>
      </label>
      <button type="button" data-action="ajustarIngenieria" {{#unless ingenieria.puedeAjustar}}disabled{{/unless}}>
        <i class="fa-solid fa-bolt" aria-hidden="true"></i>
        {{#if ingenieria.pendiente}}{{localize "LAGUNAK.Ingenieria.Aplicando"}}{{else}}{{localize "LAGUNAK.Ingenieria.Aplicar"}}{{/if}}
      </button>
    </div>
    {{#if ingenieriaFallo}}
    <p class="lagunak-ingenieria-fallo" role="status">{{localize "LAGUNAK.Ingenieria.Fallo"}}</p>
    {{/if}}
    <p class="lagunak-ingenieria-nota">{{localize "LAGUNAK.Ingenieria.Nota"}}</p>
  </div>
  {{/if}}{{/if}}

  <button type="button" data-action="anotar">
    <i class="fa-solid fa-book" aria-hidden="true"></i> {{localize "LAGUNAK.Diario.Boton"}}
  </button>
  {{else}}
  <p class="lagunak-sin-datos">{{localize "LAGUNAK.EstadoNave.SinDatos"}}</p>
  {{/if}}
</div>
