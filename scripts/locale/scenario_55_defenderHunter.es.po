#: scripts/scenario_55_defenderHunter.lua:4691
#, lua-format
msgctxt "PaulOrders-shiplog"
msgid "Agent Paul Straight has information on enemies in the area and a proposal. Pick him and his equipment up at station %s"
msgstr "El agente Paul Straight tiene información sobre enemigos en la zona y una propuesta. Elija él y su equipo en la estación %s"

