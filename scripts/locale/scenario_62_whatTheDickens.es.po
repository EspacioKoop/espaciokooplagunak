msgid "What the Dickens"
msgstr "¿Qué demonios?"

# Scenario description
msgid ""
"Patrol around the London area during Christmas. Bah! Humbug! Only one player ship.\n"
"\n"
"Version 2\n"
"\n"
"USN Discord: https://discord.gg/PntGG3a where you can join a game online. There's one nearly every weekend. All experience levels are welcome."
msgstr "Patrulla alrededor de la zona de Londres durante Navidad. Bah! Humbug! Sólo un barco de jugador. Versión 2 USN Discord: https://discord.gg/PntGG3a donde puedes unirte a un juego en línea. Hay uno casi todos los fines de semana. Todos los niveles de experiencia son bienvenidos."

# Scenario setting
msgctxt "setting"
msgid "Enemies"
msgstr "Enemigos"

msgctxt "setting"
msgid "Configures the amount of enemies spawned in the scenario."
msgstr "Configura la cantidad de enemigos que se despertó en el escenario."

msgctxt "Enemies"
msgid "Easy"
msgstr "Fácil"

msgctxt "Enemies"
msgid "Easy goals and/or enemies. Good for solo players, short handed crews or less experienced crews."
msgstr "Objetivos fáciles y/o enemigos. Bien para jugadores solitarios, tripulantes de corto plazo o tripulantes menos experimentados."

msgctxt "Enemies"
msgid "Normal"
msgstr "Normal"

msgctxt "Enemies"
msgid "Normal goals and/or enemies. Good for a normal crew."
msgstr "Objetivos normales y/o enemigos. Bien para una tripulación normal."

msgctxt "Enemies"
msgid "Hard"
msgstr "Duro"

msgctxt "Enemies"
msgid "Hard goals and/or enemies. Good for experienced crews looking for a challenge."
msgstr "Difíciles objetivos y/o enemigos. Bien para tripulantes experimentados que buscan un desafío."

