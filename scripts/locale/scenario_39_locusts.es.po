#: scripts/scenario_39_locusts.lua:1175
#, lua-format
msgctxt "orders-comms"
msgid ""
"Hello %s,\n"
"Our sensors have picked up numerous Exuari ships."
msgstr "Hola. %s, Nuestros sensores han recogido numerosas naves Exuari."

#: scripts/scenario_39_locusts.lua:1176
msgctxt "orders-comms"
msgid "How many is numerous?"
msgstr "¿Cuántos son numerosos?"

#: scripts/scenario_39_locusts.lua:1177
#, lua-format
msgctxt "orders-comms"
msgid "Approximately %s"
msgstr "Aproximadamente %s"

#: scripts/scenario_39_locusts.lua:1178
msgctxt "orders-comms"
msgid "That's quite a few. What kind of ships?"
msgstr "Son unos pocos. ¿Qué clase de naves?"

#: scripts/scenario_39_locusts.lua:1179
#, lua-format
msgctxt "orders-comms"
msgid "They look like %ss. The computer calls them locusts. They're very fast."
msgstr "Parecen %sLa computadora los llama langostas, son muy rápidos."

#: scripts/scenario_39_locusts.lua:1180
msgctxt "orders-comms"
msgid "Should we be worried?"
msgstr "¿Deberíamos estar preocupados?"

#: scripts/scenario_39_locusts.lua:1181
msgctxt "orders-comms"
msgid "Individually, they should be easy to handle. As a group, they could be a problem."
msgstr "En forma individual, deben ser fáciles de manejar. Como grupo, podrían ser un problema."

#: scripts/scenario_39_locusts.lua:1182
msgctxt "orders-comms"
msgid "What do you want us to do about them?"
msgstr "¿Qué quieres que hagamos con ellos?"

#: scripts/scenario_39_locusts.lua:1183
msgctxt "orders-comms"
msgid "Get rid of them. Every last one of them."
msgstr "Deshazte de ellos, cada uno de ellos."

#: scripts/scenario_39_locusts.lua:1194
#, lua-format
msgctxt "orders-comms"
msgid ""
"Greetings %s,\n"
"We've got an update for you on those Exuari Locusts."
msgstr "Saludos %sTenemos una actualización para ti en esos Exuari Locusts."

#: scripts/scenario_39_locusts.lua:1195
msgctxt "orders-comms"
msgid "Tell us about it."
msgstr "Cuéntanoslo."

#: scripts/scenario_39_locusts.lua:1196
msgctxt "orders-comms"
msgid "All the Exuari on our sensors have started moving."
msgstr "Todos los Exuari de nuestros sensores han comenzado a moverse."

#: scripts/scenario_39_locusts.lua:1197
msgctxt "orders-comms"
msgid "Where are they going?"
msgstr "¿Adónde van?"

#: scripts/scenario_39_locusts.lua:1198
msgctxt "orders-comms"
msgid "We are not quite sure, but they seem to be converging on a central location."
msgstr "No estamos muy seguros, pero parecen estar convergendo en una ubicación central."

#: scripts/scenario_39_locusts.lua:1199
msgctxt "orders-comms"
msgid "That could make it harder for us to get rid of them."
msgstr "Eso podría hacer que sea más difícil para nosotros deshacernos de ellos."

#: scripts/scenario_39_locusts.lua:1200
msgctxt "orders-comms"
msgid "How perceptive of you! We are so glad you are out there working to rid us of these Locusts. Keep up the good work!"
msgstr "¡Qué perceptivo eres! Estamos tan contentos de que estés trabajando para librarnos de estas Locusts. ¡Mantén el buen trabajo!"

#: scripts/scenario_39_locusts.lua:1383
msgctxt "msgMainscreen"
msgid "Scenario needs the 'Per-system damage' option under 'Extra settings'"
msgstr "Escenario necesita la opción 'Daño per-sistema' bajo 'Configuración extra'"

