#: scripts/scenario_00_basic.lua:475
#, lua-format
msgctxt "goal-incCall"
msgid ""
"%s, your objective is to fend off the incoming Kraylor attack.\n"
"\n"
"Please inform your Captain and crew that you have a total of %d minutes for this mission.\n"
"\n"
"The mission started at the arrival of this message.\n"
"\n"
"Good luck."
msgstr "%s, su objetivo es evitar el ataque de Kraylor entrante. Por favor informe a su Capitán y tripulación que tiene un total de %d minutos para esta misión. La misión comenzó a la llegada de este mensaje. Buena suerte."

