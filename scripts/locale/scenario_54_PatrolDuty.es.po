msgstr "Utopia Planitia station destroyed"

#: scripts/scenario_54_PatrolDuty.lua:6527 scripts/scenario_54_PatrolDuty.lua:6695
msgctxt "msgMainscreen"
msgid "Armstrong station destroyed"
msgstr "Armstrong station destroyed"

