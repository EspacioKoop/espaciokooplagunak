msgid "PlayerShip"
msgstr "Nave del jugador"

msgctxt "setting"
msgid "Sets the default player ship"
msgstr "Establece la nave predeterminada del jugador"

msgctxt "PlayerShip"
msgid "Atlantis"
msgstr "Atlantis"

msgctxt "PlayerShip"
msgid "Powerful ship with sidewards missile tubes. Requires more advanced play."
msgstr "Nave potente con tubos de misiles laterales. Requiere un juego más avanzado."

msgctxt "PlayerShip"
msgid "Phobos M3P"
msgstr "Phobos M3P"

msgctxt "PlayerShip"
msgid "Simpler, less powerful ship. But easier to handle. Recommended for new crews."
msgstr "Nave más sencilla y menos potente, pero más fácil de pilotar. Recomendada para tripulaciones nuevas."

