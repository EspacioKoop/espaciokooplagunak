<section class="lagunak-puestos__contenido">
  <p class="lagunak-puestos__intro">
    {{#if isGM}}
      {{localize "LAGUNAK.Puestos.IntroGM"}}
    {{else}}
      {{localize "LAGUNAK.Puestos.IntroJugador"}}
    {{/if}}
  </p>

  <div class="lagunak-puestos__lista">
    {{#each crew}}
      <label class="lagunak-puestos__fila" for="lagunak-station-{{id}}">
        <span class="lagunak-puestos__usuario">
          <strong>{{name}}</strong>
          {{#unless active}}<small>{{localize "LAGUNAK.Puestos.Desconectado"}}</small>{{/unless}}
        </span>
        <select id="lagunak-station-{{id}}" data-station-user data-user-id="{{id}}" {{#unless canEdit}}disabled{{/unless}}>
          {{! Un puesto cerrado por requisitos sigue LISTADO y dice por qué: si
              desapareciera, parecería que el módulo se ha comido una opción. El
              motivo va en el propio texto y no solo en `title`, porque un
              atributo `title` no llega a quien navega con teclado ni a un lector
              de pantalla al recorrer la lista. }}
          {{#each stations}}
            <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>
              {{label}}{{#if motivo}} — {{motivo}}{{/if}}
            </option>
          {{/each}}
        </select>
      </label>
    {{else}}
      <p>{{localize "LAGUNAK.Puestos.SinJugadores"}}</p>
    {{/each}}
  </div>
</section>
