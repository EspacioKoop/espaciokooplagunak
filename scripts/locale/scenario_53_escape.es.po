msgctxt "ship-comms"
msgid ""
"Sorry, we have no time to chat with you.\n"
"We are on an important mission."
msgstr "Lo siento, no tenemos tiempo para charlar contigo, estamos en una misión importante."

#: scripts/scenario_53_escape.lua:2816
