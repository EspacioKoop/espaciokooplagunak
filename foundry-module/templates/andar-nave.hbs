<div class="lagunak-andar-nave-cuerpo">
  <p class="lagunak-andar-nave-aviso" role="status">
    {{localize "LAGUNAK.AndarNave.AvisoPrototipo"}}
  </p>
  {{!-- Dónde estás. QA: «no sé en qué sala estoy». Es una región `status` y no
        un adorno: quien use lector de pantalla también necesita saberlo, y al
        cruzar una puerta el cambio se anuncia. --}}
  <p class="lagunak-andar-nave-sala" role="status" aria-live="polite" data-andar-sala></p>
  <canvas class="lagunak-andar-lienzo" width="480" height="270"
          role="img" aria-label="{{localize "LAGUNAK.AndarNave.VistaAlt"}}"></canvas>
  <p class="lagunak-andar-nave-controles">
    {{localize "LAGUNAK.AndarNave.Controles"}}
  </p>
</div>
