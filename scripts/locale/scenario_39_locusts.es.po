"Amistoso: %i fuera de %i\n"
"Neutral: %i fuera de %i\n"
"Enemigo: %i fuera de %i"

#: scripts/scenario_39_locusts.lua:1465
msgctxt "msgMainscreen"
msgid "All friendly stations have been destroyed."
msgstr "Todas las estaciones amistosas han sido destruidas."
