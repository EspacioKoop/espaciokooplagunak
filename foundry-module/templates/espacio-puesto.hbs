<section class="lagunak-workspace__shell lagunak-workspace--{{accent}} lagunak-puesto-{{station}}">
  {{#if hasStation}}
    <header class="lagunak-workspace__header">
      <div class="lagunak-workspace__identity">
        <span class="lagunak-workspace__code">{{stationCode}}</span>
        <span class="lagunak-workspace__emblem" aria-hidden="true"></span>
        <span class="lagunak-workspace__icon" aria-hidden="true"><i class="{{stationIcon}}"></i></span>
        <div>
          <small>{{localize "LAGUNAK.Espacios.PuestoActivo"}}</small>
          <h2>{{stationLabel}}</h2>
        </div>
      </div>
      <div class="lagunak-workspace__crew-counter" aria-label="{{localize "LAGUNAK.Espacios.TripulacionActiva"}}">
        <strong>{{activeCrew}}</strong><span>/{{crewCount}}</span>
        <small>{{localize "LAGUNAK.Espacios.EnLinea"}}</small>
      </div>
    </header>

    {{#if hasUncrewedStations}}
      <section class="lagunak-workspace__uncrewed" role="status" aria-live="polite" aria-atomic="true">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <div>
          <strong>{{localize "LAGUNAK.Espacios.PuestosNoAtendidos"}}</strong>
          <p>{{localize "LAGUNAK.Espacios.PuestosNoAtendidosDetalle"}}</p>
          <ul>
            {{#each uncrewedStations}}<li>{{label}}</li>{{/each}}
          </ul>
        </div>
      </section>
    {{/if}}

    <div class="lagunak-workspace__connection lagunak-workspace__connection--{{connection}}" role="status" aria-live="polite">
      <span class="lagunak-workspace__pulse" aria-hidden="true"></span>
      {{#if connectionOk}}{{localize "LAGUNAK.Espacios.TelemetriaOk"}}{{/if}}
      {{#if connectionLoading}}{{localize "LAGUNAK.Espacios.TelemetriaCargando"}}{{/if}}
      {{#if connectionError}}{{localize "LAGUNAK.Espacios.TelemetriaError"}} — {{error}}{{/if}}
      {{#if connectionRestricted}}{{localize "LAGUNAK.Espacios.TelemetriaRestringida"}}{{/if}}
    </div>

    <div class="lagunak-workspace__grid">
      <main class="lagunak-workspace__console">
        <div class="lagunak-workspace__console-title">
          <span>{{localize "LAGUNAK.Espacios.PanelOperativo"}}</span>
          <span class="lagunak-workspace__sweep" aria-hidden="true"></span>
        </div>

        {{! Casco propio en 3D (#362). Va FUERA del bloque de telemetría a
            propósito: la telemetría solo la recibe el GM, y si el visor viviera
            dentro, la tripulación —que es para quien se hizo— no tendría
            lienzo ninguno que pintar. Sin lectura se pinta quieto y gris, que
            es información honesta: no sabemos hacia dónde apunta.

            Es un refuerzo de lo que ya está escrito —el rumbo va en la matriz
            de métricas— así que va decorativo: quien use lector de pantalla no
            pierde nada, y quien mire de reojo ve hacia dónde apunta la nave sin
            leer un número. El lienzo es pequeño de verdad y se amplía por CSS:
            la resolución interna baja ES el efecto, no un adorno. }}
        <div class="lagunak-workspace__casco" aria-hidden="true">
          <canvas data-lagunak-casco width="96" height="72"></canvas>
        </div>

        {{!-- Lámina del objetivo de atraque (#391). Solo existe mientras hay
              atraque: sin lectura no hay lienzo, y por tanto no hay nada que
              interpretar. Va en GameCube y no en PSX por lo mismo que la lámina
              del contacto: esto se mira FIJO para reconocer contra qué se está
              atracando, no de reojo. Decorativo como el casco — el estado y el
              nombre del sitio están en la matriz de métricas, en texto. --}}
        {{#if atraque}}
        <div class="lagunak-workspace__atraque" aria-hidden="true">
          <canvas data-lagunak-atraque width="112" height="84"></canvas>
        </div>
        {{/if}}

        {{#if hasTelemetry}}
          <div class="lagunak-workspace__metrics">
            {{#each metrics}}
              <article class="lagunak-workspace__metric lagunak-workspace__metric--{{tone}}">
                <small>{{label}}</small>
                <strong>{{value}}</strong>
                {{#if hasProgress}}
                  <div class="lagunak-workspace__meter" role="meter" aria-label="{{label}}: {{value}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progress}}">
                    <span style="width: {{progress}}%"></span>
                  </div>
                {{/if}}
              </article>
            {{/each}}
          </div>

          {{#if ship}}
            {{#if isNavigation}}
              {{!-- Visor del piloto (#362): lo que la nave tiene delante, en 3D
                    retro PSX. Es la primera superficie 3D del módulo que INFORMA
                    en vez de ambientar, así que hereda su regla entera: la
                    distancia y la marcación de cada contacto siguen en texto, y
                    esto es refuerzo. Por eso va decorativo — quien use lector de
                    pantalla no pierde nada, porque no hay nada aquí que no esté
                    escrito en otro sitio. Ese otro sitio es la lista de contactos
                    de más abajo, que en pilotaje sale de la MISMA lectura
                    degradada que este lienzo coloca: si alguien deja de armarla,
                    esta afirmación deja de ser cierta y el visor se queda siendo
                    la única vía a dos datos.

                    Sin sondeo el lienzo se queda limpio y apagado, que no es lo
                    mismo que un sector vacío: «no he mirado» y «he mirado y no
                    hay nada» son distintos y se ven distintos. --}}
              <div class="lagunak-workspace__visor" aria-hidden="true">
                <canvas data-lagunak-visor-piloto width="192" height="108"></canvas>
              </div>
              <div class="lagunak-workspace__nav-display">
                <div class="lagunak-workspace__radar" role="img" aria-label="{{navigationAriaLabel}}"{{#if navigationHeadingKnown}} style="--lagunak-heading: {{navigationHeading}}deg"{{/if}}>
                  <span class="lagunak-workspace__radar-ring" aria-hidden="true"></span>
                  {{#if navigationHeadingKnown}}
                    <span class="lagunak-workspace__heading-line" aria-hidden="true"></span>
                  {{/if}}
                  <i class="fa-solid fa-shuttle-space" aria-hidden="true"></i>
                </div>
                <div class="lagunak-workspace__route-copy">
                  <small>{{localize "LAGUNAK.Espacios.RutaActual"}}</small>
                  <strong>{{#if ship.destination}}{{ship.destination.name}}{{else}}{{localize "LAGUNAK.Espacios.SinDestino"}}{{/if}}</strong>
                  <span>{{localize "LAGUNAK.Espacios.RutaSoloLectura"}}</span>
                </div>
              </div>
            {{/if}}
          {{/if}}

          {{#if systems.length}}
            <div class="lagunak-workspace__systems">
              <div class="lagunak-workspace__list-heading">
                <span>{{localize "LAGUNAK.Espacios.MatrizSistemas"}}</span>
                <span>{{localize "LAGUNAK.Espacios.SaludCalorPotencia"}}</span>
              </div>
              {{#each systems}}
                <div class="lagunak-workspace__system-row">
                  <strong>{{name}}</strong>
                  <span class="is-health" aria-label="{{localize "LAGUNAK.EstadoNave.Salud"}}: {{health}}%">{{health}}%</span>
                  <span class="is-heat" aria-label="{{localize "LAGUNAK.EstadoNave.Calor"}}: {{heat}}%">{{heat}}%</span>
                  <span class="is-power" aria-label="{{localize "LAGUNAK.EstadoNave.Potencia"}}: {{power}}%">{{power}}%</span>
                  <span class="is-coolant" aria-label="{{localize "LAGUNAK.Espacios.Refrigerante"}}: {{coolant}}%">{{coolant}}%</span>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{#if contacts.length}}
            <div class="lagunak-workspace__contacts">
              <div class="lagunak-workspace__list-heading">
                <span>{{localize "LAGUNAK.Espacios.ContactosProximos"}}</span>
                {{!-- La cabecera dice de dónde sale la lectura: «solo GM» sobre
                      una lectura degradada mentiría sobre su origen (#331). --}}
                {{#if contactsDegradados}}
                  <span>{{localize "LAGUNAK.Espacios.Sensores.Degradado"}}</span>
                {{else}}
                  <span>{{localize "LAGUNAK.Espacios.SoloGM"}}</span>
                {{/if}}
              </div>
              {{#each contacts}}
                <div class="lagunak-workspace__contact-row{{#if eco}} lagunak-workspace__contact-row--eco{{/if}}">
                  {{#if eco}}
                    <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
                  {{else}}
                    <i class="fa-solid fa-diamond" aria-hidden="true"></i>
                  {{/if}}
                  <strong>{{callsign}}</strong>
                  <span>{{faction}}</span>
                  <code>{{lectura}}</code>
                </div>
              {{/each}}
            </div>
          {{/if}}
        {{else}}
          <div class="lagunak-workspace__empty">
            <i class="fa-solid fa-wave-square" aria-hidden="true"></i>
            <strong>{{localize "LAGUNAK.Espacios.SinTelemetria"}}</strong>
            <p>{{localize "LAGUNAK.Espacios.SinTelemetriaDetalle"}}</p>
          </div>
        {{/if}}

        {{! Órdenes operativas por puesto (#236+): fuera del bloque de telemetría
            porque la tripulación no la recibe y aun así debe poder ordenar. }}
        {{#if canOrderHeading}}
          <form class="lagunak-workspace__orden" data-workspace-order="heading">
            <label for="lagunak-orden-rumbo">{{localize "LAGUNAK.Espacios.Orden.RumboLabel"}}</label>
            <input id="lagunak-orden-rumbo" name="heading" type="number" min="0" max="359" step="1" inputmode="numeric" />
            <button type="button" data-workspace-action="orden-rumbo">{{localize "LAGUNAK.Espacios.Orden.FijarRumbo"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.RumboAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderImpulse}}
          <form class="lagunak-workspace__orden" data-workspace-order="impulse">
            <label for="lagunak-orden-impulso">{{localize "LAGUNAK.Espacios.Orden.ImpulsoLabel"}}</label>
            <input id="lagunak-orden-impulso" name="impulse" type="number" min="-1" max="1" step="0.1" inputmode="decimal" />
            <button type="button" data-workspace-action="orden-impulso">{{localize "LAGUNAK.Espacios.Orden.FijarImpulso"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.ImpulsoAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderWarp}}
          <form class="lagunak-workspace__orden" data-workspace-order="warp">
            <label for="lagunak-orden-warp">{{localize "LAGUNAK.Espacios.Orden.WarpLabel"}}</label>
            <input id="lagunak-orden-warp" name="warp" type="number" min="0" max="4" step="1" inputmode="numeric" />
            <button type="button" data-workspace-action="orden-warp">{{localize "LAGUNAK.Espacios.Orden.FijarWarp"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.WarpAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderCombatManeuver}}
          <form class="lagunak-workspace__orden" data-workspace-order="combat-maneuver">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.ManiobraLabel"}}</span>
            <p class="lagunak-workspace__orden-lectura">{{maniobraCargaTexto}}</p>
            <label for="lagunak-orden-maniobra-empuje">{{localize "LAGUNAK.Espacios.Orden.ManiobraEmpujeLabel"}}</label>
            <input id="lagunak-orden-maniobra-empuje" name="maneuver-boost" type="number" min="0" max="1" step="0.1" inputmode="decimal" />
            <button type="button" data-workspace-action="orden-maniobra-empuje">{{localize "LAGUNAK.Espacios.Orden.ManiobraEmpujar"}}</button>
            <label for="lagunak-orden-maniobra-lateral">{{localize "LAGUNAK.Espacios.Orden.ManiobraLateralLabel"}}</label>
            <input id="lagunak-orden-maniobra-lateral" name="maneuver-strafe" type="number" min="-1" max="1" step="0.1" inputmode="decimal" />
            <button type="button" data-workspace-action="orden-maniobra-lateral">{{localize "LAGUNAK.Espacios.Orden.ManiobraDesplazar"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.ManiobraAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderDock}}
          <form class="lagunak-workspace__orden" data-workspace-order="dock">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.AtraqueLabel"}}</span>
            {{#if dockTargets.length}}
              <label for="lagunak-orden-objetivo-atraque">{{localize "LAGUNAK.Espacios.Orden.AtraqueObjetivoLabel"}}</label>
              <select id="lagunak-orden-objetivo-atraque">
                {{#each dockTargets}}<option value="{{value}}">{{label}}</option>{{/each}}
              </select>
              <button type="button" data-workspace-action="orden-atracar">{{localize "LAGUNAK.Espacios.Orden.Atracar"}}</button>
            {{else}}
              <p class="lagunak-workspace__orden-vacia">{{localize "LAGUNAK.Espacios.Armas.SinObjetivos"}}</p>
            {{/if}}
            {{#if canOrderUndock}}
              <button type="button" data-workspace-action="orden-soltar-amarras">{{localize "LAGUNAK.Espacios.Orden.SoltarAmarras"}}</button>
            {{/if}}
            {{#if canOrderAbortDock}}
              <button type="button" data-workspace-action="orden-cancelar-atraque">{{localize "LAGUNAK.Espacios.Orden.CancelarAtraque"}}</button>
            {{/if}}
            <small>{{localize "LAGUNAK.Espacios.Orden.AtraqueAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderPower}}
          <form class="lagunak-workspace__orden" data-workspace-order="power">
            <label for="lagunak-orden-sistema">{{localize "LAGUNAK.Espacios.Orden.SistemaLabel"}}</label>
            <select id="lagunak-orden-sistema" name="system">
              {{#each powerSystems}}<option value="{{value}}">{{label}}</option>{{/each}}
            </select>
            <label for="lagunak-orden-nivel">{{localize "LAGUNAK.Espacios.Orden.NivelLabel"}}</label>
            <select id="lagunak-orden-nivel" name="level">
              {{#each powerLevels}}<option value="{{value}}">{{label}}</option>{{/each}}
            </select>
            <button type="button" data-workspace-action="orden-potencia">{{localize "LAGUNAK.Espacios.Orden.FijarPotencia"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.PotenciaAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderCoolant}}
          <form class="lagunak-workspace__orden" data-workspace-order="coolant">
            <label for="lagunak-orden-sistema-refrig">{{localize "LAGUNAK.Espacios.Orden.SistemaLabel"}}</label>
            <select id="lagunak-orden-sistema-refrig" name="system">
              {{#each coolantSystems}}<option value="{{value}}">{{label}}</option>{{/each}}
            </select>
            <label for="lagunak-orden-nivel-refrig">{{localize "LAGUNAK.Espacios.Orden.RefrigeranteNivelLabel"}}</label>
            <select id="lagunak-orden-nivel-refrig" name="level">
              {{#each coolantLevels}}<option value="{{value}}">{{label}}</option>{{/each}}
            </select>
            <button type="button" data-workspace-action="orden-refrigerante">{{localize "LAGUNAK.Espacios.Orden.FijarRefrigerante"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.RefrigeranteAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderAutoRepair}}
          <form class="lagunak-workspace__orden" data-workspace-order="auto-repair">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.ReparacionAutoLabel"}}</span>
            <button type="button" data-workspace-action="orden-reparacion-auto-activar">{{localize "LAGUNAK.Espacios.Orden.ReparacionAutoActivar"}}</button>
            <button type="button" data-workspace-action="orden-reparacion-auto-desactivar">{{localize "LAGUNAK.Espacios.Orden.ReparacionAutoDesactivar"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.ReparacionAutoAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderShields}}
          <form class="lagunak-workspace__orden" data-workspace-order="shields">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.EscudosLabel"}}</span>
            <button type="button" data-workspace-action="orden-escudos-subir">{{localize "LAGUNAK.Espacios.Orden.SubirEscudos"}}</button>
            <button type="button" data-workspace-action="orden-escudos-bajar">{{localize "LAGUNAK.Espacios.Orden.BajarEscudos"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.EscudosAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderScan}}
          <form class="lagunak-workspace__orden" data-workspace-order="scan">
            <label for="lagunak-orden-objetivo-escaneo">{{localize "LAGUNAK.Espacios.Orden.EscaneoLabel"}}</label>
            {{#if scanTargets.length}}
              <select id="lagunak-orden-objetivo-escaneo">
                {{#each scanTargets}}<option value="{{value}}">{{label}}</option>{{/each}}
              </select>
              <button type="button" data-workspace-action="orden-escanear">{{localize "LAGUNAK.Espacios.Orden.FijarEscaneo"}}</button>
            {{else}}
              <p class="lagunak-workspace__orden-vacia">{{localize "LAGUNAK.Espacios.Sensores.SinObjetivos"}}</p>
            {{/if}}
            <small>{{localize "LAGUNAK.Espacios.Orden.EscaneoAyuda"}}</small>
          </form>
        {{/if}}

        {{#if weaponTargets.length}}
          <form class="lagunak-workspace__orden" data-workspace-order="weapon-target">
            <label for="lagunak-orden-objetivo-armas">{{localize "LAGUNAK.Espacios.Orden.ObjetivoArmasLabel"}}</label>
            <select id="lagunak-orden-objetivo-armas">
              {{#each weaponTargets}}<option value="{{value}}">{{label}}</option>{{/each}}
            </select>
            {{#if canOrderWeaponTarget}}
              <button type="button" data-workspace-action="orden-fijar-objetivo-armas">{{localize "LAGUNAK.Espacios.Orden.FijarObjetivoArmas"}}</button>
              <small>{{localize "LAGUNAK.Espacios.Orden.ObjetivoArmasAyuda"}}</small>
            {{/if}}
            {{#if canOrderFireTube}}
              <label for="lagunak-orden-tubo">{{localize "LAGUNAK.Espacios.Orden.TuboLabel"}}</label>
              <input id="lagunak-orden-tubo" name="tube" type="number" min="0" max="15" step="1" inputmode="numeric" />
              <button type="button" data-workspace-action="orden-disparar-tubo">{{localize "LAGUNAK.Espacios.Orden.DispararTubo"}}</button>
              <small>{{localize "LAGUNAK.Espacios.Orden.DispararTuboAyuda"}}</small>
            {{/if}}
          </form>
        {{else}}
          {{#if canOrderWeaponTarget}}
            <p class="lagunak-workspace__orden-vacia">{{localize "LAGUNAK.Espacios.Armas.SinObjetivos"}}</p>
          {{/if}}
        {{/if}}

        {{#if canOrderShieldFrequency}}
          <form class="lagunak-workspace__orden" data-workspace-order="shield-frequency">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.FrecuenciaLabel"}}</span>
            <p class="lagunak-workspace__orden-lectura" role="status" aria-live="polite">{{frecuenciaEscudosTexto}}</p>
            <label for="lagunak-orden-frecuencia-escudos">{{localize "LAGUNAK.Espacios.Orden.FrecuenciaCampoLabel"}}</label>
            <input id="lagunak-orden-frecuencia-escudos" name="shield-frequency" type="number" min="0" max="20" step="1" inputmode="numeric" />
            <button type="button" data-workspace-action="orden-frecuencia-escudos">{{localize "LAGUNAK.Espacios.Orden.FrecuenciaRecalibrar"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.FrecuenciaAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderSelfDestruct}}
          <form class="lagunak-workspace__orden lagunak-workspace__orden--grave" data-workspace-order="self-destruct">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.AutodestruccionLabel"}}</span>
            <p class="lagunak-workspace__orden-lectura" role="status" aria-live="polite">{{autodestruccionTexto}}</p>
            {{#if autodestruccionArmada}}
              <button type="button" data-workspace-action="orden-autodestruccion-desarmar">{{localize "LAGUNAK.Espacios.Orden.AutodestruccionDesarmar"}}</button>
            {{else}}
              <button type="button" data-workspace-action="orden-autodestruccion-armar">{{localize "LAGUNAK.Espacios.Orden.AutodestruccionArmar"}}</button>
            {{/if}}
            <small>{{localize "LAGUNAK.Espacios.Orden.AutodestruccionAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderDestructCode}}
          <form class="lagunak-workspace__orden lagunak-workspace__orden--grave" data-workspace-order="destruct-code">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.CodigoLabel"}}</span>
            <label for="lagunak-orden-codigo-indice">{{localize "LAGUNAK.Espacios.Orden.CodigoIndiceLabel"}}</label>
            <input id="lagunak-orden-codigo-indice" name="destruct-index" type="number" min="0" max="2" step="1" inputmode="numeric" />
            <label for="lagunak-orden-codigo">{{localize "LAGUNAK.Espacios.Orden.CodigoCampoLabel"}}</label>
            <input id="lagunak-orden-codigo" name="destruct-code" type="number" min="0" step="1" inputmode="numeric" />
            <button type="button" data-workspace-action="orden-autodestruccion-confirmar">{{localize "LAGUNAK.Espacios.Orden.CodigoConfirmar"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.CodigoAyuda"}}</small>
        {{#if canOrderWaypoints}}
          <form class="lagunak-workspace__orden" data-workspace-order="waypoints">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.WaypointLabel"}}</span>
            <label for="lagunak-orden-waypoint-rumbo">{{localize "LAGUNAK.Espacios.Orden.RumboRelativoLabel"}}</label>
            <input id="lagunak-orden-waypoint-rumbo" name="waypoint-bearing" type="number" min="0" max="359" step="1" inputmode="numeric" />
            <label for="lagunak-orden-waypoint-distancia">{{localize "LAGUNAK.Espacios.Orden.DistanciaLabel"}}</label>
            <input id="lagunak-orden-waypoint-distancia" name="waypoint-range" type="number" min="0" step="100" inputmode="numeric" />
            <button type="button" data-workspace-action="orden-waypoint-colocar">{{localize "LAGUNAK.Espacios.Orden.WaypointColocar"}}</button>
            <label for="lagunak-orden-waypoint-indice">{{localize "LAGUNAK.Espacios.Orden.WaypointIndiceLabel"}}</label>
            <input id="lagunak-orden-waypoint-indice" name="waypoint-index" type="number" min="0" max="63" step="1" inputmode="numeric" />
            <button type="button" data-workspace-action="orden-waypoint-mover">{{localize "LAGUNAK.Espacios.Orden.WaypointMover"}}</button>
            <button type="button" data-workspace-action="orden-waypoint-borrar">{{localize "LAGUNAK.Espacios.Orden.WaypointBorrar"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.WaypointAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderProbe}}
          <form class="lagunak-workspace__orden" data-workspace-order="probe">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.SondaLabel"}}</span>
            <p class="lagunak-workspace__orden-lectura">{{sondasTexto}}</p>
            <label for="lagunak-orden-sonda-rumbo">{{localize "LAGUNAK.Espacios.Orden.RumboRelativoLabel"}}</label>
            <input id="lagunak-orden-sonda-rumbo" name="probe-bearing" type="number" min="0" max="359" step="1" inputmode="numeric" />
            <label for="lagunak-orden-sonda-distancia">{{localize "LAGUNAK.Espacios.Orden.DistanciaLabel"}}</label>
            <input id="lagunak-orden-sonda-distancia" name="probe-range" type="number" min="0" step="100" inputmode="numeric" />
            <button type="button" data-workspace-action="orden-sonda-lanzar">{{localize "LAGUNAK.Espacios.Orden.SondaLanzar"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.SondaAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderScienceLink}}
          <form class="lagunak-workspace__orden" data-workspace-order="science-link">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.EnlaceSondaLabel"}}</span>
            {{#if probeTargets.length}}
              <label for="lagunak-orden-objetivo-sonda">{{localize "LAGUNAK.Espacios.Orden.EnlaceSondaObjetivoLabel"}}</label>
              <select id="lagunak-orden-objetivo-sonda">
                {{#each probeTargets}}<option value="{{value}}">{{label}}</option>{{/each}}
              </select>
              <button type="button" data-workspace-action="orden-sonda-enlazar">{{localize "LAGUNAK.Espacios.Orden.EnlaceSondaEnlazar"}}</button>
            {{else}}
              <p class="lagunak-workspace__orden-vacia">{{localize "LAGUNAK.Espacios.Armas.SinObjetivos"}}</p>
            {{/if}}
            <button type="button" data-workspace-action="orden-sonda-desenlazar">{{localize "LAGUNAK.Espacios.Orden.EnlaceSondaDesenlazar"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.EnlaceSondaAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderAlertLevel}}
          <form class="lagunak-workspace__orden" data-workspace-order="alert-level">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.AlertaLabel"}}</span>
            <p class="lagunak-workspace__orden-lectura" role="status" aria-live="polite">{{alertaDeclaradaTexto}}</p>
            <button type="button" data-workspace-action="orden-alerta-normal">{{localize "LAGUNAK.Espacios.Orden.Alerta.normal"}}</button>
            <button type="button" data-workspace-action="orden-alerta-amarilla">{{localize "LAGUNAK.Espacios.Orden.Alerta.yellow"}}</button>
            <button type="button" data-workspace-action="orden-alerta-roja">{{localize "LAGUNAK.Espacios.Orden.Alerta.red"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.AlertaAyuda"}}</small>
          </form>
        {{#if hayEnlaceSonda}}
          <section class="lagunak-workspace__orden" data-workspace-order="probe-view">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Sensores.VistaSondaLabel"}}</span>
            <p class="lagunak-workspace__orden-lectura" role="status" aria-live="polite">{{enlaceSondaTexto}}</p>
            {{#if sensoresSonda.contactos.length}}
              <ul class="lagunak-workspace__lista-sonda">
                {{#each sensoresSonda.contactos}}
                  <li>{{this.etiqueta}}</li>
                {{/each}}
              </ul>
            {{else}}
              <p class="lagunak-workspace__orden-vacia">{{localize "LAGUNAK.Espacios.Sensores.SondaSinContactos"}}</p>
            {{/if}}
            <small>{{localize "LAGUNAK.Espacios.Sensores.VistaSondaAyuda"}}</small>
          </section>
        {{/if}}

        {{#if tieneBaseDatos}}
          <section class="lagunak-workspace__orden" data-workspace-order="database">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Sensores.BaseDatosLabel"}}</span>
            <p class="lagunak-workspace__orden-lectura">{{baseDatosTexto}}</p>
            {{#if baseDatosEntradas.length}}
              <ul class="lagunak-workspace__lista-fichas">
                {{#each baseDatosEntradas}}
                  <li>
                    <strong>{{this.nombre}}</strong>
                    {{#if this.descripcion}}<span>{{this.descripcion}}</span>{{/if}}
                  </li>
                {{/each}}
              </ul>
            {{/if}}
            <small>{{localize "LAGUNAK.Espacios.Sensores.BaseDatosAyuda"}}</small>
          </section>
        {{/if}}

        {{#if canOrderRepairCrew}}
          <form class="lagunak-workspace__orden" data-workspace-order="repair-crew">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Reparacion.Label"}}</span>
            <p class="lagunak-workspace__orden-lectura" role="status" aria-live="polite">{{interiorTexto}}</p>
            {{#if tieneInterior}}
              <label for="lagunak-orden-equipo">{{localize "LAGUNAK.Espacios.Reparacion.EquipoLabel"}}</label>
              <select id="lagunak-orden-equipo">
                {{#each equiposReparacion}}
                  <option value="{{this.valor}}">{{localize "LAGUNAK.Espacios.Reparacion.Equipo"}} {{this.numero}}</option>
                {{/each}}
              </select>
              <label for="lagunak-orden-sala-destino">{{localize "LAGUNAK.Espacios.Reparacion.DestinoLabel"}}</label>
              <select id="lagunak-orden-sala-destino">
                {{#each plantaSalas}}<option value="{{this.valor}}">{{this.etiqueta}}</option>{{/each}}
              </select>
              <button type="button" data-workspace-action="orden-mover-equipo">{{localize "LAGUNAK.Espacios.Reparacion.Mover"}}</button>
            {{/if}}
            <small>{{localize "LAGUNAK.Espacios.Reparacion.Ayuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderCommsHail}}
          <form class="lagunak-workspace__orden" data-workspace-order="comms-hail">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.CommsHailLabel"}}</span>
            <button type="button" data-workspace-action="orden-comms-contestar">{{localize "LAGUNAK.Espacios.Orden.CommsContestar"}}</button>
            <button type="button" data-workspace-action="orden-comms-ignorar">{{localize "LAGUNAK.Espacios.Orden.CommsIgnorar"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.CommsHailAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderCommsClose}}
          <form class="lagunak-workspace__orden" data-workspace-order="comms-cerrar">
            <span class="lagunak-workspace__orden-label">{{localize "LAGUNAK.Espacios.Orden.CommsCerrarLabel"}}</span>
            <button type="button" data-workspace-action="orden-comms-cerrar">{{localize "LAGUNAK.Espacios.Orden.CommsCerrar"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.CommsCerrarAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderCommsReply}}
          <form class="lagunak-workspace__orden" data-workspace-order="comms-opcion">
            <label for="lagunak-orden-comms-opcion">{{localize "LAGUNAK.Espacios.Orden.CommsOpcionLabel"}}</label>
            <input id="lagunak-orden-comms-opcion" name="index" type="number" min="0" max="15" step="1" inputmode="numeric" />
            <button type="button" data-workspace-action="orden-comms-opcion">{{localize "LAGUNAK.Espacios.Orden.CommsFijarOpcion"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.CommsOpcionAyuda"}}</small>
          </form>
        {{/if}}

        {{#if canOrderCommsMessage}}
          <form class="lagunak-workspace__orden" data-workspace-order="comms-mensaje">
            <label for="lagunak-orden-comms-mensaje">{{localize "LAGUNAK.Espacios.Orden.CommsMensajeLabel"}}</label>
            <input id="lagunak-orden-comms-mensaje" name="message" type="text" maxlength="256" />
            <button type="button" data-workspace-action="orden-comms-mensaje">{{localize "LAGUNAK.Espacios.Orden.CommsEnviarMensaje"}}</button>
            <small>{{localize "LAGUNAK.Espacios.Orden.CommsMensajeAyuda"}}</small>
          </form>
        {{/if}}
      </main>

      <aside class="lagunak-workspace__side">
        <section class="lagunak-workspace__briefing">
          <h3>{{localize "LAGUNAK.Espacios.ListaGuardia"}}</h3>
          <ol>
            {{#each tasks}}
              <li><span>{{number}}</span>{{label}}</li>
            {{/each}}
          </ol>
        </section>

        <section class="lagunak-workspace__crew">
          <h3>{{localize "LAGUNAK.Espacios.Tripulacion"}}</h3>
          {{#each crew}}
            <div class="lagunak-workspace__crew-row {{#unless active}}is-offline{{/unless}}">
              <span class="lagunak-workspace__crew-light" aria-hidden="true"></span>
              {{! El retrato es decorativo: alt vacío y aria-hidden, porque
                  puesto y estado ya van en texto justo al lado. El marco de
                  puesto es CSS, no imagen: no es un galón. }}
              <span class="lagunak-workspace__crew-portrait {{#if station}}lagunak-workspace__crew-portrait--{{station}}{{/if}}" aria-hidden="true">
                <img class="lagunak-workspace__crew-portrait-img" src="{{portrait}}" alt="" aria-hidden="true" width="32" height="32"/>
              </span>
              <strong>{{name}}</strong>
              <small>{{stationLabel}}{{#unless active}} · {{statusLabel}}{{/unless}}</small>
            </div>
          {{else}}
            <p>{{localize "LAGUNAK.Puestos.SinJugadores"}}</p>
          {{/each}}
        </section>
      </aside>
    </div>

    <footer class="lagunak-workspace__actions">
      <button type="button" data-workspace-action="assignments">
        <i class="fa-solid fa-users-gear" aria-hidden="true"></i> {{localize "LAGUNAK.Espacios.GestionarPuestos"}}
      </button>
      {{#if isGM}}
        <button type="button" class="is-primary" data-workspace-action="refresh">
          <i class="fa-solid fa-rotate" aria-hidden="true"></i> {{localize "LAGUNAK.Espacios.Actualizar"}}
        </button>
      {{/if}}
    </footer>
  {{else}}
    <div class="lagunak-workspace__unassigned">
      <span class="lagunak-workspace__unassigned-icon" aria-hidden="true"><i class="fa-solid fa-user-astronaut"></i></span>
      <small>{{localize "LAGUNAK.Espacios.SinPuestoCodigo"}}</small>
      <h2>{{localize "LAGUNAK.Espacios.SinPuesto"}}</h2>
      <p>{{localize "LAGUNAK.Espacios.SinPuestoDetalle"}}</p>
      <button type="button" data-workspace-action="assignments">
        <i class="fa-solid fa-users-gear" aria-hidden="true"></i> {{localize "LAGUNAK.Espacios.ElegirPuesto"}}
      </button>
    </div>
  {{/if}}
</section>
