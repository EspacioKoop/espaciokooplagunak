# Copia este archivo a docker/.env y ajusta los valores.
# docker/.env está ignorado por git: los secretos nunca se commitean.

# Token Bearer que el módulo de Foundry usará contra el puente.
# Genera uno con: openssl rand -hex 32
BRIDGE_TOKEN=

# Escenario que arranca el servidor headless.
EE_SCENARIO=scenario_00_basic.lua

# Nombre visible del servidor para los clientes del puente de mando.
EE_SERVER_NAME=Espaciokoop Lagunak

# Contraseña de acceso para los clientes (vacío = sin contraseña).
EE_SERVER_PASSWORD=

# Puertos publicados en el host.
EE_SERVER_PORT=35666
BRIDGE_PORT=8090
