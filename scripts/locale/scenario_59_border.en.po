# Scenario setting
msgctxt "setting"
msgid "Ending"
msgstr "Ending"

msgctxt "setting"
msgid ""
"Sets the conditions for ending the war: absolute strength % when friendly "
"and Kraylor give up, relative strength % difference when friendly and "
"Kraylor give up"
msgstr ""
"Sets the conditions for ending the war: absolute strength % when friendly "
"and Kraylor give up, relative strength % difference when friendly and "
"Kraylor give up"

msgctxt "Ending"
msgid "Easy"
msgstr "Easy"

msgctxt "Ending"
msgid "Cutoffs 10% easier than normal"
msgstr "Cutoffs 10% easier than normal"

msgctxt "Ending"
msgid "Normal"
msgstr "Normal"

msgctxt "Ending"
msgid ""
"Kraylor surrender if < 70% of their original strength, friendly surrender if "
